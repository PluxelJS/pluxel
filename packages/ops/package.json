{
	"name": "@pluxel/ops",
	"version": "0.1.0",
	"description": "Schema-first operation kernel for Pluxel control-plane adapters",
	"files": [
		"dist",
		"!**/*.map"
	],
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": {
				"import": "./dist/index.mjs",
				"require": "./dist/index.cjs"
			},
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"test": "pnpm exec vitest run",
		"build": "tsdown"
	},
	"dependencies": {
		"@sinclair/parsebox": "^0.11.1",
		"@sinclair/typebox": "^0.34.48"
	},
	"devDependencies": {
		"@pluxel/test": "workspace:*"
	}
}
