{
	"name": "@pluxel/agent-sdk",
	"version": "1.1.0",
	"description": "Host operations and standalone source queries for Pluxel agents.",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/pluxel",
		"directory": "packages/agent-sdk"
	},
	"files": [
		"dist",
		"!**/*.map"
	],
	"type": "module",
	"exports": {
		"./host": {
			"@pluxel/source": "./src/host.ts",
			"default": "./dist/host.mjs"
		},
		"./source": {
			"@pluxel/source": "./src/source.ts",
			"default": "./dist/source.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			"./host": "./dist/host.mjs",
			"./source": "./dist/source.mjs",
			"./package.json": "./package.json"
		},
		"access": "public"
	},
	"scripts": {
		"build": "vp run compile",
		"typecheck": "vp run check-types",
		"test": "vp run check-tests"
	},
	"dependencies": {
		"@pluxel/host": "workspace:^",
		"@pluxel/rolldown": "workspace:^"
	},
	"devDependencies": {
		"@pluxel/core": "workspace:*",
		"@types/node": "catalog:types",
		"vite-plus": "catalog:build"
	},
	"engines": {
		"node": ">=24"
	}
}
