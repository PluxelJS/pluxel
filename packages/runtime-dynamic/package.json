{
	"name": "@pluxel/runtime-dynamic",
	"version": "1.0.0",
	"description": "Pluxel mutable file-source runtime route",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/pluxel",
		"directory": "packages/runtime-dynamic"
	},
	"files": [
		"!**/*.map",
		"dist"
	],
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./hmr": {
			"@pluxel/source": "./src/hmr.ts",
			"default": "./dist/hmr.mjs"
		},
		"./hmr/diagnose": {
			"@pluxel/source": "./src/hmr/diagnose.ts",
			"default": "./dist/hmr/diagnose.mjs"
		},
		"./source-producer": {
			"@pluxel/source": "./src/source-producer.ts",
			"default": "./dist/source-producer.mjs"
		},
		"./vite": {
			"@pluxel/source": "./src/vite.ts",
			"default": "./dist/vite.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./hmr": "./dist/hmr.mjs",
			"./hmr/diagnose": "./dist/hmr/diagnose.mjs",
			"./source-producer": "./dist/source-producer.mjs",
			"./vite": "./dist/vite.mjs",
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"test": "pnpm exec vitest run",
		"build": "tsdown",
		"typecheck": "tsc --noEmit --pretty false --composite false --rootDir ../.."
	},
	"dependencies": {
		"@logtape/logtape": "catalog:prod",
		"@pluxel/core": "workspace:^",
		"@pluxel/rolldown": "workspace:^",
		"@pluxel/runtime": "workspace:^",
		"@vitejs/plugin-react": "catalog:build",
		"crossws": "catalog:prod",
		"elysia": "catalog:prod",
		"jsonc-parser": "catalog:prod",
		"pathe": "catalog:node",
		"picomatch": "catalog:prod",
		"srvx": "catalog:prod",
		"valibot": "catalog:validation"
	},
	"devDependencies": {
		"@pluxel/runtime-dev": "workspace:*",
		"@pluxel/runtime-node": "workspace:*",
		"@pluxel/test": "workspace:*",
		"react": "catalog:frontend",
		"react-dom": "catalog:frontend",
		"superjson": "catalog:validation",
		"tsx": "catalog:dev",
		"typescript": "catalog:dev",
		"vite": "catalog:build"
	},
	"peerDependencies": {
		"vite": ">=8.2.2 <9"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		}
	},
	"inlinedDependencies": {
		"chokidar": "5.0.0",
		"readdirp": "5.1.1"
	}
}
