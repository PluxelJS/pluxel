{
	"name": "@pluxel/runtime-dynamic",
	"version": "0.3.0",
	"description": "Pluxel runtime dynamic route (dynamic plugin loading, scanning, and package installs)",
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/pluxel",
		"directory": "packages/runtime-dynamic"
	},
	"files": [
		"!**/*.map",
		"dist"
	],
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./hmr": {
			"@pluxel/source": "./src/hmr.ts",
			"default": "./dist/hmr.mjs"
		},
		"./hmr/diagnose": {
			"@pluxel/source": "./src/hmr/diagnose.ts",
			"default": "./dist/hmr/diagnose.mjs"
		},
		"./plugin": {
			"@pluxel/source": "./src/plugin.ts",
			"default": "./dist/plugin.mjs"
		},
		"./services": {
			"@pluxel/source": "./src/services.ts",
			"default": "./dist/services.mjs"
		},
		"./vite": {
			"@pluxel/source": "./src/vite.ts",
			"default": "./dist/vite.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./hmr": "./dist/hmr.mjs",
			"./hmr/diagnose": "./dist/hmr/diagnose.mjs",
			"./plugin": "./dist/plugin.mjs",
			"./services": "./dist/services.mjs",
			"./vite": "./dist/vite.mjs",
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"test": "pnpm exec vitest run",
		"build": "tsdown"
	},
	"dependencies": {
		"@gqloom/core": "^0.16.1",
		"@logtape/logtape": "^2.0.2",
		"@pluxel/core": "workspace:*",
		"@pluxel/rolldown": "workspace:*",
		"@pluxel/runtime": "workspace:*",
		"capnweb": "^0.5.0",
		"chokidar": "^5.0.0",
		"graphql": "^16.13.0",
		"jsonc-parser": "^3.3.1",
		"nypm": "^0.6.5",
		"option-t": "^55.1.2",
		"pathe": "^2.0.3",
		"picomatch": "^4.0.3",
		"tinypool": "^2.1.0",
		"valibot": "^1.2.0"
	},
	"devDependencies": {
		"@pluxel/runtime-dev": "workspace:*",
		"@pluxel/test": "workspace:*",
		"superjson": "^2.2.6",
		"typescript": "^6.0.3",
		"vite": "^8.0.0-beta.18"
	},
	"peerDependencies": {
		"vite": ">=8.0.0-beta.18 <9"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		}
	}
}
