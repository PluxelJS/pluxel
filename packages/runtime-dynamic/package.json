{
	"name": "@pluxel/runtime-dynamic",
	"version": "1.0.0",
	"description": "Pluxel mutable file-source runtime route",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/pluxel",
		"directory": "packages/runtime-dynamic"
	},
	"files": [
		"!**/*.map",
		"dist"
	],
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./hmr": {
			"@pluxel/source": "./src/hmr.ts",
			"default": "./dist/hmr.mjs"
		},
		"./hmr/diagnose": {
			"@pluxel/source": "./src/hmr/diagnose.ts",
			"default": "./dist/hmr/diagnose.mjs"
		},
		"./source-producer": {
			"@pluxel/source": "./src/source-producer.ts",
			"default": "./dist/source-producer.mjs"
		},
		"./vite": {
			"@pluxel/source": "./src/vite.ts",
			"default": "./dist/vite.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./hmr": "./dist/hmr.mjs",
			"./hmr/diagnose": "./dist/hmr/diagnose.mjs",
			"./source-producer": "./dist/source-producer.mjs",
			"./vite": "./dist/vite.mjs",
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"test": "pnpm exec vitest run",
		"build": "tsdown",
		"typecheck": "tsc --noEmit --pretty false --composite false --rootDir ../.."
	},
	"dependencies": {
		"@logtape/logtape": "^2.0.2",
		"@pluxel/core": "workspace:^",
		"@pluxel/rolldown": "workspace:^",
		"@pluxel/runtime": "workspace:^",
		"@vitejs/plugin-react": "^6.1.1",
		"crossws": "0.4.12",
		"elysia": "2.0.0-beta.7",
		"jsonc-parser": "^3.3.1",
		"pathe": "^2.0.3",
		"picomatch": "^4.0.3",
		"srvx": "0.12.7",
		"valibot": "^1.2.0"
	},
	"devDependencies": {
		"@pluxel/runtime-dev": "workspace:*",
		"@pluxel/runtime-node": "workspace:*",
		"@pluxel/test": "workspace:*",
		"react": "catalog:",
		"react-dom": "catalog:",
		"superjson": "^2.2.6",
		"tsx": "^4.23.0",
		"typescript": "catalog:",
		"vite": "^8.2.2"
	},
	"peerDependencies": {
		"vite": ">=8.2.2 <9"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		}
	},
	"inlinedDependencies": {
		"chokidar": "5.0.0",
		"readdirp": "5.0.0"
	}
}
