{
	"name": "@pluxel/rolldown",
	"version": "0.1.0",
	"description": "Pluxel Rolldown/Vite/tsdown toolchain helpers",
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/pluxel",
		"directory": "packages/rolldown"
	},
	"files": [
		"dist",
		"!**/*.map"
	],
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./build": {
			"@pluxel/source": "./src/cli/index.ts",
			"default": "./dist/build.mjs"
		},
		"./management/artifact": {
			"@pluxel/source": "./src/management/artifact.ts",
			"default": "./dist/management/artifact.mjs"
		},
		"./oxlint": {
			"@pluxel/source": "./src/workspace/oxlint/index.ts",
			"default": "./dist/oxlint.mjs"
		},
		"./plugins": {
			"@pluxel/source": "./src/rolldown/index.ts",
			"default": "./dist/plugins.mjs"
		},
		"./resolver/oxc": {
			"@pluxel/source": "./src/resolver/oxc.ts",
			"default": "./dist/resolver/oxc.mjs"
		},
		"./vite": {
			"@pluxel/source": "./src/vite/index.ts",
			"default": "./dist/vite.mjs"
		},
		"./vite/environment": {
			"@pluxel/source": "./src/vite/environment.ts",
			"default": "./dist/vite/environment.mjs"
		},
		"./vite/management-ui": {
			"@pluxel/source": "./src/vite/management-ui.ts",
			"default": "./dist/vite/management-ui.mjs"
		},
		"./vite/paraglide": {
			"@pluxel/source": "./src/vite/paraglide.ts",
			"default": "./dist/vite/paraglide.mjs"
		},
		"./workspace": {
			"@pluxel/source": "./src/workspace/index.ts",
			"default": "./dist/workspace.mjs"
		},
		"./workspace/fs": {
			"@pluxel/source": "./src/workspace/fs-entry.ts",
			"default": "./dist/workspace/fs.mjs"
		},
		"./workspace/info": {
			"@pluxel/source": "./src/workspace/info-entry.ts",
			"default": "./dist/workspace/info.mjs"
		},
		"./workspace/vite": {
			"@pluxel/source": "./src/workspace/vite.ts",
			"default": "./dist/workspace/vite.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./build": "./dist/build.mjs",
			"./management/artifact": "./dist/management/artifact.mjs",
			"./oxlint": "./dist/oxlint.mjs",
			"./plugins": "./dist/plugins.mjs",
			"./resolver/oxc": "./dist/resolver/oxc.mjs",
			"./vite": "./dist/vite.mjs",
			"./vite/environment": "./dist/vite/environment.mjs",
			"./vite/management-ui": "./dist/vite/management-ui.mjs",
			"./vite/paraglide": "./dist/vite/paraglide.mjs",
			"./workspace": "./dist/workspace.mjs",
			"./workspace/fs": "./dist/workspace/fs.mjs",
			"./workspace/info": "./dist/workspace/info.mjs",
			"./workspace/vite": "./dist/workspace/vite.mjs",
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"test": "pnpm exec vitest run",
		"build": "tsdown"
	},
	"dependencies": {
		"@inlang/paraglide-js": "^2.15.1",
		"@module-federation/vite": "^1.16.16",
		"oxc-parser": "^0.115.0",
		"oxc-resolver": "^11.21.3"
	},
	"devDependencies": {
		"@pluxel/core": "workspace:*",
		"@rolldown/pluginutils": "^1.0.0-rc.5",
		"fdir": "^6.5.0",
		"fs-fixture": "^2.13.0",
		"pathe": "^2.0.3",
		"rolldown": "^1.0.0-rc.5",
		"tsdown": "^0.22.3",
		"typescript": "^6.0.3",
		"vite": "^8.0.0-beta.18"
	},
	"peerDependencies": {
		"rolldown": "^1.0.0-rc.5",
		"tsdown": "*",
		"vite": ">=8.0.0-beta.18 <9"
	},
	"peerDependenciesMeta": {
		"rolldown": {
			"optional": true
		},
		"tsdown": {
			"optional": true
		},
		"vite": {
			"optional": true
		}
	},
	"inlinedDependencies": {
		"@rolldown/pluginutils": "1.0.1",
		"fdir": "6.5.0",
		"pathe": "2.0.3"
	}
}
