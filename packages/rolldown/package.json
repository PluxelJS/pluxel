{
	"private": true,
	"name": "@pluxel/rolldown",
	"version": "0.1.0",
	"description": "Demo example that imports a local package",
	"main": "./dist/index.cjs",
	"type": "module",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"require": "./dist/index.cjs",
			"import": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"test": "bun test",
		"build": "tsdown"
	},
	"dependencies": {
		"vite": "npm:rolldown-vite@7.2.10"
	},
	"devDependencies": {
		"oxc-parser": "^0.99.0",
		"pathe": "^2.0.3",
		"rolldown": "1.0.0-beta.52",
		"unplugin-macros": "^0.18.6"
	},
	"publishConfig": {
		"exports": {
			".": {
				"require": "./dist/index.cjs",
				"import": "./dist/index.mjs"
			},
			"./package.json": "./package.json"
		}
	}
}
