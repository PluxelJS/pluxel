{
	"name": "@pluxel/rolldown",
	"version": "1.0.0",
	"description": "Pluxel Rolldown/Vite/tsdown toolchain helpers",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/pluxel",
		"directory": "packages/rolldown"
	},
	"files": [
		"dist",
		"!**/*.map"
	],
	"type": "module",
	"exports": {
		"./build": {
			"@pluxel/source": "./src/cli/index.ts",
			"default": "./dist/build.mjs"
		},
		"./database": {
			"@pluxel/source": "./src/database/index.ts",
			"default": "./dist/database.mjs"
		},
		"./distribution": {
			"@pluxel/source": "./src/distribution/index.ts",
			"default": "./dist/distribution.mjs"
		},
		"./internal/static-config-environment-vite": {
			"@pluxel/source": "./src/vite/static-config-environment.ts",
			"default": "./dist/internal/static-config-environment-vite.mjs"
		},
		"./oxlint": {
			"@pluxel/source": "./src/workspace/oxlint/index.ts",
			"default": "./dist/oxlint.mjs"
		},
		"./plugins": {
			"@pluxel/source": "./src/rolldown/index.ts",
			"default": "./dist/plugins.mjs"
		},
		"./resolver/oxc": {
			"@pluxel/source": "./src/resolver/oxc.ts",
			"default": "./dist/resolver/oxc.mjs"
		},
		"./vite": {
			"@pluxel/source": "./src/vite/index.ts",
			"default": "./dist/vite.mjs"
		},
		"./vite/declaration": {
			"@pluxel/source": "./src/plugin-artifact/declaration.ts",
			"default": "./dist/vite/declaration.mjs"
		},
		"./vite/environment": {
			"@pluxel/source": "./src/vite/environment.ts",
			"default": "./dist/vite/environment.mjs"
		},
		"./vite/node-module": {
			"@pluxel/source": "./src/plugin-artifact/node-module.ts",
			"default": "./dist/vite/node-module.mjs"
		},
		"./vite/paraglide": {
			"@pluxel/source": "./src/vite/paraglide.ts",
			"default": "./dist/vite/paraglide.mjs"
		},
		"./vite/source-graph": {
			"@pluxel/source": "./src/vite/source-graph.ts",
			"default": "./dist/vite/source-graph.mjs"
		},
		"./vite/workbench-ui": {
			"@pluxel/source": "./src/vite/workbench-ui.ts",
			"default": "./dist/vite/workbench-ui.mjs"
		},
		"./workbench/artifact": {
			"@pluxel/source": "./src/workbench/artifact.ts",
			"default": "./dist/workbench/artifact.mjs"
		},
		"./workspace/fs": {
			"@pluxel/source": "./src/workspace/fs-entry.ts",
			"default": "./dist/workspace/fs.mjs"
		},
		"./workspace/info": {
			"@pluxel/source": "./src/workspace/info-entry.ts",
			"default": "./dist/workspace/info.mjs"
		},
		"./workspace/vite": {
			"@pluxel/source": "./src/workspace/vite.ts",
			"default": "./dist/workspace/vite.mjs"
		},
		"./package.json": "./package.json",
		"./distribution/schema.json": "./schemas/pluxel-distribution-v1.schema.json"
	},
	"publishConfig": {
		"exports": {
			"./build": "./dist/build.mjs",
			"./database": "./dist/database.mjs",
			"./distribution": "./dist/distribution.mjs",
			"./internal/static-config-environment-vite": "./dist/internal/static-config-environment-vite.mjs",
			"./oxlint": "./dist/oxlint.mjs",
			"./plugins": "./dist/plugins.mjs",
			"./resolver/oxc": "./dist/resolver/oxc.mjs",
			"./vite": "./dist/vite.mjs",
			"./vite/declaration": "./dist/vite/declaration.mjs",
			"./vite/environment": "./dist/vite/environment.mjs",
			"./vite/node-module": "./dist/vite/node-module.mjs",
			"./vite/paraglide": "./dist/vite/paraglide.mjs",
			"./vite/source-graph": "./dist/vite/source-graph.mjs",
			"./vite/workbench-ui": "./dist/vite/workbench-ui.mjs",
			"./workbench/artifact": "./dist/workbench/artifact.mjs",
			"./workspace/fs": "./dist/workspace/fs.mjs",
			"./workspace/info": "./dist/workspace/info.mjs",
			"./workspace/vite": "./dist/workspace/vite.mjs",
			"./package.json": "./package.json",
			"./distribution/schema.json": "./dist/schemas/pluxel-distribution-v1.schema.json"
		}
	},
	"scripts": {
		"test": "pnpm exec vitest run",
		"build": "tsdown",
		"typecheck": "tsc --noEmit --pretty false --composite false"
	},
	"dependencies": {
		"@inlang/paraglide-js": "^2.15.1",
		"@module-federation/bridge-react": "2.9.0",
		"@module-federation/sdk": "2.9.0",
		"@module-federation/vite": "1.21.1",
		"@pluxel/core": "workspace:^",
		"drizzle-kit": "^0.31.5",
		"nf3": "^0.3.22",
		"oxc-parser": "^0.115.0",
		"oxc-resolver": "^11.21.3",
		"typescript": "catalog:",
		"unplugin-macros": "^0.20.2",
		"unplugin-preprocessor-directives": "^1.2.0",
		"valibot": "^1.2.0",
		"valibot-form": "workspace:^"
	},
	"devDependencies": {
		"@rolldown/pluginutils": "^1.0.1",
		"@types/node": "^25.9.4",
		"fdir": "^6.5.0",
		"fs-fixture": "^2.13.0",
		"oxlint": "^1.73.0",
		"pathe": "^2.0.3",
		"rolldown": "^1.2.6",
		"tsdown": "catalog:",
		"vite": "^8.2.2"
	},
	"peerDependencies": {
		"rolldown": "^1.2.6",
		"tsdown": "catalog:",
		"vite": ">=8.2.2 <9"
	},
	"peerDependenciesMeta": {
		"rolldown": {
			"optional": true
		},
		"tsdown": {
			"optional": true
		},
		"vite": {
			"optional": true
		}
	},
	"inlinedDependencies": {
		"@rolldown/pluginutils": "1.0.1",
		"fdir": "6.5.0",
		"pathe": "2.0.3"
	}
}
