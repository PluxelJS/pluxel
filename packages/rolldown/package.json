{
	"private": true,
	"name": "@pluxel/rolldown",
	"version": "0.1.0",
	"description": "Demo example that imports a local package",
	"main": "./dist/index.cjs",
	"type": "module",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"test": "bun test",
		"build": "tsdown"
	},
	"dependencies": {
		"vite": "npm:rolldown-vite@7.2.8"
	},
	"devDependencies": {
		"pathe": "^2.0.3",
		"oxc-parser": "^0.99.0",
		"rolldown": "1.0.0-beta.52"
	},
	"publishConfig": {
		"exports": {
			".": {
				"import": "./dist/index.mjs",
				"require": "./dist/index.cjs"
			},
			"./package.json": "./package.json"
		}
	}
}