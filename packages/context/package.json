{
  "private": true,
  "name": "@pluxel/context",
  "version": "0.1.0",
  "description": "Demo example that imports a local package",
  "main": "./src/index.ts",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "@pluxel/source": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf build .turbo",
    "dev": "bun --watch run src/test.ts"
  }
}
