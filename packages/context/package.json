{
	"name": "@pluxel/context",
	"version": "1.1.0",
	"description": "Immutable, lazy Context capability hosts for Pluxel",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/pluxel",
		"directory": "packages/context"
	},
	"files": [
		"dist",
		"README.md",
		"!**/*.map",
		"!**/*.tsbuildinfo"
	],
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./internal": {
			"@pluxel/source": "./src/internal.ts",
			"import": "./dist/internal.mjs",
			"require": "./dist/internal.cjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": {
				"import": "./dist/index.mjs",
				"require": "./dist/index.cjs"
			},
			"./internal": {
				"import": "./dist/internal.mjs",
				"require": "./dist/internal.cjs"
			},
			"./package.json": "./package.json"
		},
		"access": "public"
	},
	"scripts": {
		"test": "vp run check-tests",
		"bench": "node --experimental-transform-types bench/context.bench.ts",
		"bench:compare-legacy": "node --experimental-transform-types bench/legacy-comparison.bench.ts",
		"bench:legacy-snapshot": "vp test bench --testTimeout 600000 legacy/bench/context-getter.bench.ts",
		"build": "vp run compile",
		"typecheck": "vp run check-types"
	},
	"devDependencies": {
		"@types/node": "catalog:types",
		"tinybench": "catalog:dev",
		"vite-plus": "catalog:build"
	},
	"engines": {
		"node": ">=24"
	}
}
