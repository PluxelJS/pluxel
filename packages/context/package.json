{
	"private": true,
	"name": "@pluxel/context",
	"version": "0.1.0",
	"description": "Demo example that imports a local package",
	"main": "./dist/index.cjs",
	"type": "module",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"test": "pnpm exec vitest run -c vitest.config.ts",
		"bench": "pnpm exec vitest bench -c vitest.config.ts bench/context-getter.bench.ts",
		"build": "tsdown"
	},
	"devDependencies": {
		"@pluxel/test": "workspace:*"
	},
	"publishConfig": {
		"exports": {
			".": {
				"import": "./dist/index.mjs",
				"require": "./dist/index.cjs"
			},
			"./package.json": "./package.json"
		}
	}
}
