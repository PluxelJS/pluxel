{
	"name": "@pluxel/test",
	"version": "1.0.0",
	"description": "Core/plugin test utilities for Pluxel packages (fixtures + Vitest preset).",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/pluxel",
		"directory": "packages/test"
	},
	"files": [
		"dist",
		"!**/*.map"
	],
	"type": "module",
	"exports": {
		"./fixtures": {
			"@pluxel/source": "./src/fixtures.ts",
			"import": "./dist/fixtures.mjs",
			"require": "./dist/fixtures.cjs"
		},
		"./unsafe": {
			"@pluxel/source": "./src/unsafe.ts",
			"import": "./dist/unsafe.mjs",
			"require": "./dist/unsafe.cjs"
		},
		"./vitest": {
			"@pluxel/source": "./src/vitest.ts",
			"import": "./dist/vitest.mjs",
			"require": "./dist/vitest.cjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			"./fixtures": {
				"import": "./dist/fixtures.mjs",
				"require": "./dist/fixtures.cjs"
			},
			"./unsafe": {
				"import": "./dist/unsafe.mjs",
				"require": "./dist/unsafe.cjs"
			},
			"./vitest": {
				"import": "./dist/vitest.mjs",
				"require": "./dist/vitest.cjs"
			},
			"./package.json": "./package.json"
		},
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"test": "pnpm exec vitest run --config vitest.config.ts",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@pluxel/rolldown": "workspace:^"
	},
	"devDependencies": {
		"@platformatic/vfs": "catalog:dev",
		"@pluxel/core": "workspace:*",
		"fs-fixture": "catalog:dev",
		"vitest": "catalog:test"
	},
	"peerDependencies": {
		"@pluxel/core": "workspace:^",
		"vitest": "catalog:test"
	},
	"engines": {
		"node": ">=24"
	},
	"inlinedDependencies": {
		"@platformatic/vfs": "0.4.0",
		"fs-fixture": "2.14.0"
	}
}
