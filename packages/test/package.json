{
	"name": "@pluxel/test",
	"version": "0.1.0",
	"description": "Test utilities for Pluxel packages (host/context helpers + Vitest preset).",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./setup": {
			"@pluxel/source": "./src/setup.ts",
			"import": "./dist/setup.mjs",
			"require": "./dist/setup.cjs"
		},
		"./unsafe": {
			"@pluxel/source": "./src/unsafe.ts",
			"import": "./dist/unsafe.mjs",
			"require": "./dist/unsafe.cjs"
		},
		"./vitest": {
			"@pluxel/source": "./src/vitest.ts",
			"import": "./dist/vitest.mjs",
			"require": "./dist/vitest.cjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"!**/*.map"
	],
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"peerDependencies": {
		"@pluxel/core": "workspace:*",
		"@pluxel/runtime": "workspace:*",
		"vitest": "^4.0.18"
	},
	"devDependencies": {
		"@pluxel/build": "workspace:*",
		"vitest": "^4.0.18"
	},
	"publishConfig": {
		"exports": {
			".": {
				"import": "./dist/index.mjs",
				"require": "./dist/index.cjs"
			},
			"./setup": {
				"import": "./dist/setup.mjs",
				"require": "./dist/setup.cjs"
			},
			"./unsafe": {
				"import": "./dist/unsafe.mjs",
				"require": "./dist/unsafe.cjs"
			},
			"./vitest": {
				"import": "./dist/vitest.mjs",
				"require": "./dist/vitest.cjs"
			},
			"./package.json": "./package.json"
		}
	}
}
