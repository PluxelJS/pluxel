{
	"name": "@pluxel/host-dynamic",
	"version": "0.0.0",
	"description": "Production-neutral file sources for Pluxel plugin hosts",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/pluxel",
		"directory": "packages/host-dynamic"
	},
	"files": [
		"!**/*.map",
		"dist"
	],
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./source-producer": {
			"@pluxel/source": "./src/source-producer.ts",
			"default": "./dist/source-producer.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./source-producer": "./dist/source-producer.mjs",
			"./package.json": "./package.json"
		},
		"access": "public"
	},
	"scripts": {
		"test": "pnpm exec vitest run",
		"build": "tsdown",
		"typecheck": "tsc --noEmit --pretty false --composite false --rootDir ../.."
	},
	"dependencies": {
		"@pluxel/core": "workspace:^",
		"@pluxel/host": "workspace:^",
		"chokidar": "catalog:node",
		"picomatch": "catalog:prod"
	},
	"devDependencies": {
		"@types/node": "catalog:types",
		"@types/picomatch": "catalog:types",
		"tsdown": "catalog:build",
		"typescript": "catalog:dev",
		"vitest": "catalog:test"
	},
	"engines": {
		"node": ">=24"
	}
}
