{
	"name": "@pluxel/vite",
	"version": "0.1.0",
	"description": "Pluxel Vite toolchain helpers for development-time plugin UI builds",
	"files": [
		"!**/*.map",
		"dist"
	],
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./paraglide": {
			"@pluxel/source": "./src/paraglide.ts",
			"default": "./dist/paraglide.mjs"
		},
		"./plugin-ui": {
			"@pluxel/source": "./src/plugin-ui.ts",
			"default": "./dist/plugin-ui.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./paraglide": "./dist/paraglide.mjs",
			"./plugin-ui": "./dist/plugin-ui.mjs",
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"test": "pnpm exec vitest run",
		"build": "tsdown"
	},
	"dependencies": {
		"@inlang/paraglide-js": "^2.15.1",
		"@module-federation/vite": "1.16.6",
		"@pluxel/runtime": "workspace:*",
		"pathe": "^2.0.3",
		"vite": "beta"
	},
	"devDependencies": {
		"@pluxel/build": "workspace:*",
		"@pluxel/test": "workspace:*",
		"typescript": "^6.0.3"
	}
}
