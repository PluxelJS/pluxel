{
	"name": "@pluxel/hmr",
	"version": "0.2.2",
	"description": "Demo example that imports a local package",
	"main": "./dist/index.mjs",
	"type": "module",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./config": {
			"@pluxel/source": "./src/config.ts",
			"default": "./dist/config.mjs"
		},
		"./services": {
			"@pluxel/source": "./src/services/index.ts",
			"default": "./dist/services.mjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"!**/*.map",
		"dist",
		"public"
	],
	"scripts": {
		"dev": "bun --conditions=\"@pluxel/source\" tests/start.ts",
		"hot": "bun --hot tests/start.ts",
		"test": "bun test --conditions=@pluxel/source",
		"build": "vite build && tsdown",
		"web": "vite build"
	},
	"dependencies": {
		"@gqloom/core": "^0.12.1",
		"@gqloom/valibot": "^0.12.0",
		"@gqty/cli": "^5.0.0",
		"@hono/react-renderer": "^1.0.1",
		"@hono/valibot-validator": "^0.5.3",
		"@hono/vite-dev-server": "^0.22.0",
		"@poppinss/dumper": "^0.6.5",
		"@rolldown/pluginutils": "^1.0.0-beta.47",
		"@tanstack/pacer": "^0.15.4",
		"@tanstack/react-router": "^1.134.13",
		"chokidar": "^4.0.3",
		"exsolve": "^1.0.7",
		"graphql": "^16.12.0",
		"graphql-yoga": "^5.16.1",
		"hono": "^4.10.4",
		"knitwork": "^1.2.0",
		"nypm": "^0.6.2",
		"pathe": "^2.0.3",
		"pino": "^10.1.0",
		"pino-caller": "^4.0.0",
		"pino-pretty": "^13.1.2",
		"pkg-types": "^2.3.0",
		"postcss": "^8.5.6",
		"postcss-preset-mantine": "^1.18.0",
		"postcss-simple-vars": "^7.0.1",
		"rotating-file-stream": "^3.2.7",
		"superjson": "^2.2.5",
		"tinyglobby": "^0.2.15",
		"valibot": "^1.1.0",
		"vite": "npm:rolldown-vite@7.2.2",
		"vite-node": "^3.2.4",
		"vite-tsconfig-paths": "^5.1.4",
		"youch": "^4.1.0-beta.12"
	},
	"devDependencies": {
		"@pluxel/components": "workspace:*",
		"@pluxel/core": "workspace:*",
		"@types/react": "^19.2.4",
		"@types/react-dom": "^19.2.3",
		"valibot-form": "workspace:*"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./config": "./dist/config.mjs",
			"./services": "./dist/services.mjs",
			"./package.json": "./package.json"
		}
	}
}