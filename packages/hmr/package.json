{
	"name": "@pluxel/hmr",
	"version": "0.2.0",
	"description": "Demo example that imports a local package",
	"main": "./dist/index.js",
	"type": "module",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./config": {
			"@pluxel/source": "./src/config.ts",
			"default": "./dist/config.js"
		},
		"./services": {
			"@pluxel/source": "./src/services/index.ts",
			"default": "./dist/services.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"public"
	],
	"scripts": {
		"dev": "bun --conditions=\"@pluxel/source\" tests/start.ts",
		"hot": "bun --hot tests/start.ts",
		"test": "bun test",
		"build": "tsdown",
		"web": "vite build"
	},
	"dependencies": {
		"@gqloom/core": "catalog:prod",
		"@gqloom/valibot": "catalog:prod",
		"@gqty/cli": "catalog:prod",
		"@gqty/react": "catalog:frontend",
		"@hono/node-server": "catalog:prod",
		"@hono/react-renderer": "catalog:frontend",
		"@hono/valibot-validator": "catalog:prod",
		"@hono/vite-dev-server": "catalog:build",
		"@melloware/react-logviewer": "catalog:frontend",
		"@swc/core": "catalog:prod",
		"@tanstack/pacer": "catalog:prod",
		"@tanstack/react-router": "catalog:frontend",
		"chokidar": "catalog:node",
		"gqty": "catalog:prod",
		"graphql": "catalog:prod",
		"graphql-scalars": "catalog:prod",
		"graphql-yoga": "catalog:prod",
		"hono": "catalog:prod",
		"knitwork": "catalog:prod",
		"mlly": "catalog:prod",
		"pathe": "catalog:node",
		"pino": "catalog:prod",
		"pino-caller": "catalog:prod",
		"pino-pretty": "catalog:prod",
		"pkg-types": "catalog:node",
		"pluxel-plugin-redis": "catalog:prod",
		"postcss": "catalog:style",
		"postcss-preset-mantine": "catalog:style",
		"postcss-simple-vars": "catalog:style",
		"rotating-file-stream": "catalog:prod",
		"superjson": "catalog:prod",
		"unplugin-swc": "catalog:build",
		"valibot": "catalog:prod",
		"vite": "catalog:build",
		"vite-node": "catalog:build",
		"vite-tsconfig-paths": "catalog:build",
		"nypm": "catalog:prod"
	},
	"devDependencies": {
		"@pluxel/components": "workspace:*",
		"@pluxel/core": "workspace:*",
		"@types/react": "catalog:types",
		"@types/react-dom": "catalog:types",
		"valibot-form": "workspace:*"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.js",
			"./config": "./dist/config.js",
			"./services": "./dist/services.js",
			"./package.json": "./package.json"
		}
	}
}
