{
  "private": true,
  "name": "@pluxel/hmr",
  "version": "0.1.0",
  "description": "Demo example that imports a local package",
  "main": "./src/index.ts",
  "type": "module",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "@pluxel/source": "./src/index.ts",
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "require": {
        "@pluxel/source": "./src/index.ts",
        "types": "./dist/index.d.ts",
        "import": "./dist/index.cjs",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf build .turbo",
    "dev": "bun --hot src/index.ts"
  },
  "dependencies": {
    "@hono/react-renderer": "^1.0.1",
    "@hono/vite-dev-server": "^0.19.1",
    "@mantine/core": "^8.1.2",
    "@pluxel/components": "workspace:*",
    "@pluxel/core": "workspace:*",
    "@swc/core": "^1.12.9",
    "@tanstack/pacer": "^0.8.0",
    "@tanstack/react-query": "4",
    "chokidar": "^4.0.3",
    "hono": "^4.8.3",
    "pathe": "^2.0.3",
    "pino": "^9.7.0",
    "pkg-types": "^2.2.0",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "^1.17.0",
    "postcss-simple-vars": "^7.0.1",
    "react": "^19",
    "react-dom": "^19",
    "superjson": "^2.2.2",
    "unplugin-swc": "^1.5.5",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4",
    "wouter": "^3.7.1"
  },
  "peerDependencies": {
    "typescript": "*"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "pino-caller": "^4.0.0",
    "pino-pretty": "^13.0.0"
  }
}
