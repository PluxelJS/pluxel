{
  "private": true,
  "name": "@pluxel/hmr",
  "version": "0.1.0",
  "description": "Demo example that imports a local package",
  "main": "./dist/index.cjs",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "@pluxel/source": "./src/context.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./services": {
      "@pluxel/source": "./src/services/index.ts",
      "import": "./dist/services.js",
      "require": "./dist/services.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf build .turbo",
    "dev": "bun src/index.ts",
    "hot": "bun --hot src/index.ts",
    "build": "tsdown",
    "full-build": "pnpm --filter context build && pnpm --filter core build && pnpm build",
    "web": "vite build"
  },
  "dependencies": {
    "@hono/react-renderer": "^1.0.1",
    "@hono/standard-validator": "^0.1.4",
    "@hono/valibot-validator": "^0.5.3",
    "@hono/vite-dev-server": "^0.20.1",
    "@melloware/react-logviewer": "^6.3.2",
    "@pluxel/components": "workspace:*",
    "@swc/core": "^1.13.3",
    "@tanstack/pacer": "^0.12.0",
    "@tanstack/react-form": "^1.19.2",
    "@tanstack/react-query": "^5.85.3",
    "chokidar": "^4.0.3",
    "hono": "^4.9.2",
    "mlly": "^1.7.4",
    "pathe": "^2.0.3",
    "pino": "^9.9.0",
    "pkg-types": "^2.2.0",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rotating-file-stream": "^3.2.6",
    "superjson": "^2.2.2",
    "unplugin-swc": "^1.5.5",
    "valibot": "^1.1.0",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4",
    "wouter": "^3.7.1"
  },
  "peerDependencies": {
    "@mantine/core": "^8.2.2",
    "@mantine/dates": "^8.2.2",
    "@mantine/hooks": "^8.2.2",
    "@mantine/modals": "^8.2.2",
    "@mantine/notifications": "^8.2.2",
    "@tabler/icons-react": "^3.34.0",
    "typescript": "*"
  },
  "devDependencies": {
    "@pluxel/core": "workspace:*",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "pino-caller": "^4.0.0",
    "pino-pretty": "^13.1.1",
    "tsdown": "^0.11.13",
    "valibot-form": "workspace:*"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./services": {
        "import": "./dist/services.js",
        "require": "./dist/services.cjs"
      },
      "./package.json": "./package.json"
    }
  }
}
