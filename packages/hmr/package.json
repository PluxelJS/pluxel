{
	"name": "@pluxel/hmr",
	"version": "0.3.0",
	"description": "Pluxel development adapter (workspace source execution, watch, HMR)",
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./diagnose": {
			"@pluxel/source": "./src/diagnose.ts",
			"default": "./dist/diagnose.mjs"
		},
		"./host": {
			"@pluxel/source": "./src/host.ts",
			"default": "./dist/host.mjs"
		},
		"./plugin": {
			"@pluxel/source": "./src/plugin.ts",
			"default": "./dist/plugin.mjs"
		},
		"./plugin-build": {
			"@pluxel/source": "./src/plugin-build.ts",
			"default": "./dist/plugin-build.mjs"
		},
		"./snapshot": {
			"@pluxel/source": "./src/snapshot.ts",
			"default": "./dist/snapshot.mjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"!**/*.map"
	],
	"scripts": {
		"dev": "pnpm --filter @pluxel/plugins-host hmr",
		"build": "pnpm run build:lib",
		"build:lib": "tsdown",
		"test": "pnpm exec vitest run"
	},
	"dependencies": {
		"@inlang/paraglide-js": "^2.15.1",
		"@logtape/logtape": "^2.0.2",
		"@module-federation/vite": "1.14.1",
		"@pluxel/core": "workspace:*",
		"@pluxel/runtime": "workspace:*",
		"@rolldown/pluginutils": "1.0.0-rc.5",
		"chokidar": "^5.0.0",
		"jsonc-parser": "^3.3.1",
		"pathe": "^2.0.3",
		"picomatch": "^4.0.3",
		"pkg-types": "^2.3.0",
		"tinypool": "^2.1.0",
		"unplugin-macros": "^0.18.6",
		"vite": "beta"
	},
	"devDependencies": {
		"@pluxel/build": "workspace:*",
		"@pluxel/test": "workspace:*",
		"@pluxel/workspace": "workspace:*",
		"superjson": "^2.2.6",
		"tsdown": "^0.21.7",
		"typescript": "^6.0.2"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./diagnose": "./dist/diagnose.mjs",
			"./host": "./dist/host.mjs",
			"./plugin": "./dist/plugin.mjs",
			"./plugin-build": "./dist/plugin-build.mjs",
			"./snapshot": "./dist/snapshot.mjs",
			"./package.json": "./package.json"
		}
	},
	"inlinedDependencies": {
		"fdir": "6.5.0"
	}
}
