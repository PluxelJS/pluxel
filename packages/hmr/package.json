{
	"private": true,
	"name": "@pluxel/hmr",
	"version": "0.1.0",
	"description": "Demo example that imports a local package",
	"main": "./dist/index.js",
	"type": "module",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./services": {
			"@pluxel/source": "./src/services/index.ts",
			"default": "./dist/services.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"./dist",
		"./public"
	],
	"scripts": {
		"dev": "bun src/start.ts",
		"hot": "bun --hot src/start.ts",
		"build": "tsdown",
		"web": "vite build"
	},
	"dependencies": {
		"@hono/react-renderer": "^1.0.1",
		"@hono/standard-validator": "^0.1.4",
		"@hono/valibot-validator": "^0.5.3",
		"@hono/vite-dev-server": "^0.20.1",
		"@melloware/react-logviewer": "^6.3.2",
		"@swc/core": "^1.13.3",
		"@tanstack/pacer": "^0.12.0",
		"@tanstack/react-form": "^1.19.2",
		"@tanstack/react-query": "^5.85.3",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/modifiers": "^9.0.0",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"chokidar": "^4.0.3",
		"hono": "^4.9.2",
		"mlly": "^1.7.4",
		"pathe": "^2.0.3",
		"pino": "^9.9.0",
		"pino-caller": "^4.0.0",
		"pino-pretty": "^13.1.1",
		"pkg-types": "^2.2.0",
		"postcss": "^8.5.6",
		"postcss-preset-mantine": "^1.18.0",
		"postcss-simple-vars": "^7.0.1",
		"rotating-file-stream": "^3.2.6",
		"superjson": "^2.2.2",
		"unplugin-swc": "^1.5.7",
		"valibot": "^1.1.0",
		"vite": "^7.1.3",
		"vite-node": "^3.2.4",
		"vite-tsconfig-paths": "^5.1.4",
		"wouter": "^3.7.1"
	},
	"peerDependencies": {
		"@mantine/core": "^8.2.2",
		"@mantine/dates": "^8.2.2",
		"@mantine/hooks": "^8.2.2",
		"@mantine/modals": "^8.2.2",
		"@mantine/notifications": "^8.2.2",
		"@tabler/icons-react": "^3.34.1",
		"react": "^19",
		"react-dom": "^19",
		"@pluxel/core": "workspace:*"
	},
	"devDependencies": {
		"@pluxel/core": "workspace:*",
		"@pluxel/components": "workspace:*",
		"@types/react": "^19.1.10",
		"@types/react-dom": "^19.1.7",
		"valibot-form": "workspace:*"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.js",
			"./services": "./dist/services.js",
			"./package.json": "./package.json"
		}
	}
}
