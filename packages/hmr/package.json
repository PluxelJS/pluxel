{
	"name": "@pluxel/hmr",
	"version": "0.3.0",
	"description": "Demo example that imports a local package",
	"main": "./dist/index.mjs",
	"type": "module",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./capnweb": {
			"@pluxel/source": "./src/web/capnweb.ts",
			"default": "./dist/capnweb.mjs"
		},
		"./config": {
			"@pluxel/source": "./src/config.ts",
			"default": "./dist/config.mjs"
		},
		"./services": {
			"@pluxel/source": "./src/services/index.ts",
			"default": "./dist/services.mjs"
		},
		"./signaldb": {
			"@pluxel/source": "./src/web/signaldb.ts",
			"default": "./dist/signaldb.mjs"
		},
		"./web": {
			"@pluxel/source": "./src/web/web.ts",
			"default": "./dist/web.mjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"!**/*.map",
		"dist"
	],
	"scripts": {
		"hmr": "bun --conditions=\"@pluxel/source\" tests/start.ts",
		"mock": "node tests/start.js",
		"hot": "bun --hot tests/start.ts",
		"test": "bun test --conditions=@pluxel/source",
		"build": "vite build && tsdown",
		"web": "vite build"
	},
	"dependencies": {
		"@gqloom/core": "^0.14.5",
		"@gqloom/valibot": "^0.13.0",
		"@gqty/cli": "^5.0.0",
		"@hono/vite-dev-server": "^0.23.0",
		"@poppinss/dumper": "^0.7.0",
		"@rolldown/pluginutils": "1.0.0-beta.56",
		"@signaldb/core": "^1.7.1",
		"@signaldb/fs": "^1.0.1",
		"@tanstack/pacer": "^0.17.0",
		"better-sse": "^0.15.1",
		"capnweb": "^0.3.0",
		"chokidar": "^5.0.0",
		"exsolve": "^1.0.8",
		"graphql": "^16.12.0",
		"graphql-yoga": "^5.18.0",
		"hono": "^4.11.1",
		"knitwork": "^1.3.0",
		"nypm": "^0.6.2",
		"obug": "^2.1.1",
		"pathe": "^2.0.3",
		"pino": "^10.1.0",
		"pino-pretty": "^13.1.3",
		"pkg-types": "^2.3.0",
		"rotating-file-stream": "^3.2.7",
		"superjson": "^2.2.6",
		"tinyglobby": "^0.2.15",
		"tinypool": "^2.0.0",
		"unplugin-macros": "^0.18.6",
		"valibot": "^1.2.0",
		"vite": "8.0.0-beta.0",
		"vite-node": "^5.2.0",
		"youch": "4.1.0-beta.13"
	},
	"peerDependencies": {
		"@tabler/icons-react": "*"
	},
	"devDependencies": {
		"@hono/react-renderer": "^1.0.1",
		"@pluxel/components": "workspace:*",
		"@pluxel/core": "workspace:*",
		"@pluxel/hmr-web": "workspace:*",
		"@pluxel/market": "^0.1.0",
		"@pluxel/plugin-ui": "workspace:*",
		"@pluxel/rolldown": "workspace:*",
		"@tanstack/react-router": "^1.143.4",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"postcss": "^8.5.6",
		"postcss-preset-mantine": "^1.18.0",
		"postcss-simple-vars": "^7.0.1",
		"valibot-form": "workspace:*"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./capnweb": "./dist/capnweb.mjs",
			"./config": "./dist/config.mjs",
			"./services": "./dist/services.mjs",
			"./signaldb": "./dist/signaldb.mjs",
			"./web": "./dist/web.mjs",
			"./package.json": "./package.json"
		}
	}
}
