{
	"name": "@pluxel/hmr",
	"version": "0.3.0",
	"description": "Pluxel HMR host/runtime (includes public Web SDK at @pluxel/hmr/web)",
	"type": "module",
	"bin": {
		"pluxel-hmr": "bin/pluxel-hmr.mjs"
	},
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./capnweb": {
			"@pluxel/source": "./src/web/capnweb.ts",
			"default": "./dist/capnweb.mjs"
		},
		"./cli": {
			"@pluxel/source": "./src/cli.ts",
			"default": "./dist/cli.mjs"
		},
		"./config": {
			"@pluxel/source": "./src/config.ts",
			"default": "./dist/config.mjs"
		},
		"./host": {
			"@pluxel/source": "./src/host/index.ts",
			"default": "./dist/host.mjs"
		},
		"./logger": {
			"@pluxel/source": "./src/logger/index.ts",
			"default": "./dist/logger.mjs"
		},
		"./services": {
			"@pluxel/source": "./src/services/index.ts",
			"default": "./dist/services.mjs"
		},
		"./signaldb": {
			"@pluxel/source": "./src/web/signaldb.ts",
			"default": "./dist/signaldb.mjs"
		},
		"./web": {
			"@pluxel/source": "./src/web/web.ts",
			"default": "./dist/web.mjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"!**/*.map",
		"bin",
		"dist"
	],
	"scripts": {
		"hmr": "pnpm --filter @pluxel/plugins-host hmr",
		"mock": "pnpm --filter @pluxel/plugins-host hmr",
		"hot": "pnpm --filter @pluxel/plugins-host hot",
		"test": "pnpm exec vitest run -c vitest.config.ts",
		"build": "vite build && tsdown",
		"web": "vite build"
	},
	"dependencies": {
		"@gqloom/core": "^0.16.1",
		"@gqloom/valibot": "^0.15.1",
		"@gqty/cli": "^5.0.0",
		"@hono/vite-dev-server": "^0.25.0",
		"@logtape/logtape": "^2.0.2",
		"@pluxel/cli": "workspace:*",
		"@rolldown/pluginutils": "1.0.0-rc.3",
		"@signaldb/core": "^1.7.2",
		"@tanstack/pacer": "^0.18.0",
		"@valibot/to-json-schema": "^1.5.0",
		"better-sse": "^0.16.1",
		"capnweb": "^0.4.0",
		"chokidar": "^5.0.0",
		"exsolve": "^1.0.8",
		"graphql": "^16.12.0",
		"graphql-yoga": "^5.18.0",
		"hono": "^4.11.9",
		"mcp-lite": "^0.10.0",
		"nypm": "^0.6.5",
		"ohash": "^2.0.11",
		"pathe": "^2.0.3",
		"pkg-types": "^2.3.0",
		"superjson": "^2.2.6",
		"tinypool": "^2.1.0",
		"valibot": "^1.2.0",
		"vite": "beta"
	},
	"peerDependencies": {
		"@pluxel/core": "workspace:*",
		"@tabler/icons-react": "*"
	},
	"devDependencies": {
		"@pluxel/build": "workspace:*",
		"@pluxel/components": "workspace:*",
		"@pluxel/hmr-web": "workspace:*",
		"@pluxel/test": "workspace:*",
		"@types/react": "^19.2.13",
		"fs-fixture": "^2.11.0",
		"postcss": "^8.5.6",
		"postcss-preset-mantine": "^1.18.0",
		"postcss-simple-vars": "^7.0.1",
		"valibot-form": "workspace:*"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./capnweb": "./dist/capnweb.mjs",
			"./cli": "./dist/cli.mjs",
			"./config": "./dist/config.mjs",
			"./host": "./dist/host.mjs",
			"./logger": "./dist/logger.mjs",
			"./services": "./dist/services.mjs",
			"./signaldb": "./dist/signaldb.mjs",
			"./web": "./dist/web.mjs",
			"./package.json": "./package.json"
		}
	}
}
