{
	"name": "@pluxel/hmr",
	"version": "0.3.0",
	"description": "Demo example that imports a local package",
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./capnweb": {
			"@pluxel/source": "./src/web/capnweb.ts",
			"default": "./dist/capnweb.mjs"
		},
		"./config": {
			"@pluxel/source": "./src/config.ts",
			"default": "./dist/config.mjs"
		},
		"./logger": {
			"@pluxel/source": "./src/logger/index.ts",
			"default": "./dist/logger.mjs"
		},
		"./services": {
			"@pluxel/source": "./src/services/index.ts",
			"default": "./dist/services.mjs"
		},
		"./signaldb": {
			"@pluxel/source": "./src/web/signaldb.ts",
			"default": "./dist/signaldb.mjs"
		},
		"./web": {
			"@pluxel/source": "./src/web/web.ts",
			"default": "./dist/web.mjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"!**/*.map",
		"dist"
	],
	"scripts": {
		"hmr": "bun --conditions=\"@pluxel/source\" tests/start.ts",
		"mock": "node tests/start.ts",
		"hot": "bun --hot tests/start.ts",
		"test": "bun test --conditions=@pluxel/source",
		"build": "vite build && tsdown",
		"web": "vite build"
	},
	"dependencies": {
		"@gqloom/core": "^0.15.0",
		"@gqloom/valibot": "^0.15.0",
		"@gqty/cli": "^5.0.0",
		"@hono/vite-dev-server": "^0.24.0",
		"@logtape/logtape": "^2.0.1",
		"@rolldown/pluginutils": "1.0.0-beta.58",
		"@signaldb/core": "^1.7.1",
		"@tanstack/pacer": "^0.17.0",
		"better-sse": "^0.16.1",
		"capnweb": "^0.4.0",
		"chokidar": "^5.0.0",
		"exsolve": "^1.0.8",
		"graphql": "^16.12.0",
		"graphql-yoga": "^5.18.0",
		"hono": "^4.11.3",
		"knitwork": "^1.3.0",
		"nypm": "^0.6.2",
		"pathe": "^2.0.3",
		"pkg-types": "^2.3.0",
		"superjson": "^2.2.6",
		"tinyglobby": "^0.2.15",
		"tinypool": "^2.1.0",
		"valibot": "^1.2.0",
		"vite": "beta"
	},
	"peerDependencies": {
		"@tabler/icons-react": "*",
		"@pluxel/core": "workspace:*"
	},
	"devDependencies": {
		"@pluxel/components": "workspace:*",
		"@pluxel/hmr-web": "workspace:*",
		"@pluxel/market": "^0.1.0",
		"@pluxel/rolldown": "workspace:*",
		"@types/react": "^19.2.7",
		"fs-fixture": "^2.11.0",
		"postcss": "^8.5.6",
		"postcss-preset-mantine": "^1.18.0",
		"postcss-simple-vars": "^7.0.1",
		"valibot-form": "workspace:*"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./capnweb": "./dist/capnweb.mjs",
			"./config": "./dist/config.mjs",
			"./logger": "./dist/logger.mjs",
			"./services": "./dist/services.mjs",
			"./signaldb": "./dist/signaldb.mjs",
			"./web": "./dist/web.mjs",
			"./package.json": "./package.json"
		}
	}
}
