{
	"name": "@pluxel/hmr",
	"version": "0.1.6",
	"description": "Demo example that imports a local package",
	"main": "./dist/index.js",
	"type": "module",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./services": {
			"@pluxel/source": "./src/services/index.ts",
			"default": "./dist/services.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"public"
	],
	"scripts": {
		"dev": "bun --conditions=\"@pluxel/source\" src/start.ts",
		"hot": "bun --hot src/start.ts",
		"build": "tsdown",
		"web": "vite build"
	},
	"dependencies": {
		"@gqloom/core": "^0.12.1",
		"@gqloom/valibot": "^0.12.0",
		"@gqty/cli": "^4.3.0",
		"@gqty/react": "^3.1.1",
		"@hono/node-server": "^1.19.5",
		"@hono/react-renderer": "^1.0.1",
		"@hono/valibot-validator": "^0.5.3",
		"@hono/vite-dev-server": "^0.22.0",
		"@melloware/react-logviewer": "^6.3.4",
		"@swc/core": "^1.13.21",
		"@tanstack/pacer": "^0.15.4",
		"chokidar": "^4.0.3",
		"gqty": "^3.5.0",
		"graphql": "^16.11.0",
		"graphql-scalars": "^1.25.0",
		"graphql-yoga": "^5.16.0",
		"hono": "^4.10.2",
		"knitwork": "^1.2.0",
		"mlly": "^1.8.0",
		"pathe": "^2.0.3",
		"pino": "^10.1.0",
		"pino-caller": "^4.0.0",
		"pino-pretty": "^13.1.2",
		"pkg-types": "^2.3.0",
		"postcss": "^8.5.6",
		"postcss-preset-mantine": "^1.18.0",
		"postcss-simple-vars": "^7.0.1",
		"rotating-file-stream": "^3.2.7",
		"superjson": "^2.2.3",
		"unplugin-swc": "^1.5.8",
		"valibot": "^1.1.0",
		"vite": "^7.1.12",
		"vite-node": "^3.2.4",
		"vite-tsconfig-paths": "^5.1.4",
		"wouter": "^3.7.1"
	},
	"peerDependencies": {
		"@mantine/core": "^8.2.2",
		"@mantine/notifications": "^8.2.2",
		"@pluxel/core": "workspace:*",
		"react": "^19",
		"react-dom": "^19"
	},
	"devDependencies": {
		"@pluxel/components": "workspace:*",
		"@pluxel/core": "workspace:*",
		"@types/react": "^19.2.2",
		"@types/react-dom": "^19.2.2",
		"valibot-form": "workspace:*"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.js",
			"./services": "./dist/services.js",
			"./package.json": "./package.json"
		}
	}
}