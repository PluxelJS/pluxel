{
  "private": true,
  "name": "@pluxel/hmr",
  "version": "0.1.0",
  "description": "Demo example that imports a local package",
  "main": "./src/index.ts",
  "type": "module",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "@pluxel/source": "./src/index.ts",
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "require": {
        "@pluxel/source": "./src/index.ts",
        "types": "./dist/index.d.ts",
        "import": "./dist/index.cjs",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf build .turbo",
    "dev": "bun run src/index.ts"
  },
  "dependencies": {
    "@hono/vite-dev-server": "^0.19.1",
    "@pluxel/core": "workspace:*",
    "@swc/core": "^1.12.3",
    "@tanstack/pacer": "^0.8.0",
    "chokidar": "^4.0.3",
    "hono": "^4.8.0",
    "pkg-types": "^2.1.0",
    "superjson": "^2.2.2",
    "unplugin-swc": "^1.5.5",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "peerDependencies": {
    "typescript": "*"
  }
}
