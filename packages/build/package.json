{
	"name": "@pluxel/build",
	"version": "0.1.0",
	"private": true,
	"description": "Pluxel build helpers (tsdown runner + rolldown plugins)",
	"files": [
		"dist",
		"!**/*.map"
	],
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./cli": {
			"@pluxel/source": "./src/cli/index.ts",
			"import": "./dist/cli.mjs",
			"require": "./dist/cli.cjs"
		},
		"./rolldown": {
			"@pluxel/source": "./src/rolldown/index.ts",
			"import": "./dist/rolldown.mjs",
			"require": "./dist/rolldown.cjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": {
				"import": "./dist/index.mjs",
				"require": "./dist/index.cjs"
			},
			"./cli": {
				"import": "./dist/cli.mjs",
				"require": "./dist/cli.cjs"
			},
			"./rolldown": {
				"import": "./dist/rolldown.mjs",
				"require": "./dist/rolldown.cjs"
			},
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"build": "tsdown",
		"test": "pnpm exec vitest run"
	},
	"devDependencies": {
		"fs-fixture": "^2.13.0",
		"oxc-parser": "^0.115.0",
		"pathe": "^2.0.3",
		"pkg-types": "^2.3.0",
		"rolldown": "1.0.0-rc.5",
		"tsdown": "^0.21.10",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"pathe": "^2.0.3",
		"pkg-types": "^2.3.0",
		"tsdown": "^0.21.10"
	}
}
