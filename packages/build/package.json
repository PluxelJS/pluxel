{
	"private": true,
	"name": "@pluxel/build",
	"version": "0.1.0",
	"description": "Pluxel build helpers (tsdown runner + rolldown plugins)",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"type": "module",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./cli": {
			"@pluxel/source": "./src/cli/index.ts",
			"import": "./dist/cli.mjs",
			"require": "./dist/cli.cjs"
		},
		"./rolldown": {
			"@pluxel/source": "./src/rolldown/index.ts",
			"import": "./dist/rolldown.mjs",
			"require": "./dist/rolldown.cjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"!**/*.map"
	],
	"scripts": {
		"build": "tsdown",
		"test": "pnpm exec vitest run"
	},
	"peerDependencies": {
		"pathe": "^2.0.3",
		"pkg-types": "^2.3.0",
		"tsdown": "^0.20.1"
	},
	"devDependencies": {
		"fs-fixture": "^2.11.0",
		"oxc-parser": "^0.112.0",
		"pathe": "^2.0.3",
		"pkg-types": "^2.3.0",
		"rolldown": "1.0.0-rc.3",
		"tsdown": "^0.20.3",
		"typescript": "^5.9.3"
	},
	"publishConfig": {
		"exports": {
			".": {
				"import": "./dist/index.mjs",
				"require": "./dist/index.cjs"
			},
			"./cli": {
				"import": "./dist/cli.mjs",
				"require": "./dist/cli.cjs"
			},
			"./rolldown": {
				"import": "./dist/rolldown.mjs",
				"require": "./dist/rolldown.cjs"
			},
			"./package.json": "./package.json"
		}
	}
}
