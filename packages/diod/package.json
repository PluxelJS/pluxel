{
	"private": true,
	"name": "diod",
	"version": "3.0.0",
	"description": "A very opinionated and different inversion of control container and dependency injector for Typescript, Node.js or browser apps",
	"keywords": [
		"dependency injection",
		"inversion of control",
		"service locator",
		"dependency",
		"injection",
		"service",
		"container",
		"typescript"
	],
	"type": "module",
	"files": [
		"lib",
		"CHANGELOG.md"
	],
	"browserslist": [
		"> 1%, not dead, not ie 11, not op_mini all"
	],
	"scripts": {
		"build": "tsdown",
		"test": "pnpm exec vitest run",
		"docs": "rimraf docs/api && typedoc --plugin typedoc-plugin-markdown",
		"lint": "biome check",
		"qa": "pnpm run lint && pnpm run type-check && pnpm run test",
		"prepack": "pnpm run qa && pnpm run build",
		"size": "size-limit"
	},
	"size-limit": [
		{
			"limit": "2 kB",
			"path": "lib/diod.es.js"
		}
	],
	"devDependencies": {
		"@pluxel/test": "workspace:*",
		"option-t": "^55.1.1",
		"reflect-metadata": "^0.2.2",
		"tsdown": "^0.20.3",
		"typescript": "^5.9.3"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": {
				"import": "./dist/index.mjs",
				"require": "./dist/index.cjs"
			},
			"./package.json": "./package.json"
		}
	}
}
