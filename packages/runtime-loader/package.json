{
	"name": "@pluxel/runtime-loader",
	"version": "0.3.0",
	"description": "Pluxel runtime loader route (dynamic plugin loading, scanning, and package installs)",
	"files": [
		"!**/*.map",
		"dist"
	],
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./dev": {
			"@pluxel/source": "./src/dev.ts",
			"default": "./dist/dev.mjs"
		},
		"./plugin": {
			"@pluxel/source": "./src/plugin.ts",
			"default": "./dist/plugin.mjs"
		},
		"./register": {
			"@pluxel/source": "./src/register.ts",
			"default": "./dist/register.mjs"
		},
		"./services": {
			"@pluxel/source": "./src/services.ts",
			"default": "./dist/services.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./dev": "./dist/dev.mjs",
			"./plugin": "./dist/plugin.mjs",
			"./register": "./dist/register.mjs",
			"./services": "./dist/services.mjs",
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"build": "tsdown"
	},
	"dependencies": {
		"@gqloom/core": "^0.16.1",
		"@inlang/paraglide-js": "^2.15.1",
		"@logtape/logtape": "^2.0.2",
		"@module-federation/vite": "1.16.6",
		"@pluxel/core": "workspace:*",
		"@pluxel/runtime": "workspace:*",
		"@rolldown/pluginutils": "1.0.0-rc.5",
		"capnweb": "^0.5.0",
		"chokidar": "^5.0.0",
		"exsolve": "^1.0.8",
		"graphql": "^16.13.0",
		"jsonc-parser": "^3.3.1",
		"mcp-lite": "^0.10.0",
		"nypm": "^0.6.5",
		"ohash": "^2.0.11",
		"pathe": "^2.0.3",
		"picomatch": "^4.0.3",
		"pkg-types": "^2.3.0",
		"tinypool": "^2.1.0",
		"unplugin-macros": "^0.18.6",
		"valibot": "^1.2.0",
		"vite": "beta"
	},
	"devDependencies": {
		"@pluxel/build": "workspace:*",
		"@pluxel/workspace": "workspace:*",
		"@types/bun": "^1.3.4",
		"superjson": "^2.2.6",
		"typescript": "^6.0.3"
	},
	"inlinedDependencies": {
		"fdir": "6.5.0"
	}
}
