{
	"name": "@pluxel/host-vite",
	"version": "1.1.0",
	"description": "Pluxel Vite application execution and updates",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/pluxel",
		"directory": "packages/host-vite"
	},
	"files": [
		"!**/*.map",
		"dist"
	],
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./internal": {
			"@pluxel/source": "./src/internal.ts",
			"default": "./dist/internal.mjs"
		},
		"./project": {
			"@pluxel/source": "./src/project.ts",
			"default": "./dist/project.mjs"
		},
		"./run": {
			"@pluxel/source": "./src/run.ts",
			"default": "./dist/run.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./internal": "./dist/internal.mjs",
			"./project": "./dist/project.mjs",
			"./run": "./dist/run.mjs",
			"./package.json": "./package.json"
		},
		"access": "public"
	},
	"scripts": {
		"test": "vp run check-tests",
		"build": "vp run compile",
		"typecheck": "vp run check-types"
	},
	"dependencies": {
		"@pluxel/rolldown": "workspace:^",
		"chokidar": "catalog:node",
		"pathe": "catalog:node",
		"vite": "catalog:build"
	},
	"devDependencies": {
		"@logtape/logtape": "catalog:dev",
		"@pluxel/core": "workspace:*",
		"@pluxel/host": "workspace:*",
		"@pluxel/test": "workspace:*",
		"capnweb": "catalog:prod",
		"react": "catalog:frontend",
		"react-dom": "catalog:frontend",
		"typescript": "catalog:dev",
		"vite-plus": "catalog:build"
	},
	"peerDependencies": {
		"@pluxel/core": "workspace:^",
		"@pluxel/host": "workspace:^",
		"capnweb": "catalog:prod"
	}
}
