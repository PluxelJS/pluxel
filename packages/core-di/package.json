{
	"name": "@pluxel/core-di",
	"version": "0.1.0",
	"private": true,
	"description": "Internal prototype for a core-oriented incremental DI kernel",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": {
				"import": "./dist/index.mjs",
				"require": "./dist/index.cjs"
			},
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"build": "tsdown",
		"test": "pnpm exec vitest run",
		"bench": "bun --conditions=@pluxel/source run bench/compare-diod.bench.ts"
	},
	"devDependencies": {
		"diod": "workspace:*",
		"tinybench": "^6.0.0"
	}
}
