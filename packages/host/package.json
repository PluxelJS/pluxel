{
	"name": "@pluxel/host",
	"version": "0.1.0",
	"description": "Composable Plugin host, catalog and lifecycle control",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/pluxel",
		"directory": "packages/host"
	},
	"files": [
		"dist",
		"!**/*.map"
	],
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./application": {
			"@pluxel/source": "./src/application.ts",
			"default": "./dist/application.mjs"
		},
		"./config-environment": {
			"@pluxel/source": "./src/config-environment.ts",
			"default": "./dist/config-environment.mjs"
		},
		"./environment": {
			"@pluxel/source": "./src/environment.ts",
			"default": "./dist/environment.mjs"
		},
		"./internal": {
			"@pluxel/source": "./src/internal.ts",
			"default": "./dist/internal.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./application": "./dist/application.mjs",
			"./config-environment": "./dist/config-environment.mjs",
			"./environment": "./dist/environment.mjs",
			"./internal": "./dist/internal.mjs",
			"./package.json": "./package.json"
		},
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit --pretty false",
		"test": "pnpm exec vitest run",
		"bench:state": "pnpm exec vitest bench bench/state.bench.ts"
	},
	"dependencies": {
		"@pluxel/core": "workspace:^",
		"@standard-schema/spec": "catalog:prod",
		"ohash": "catalog:prod",
		"std-env": "catalog:prod",
		"superjson": "catalog:validation",
		"valibot-form": "workspace:^"
	},
	"devDependencies": {
		"@pluxel/test": "workspace:*",
		"@types/node": "catalog:types",
		"valibot": "catalog:validation"
	},
	"engines": {
		"node": ">=24"
	}
}
