{
	"name": "@pluxel/host",
	"version": "1.1.0",
	"description": "Composable Plugin host, catalog and lifecycle control",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/pluxel",
		"directory": "packages/host"
	},
	"files": [
		"dist",
		"!**/*.map"
	],
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./agent": {
			"@pluxel/source": "./src/agent.ts",
			"default": "./dist/agent.mjs"
		},
		"./agent/node": {
			"@pluxel/source": "./src/agent/node.ts",
			"default": "./dist/agent/node.mjs"
		},
		"./agent/socket": {
			"@pluxel/source": "./src/agent/socket.ts",
			"default": "./dist/agent/socket.mjs"
		},
		"./agent/transport": {
			"@pluxel/source": "./src/agent/transport.ts",
			"default": "./dist/agent/transport.mjs"
		},
		"./bindings": {
			"@pluxel/source": "./src/bindings.ts",
			"default": "./dist/bindings.mjs"
		},
		"./browser": {
			"@pluxel/source": "./src/browser.ts",
			"default": "./dist/browser.mjs"
		},
		"./environment": {
			"@pluxel/source": "./src/environment.ts",
			"default": "./dist/environment.mjs"
		},
		"./internal": {
			"@pluxel/source": "./src/internal.ts",
			"default": "./dist/internal.mjs"
		},
		"./internal/control-manifest": {
			"@pluxel/source": "./src/control-manifest.ts",
			"default": "./dist/internal/control-manifest.mjs"
		},
		"./internal/protocol": {
			"@pluxel/source": "./src/execution.ts",
			"default": "./dist/internal/protocol.mjs"
		},
		"./internal/shared-runtime": {
			"@pluxel/source": "./src/shared-runtime.ts",
			"default": "./dist/internal/shared-runtime.mjs"
		},
		"./sources": {
			"@pluxel/source": "./src/sources.ts",
			"default": "./dist/sources.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./agent": "./dist/agent.mjs",
			"./agent/node": "./dist/agent/node.mjs",
			"./agent/socket": "./dist/agent/socket.mjs",
			"./agent/transport": "./dist/agent/transport.mjs",
			"./bindings": "./dist/bindings.mjs",
			"./browser": "./dist/browser.mjs",
			"./environment": "./dist/environment.mjs",
			"./internal": "./dist/internal.mjs",
			"./internal/control-manifest": "./dist/internal/control-manifest.mjs",
			"./internal/protocol": "./dist/internal/protocol.mjs",
			"./internal/shared-runtime": "./dist/internal/shared-runtime.mjs",
			"./sources": "./dist/sources.mjs",
			"./package.json": "./package.json"
		},
		"access": "public"
	},
	"scripts": {
		"build": "vp run compile",
		"typecheck": "vp run check-types",
		"test": "vp run check-tests",
		"bench:state": "vp test bench bench/state.bench.ts"
	},
	"dependencies": {
		"@standard-schema/spec": "catalog:prod",
		"ohash": "catalog:prod",
		"picomatch": "catalog:prod",
		"semver": "catalog:prod",
		"std-env": "catalog:prod",
		"superjson": "catalog:validation",
		"valibot-form": "workspace:^",
		"yaml": "catalog:prod"
	},
	"devDependencies": {
		"@pluxel/core": "workspace:*",
		"@pluxel/rolldown": "workspace:*",
		"@pluxel/test": "workspace:*",
		"@types/node": "catalog:types",
		"@types/picomatch": "catalog:types",
		"@types/semver": "catalog:types",
		"capnweb": "catalog:prod",
		"miniflare": "catalog:dev",
		"playwright-core": "catalog:prod",
		"valibot": "catalog:validation",
		"vite-plus": "catalog:build"
	},
	"peerDependencies": {
		"@pluxel/core": "workspace:^",
		"capnweb": "catalog:prod"
	},
	"engines": {
		"node": ">=24"
	}
}
