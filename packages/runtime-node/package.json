{
	"name": "@pluxel/runtime-node",
	"version": "0.1.0",
	"private": true,
	"description": "Pluxel Node platform carriers",
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"build": "tsdown",
		"test": "pnpm exec vitest run",
		"typecheck": "tsc --noEmit --pretty false --composite false"
	},
	"dependencies": {
		"@pluxel/runtime": "workspace:*",
		"crossws": "0.4.12",
		"elysia": "2.0.0-beta.7",
		"srvx": "0.12.7"
	},
	"devDependencies": {
		"typescript": "catalog:"
	}
}
