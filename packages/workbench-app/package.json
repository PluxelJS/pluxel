{
	"name": "@pluxel/workbench-app",
	"version": "0.1.0",
	"private": true,
	"description": "Private Pluxel Workbench host application",
	"type": "module",
	"main": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"test": "pnpm exec vitest run",
