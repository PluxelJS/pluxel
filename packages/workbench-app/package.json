		"@material/material-color-utilities": "catalog:prod",
		"@module-federation/runtime": "catalog:prod",
		"@pluxel/core": "workspace:*",
		"@pluxel/runtime": "workspace:*",
		"@tanstack/react-hotkeys": "catalog:frontend",
		"@tanstack/react-router": "catalog:frontend",
		"@tanstack/react-store": "catalog:frontend",
		"@tanstack/react-virtual": "catalog:frontend",
		"@worksplit/react": "workspace:*",
		"valibot-form": "workspace:*"
	},
	"devDependencies": {
		"@mantine/core": "catalog:frontend",
		"@mantine/dates": "catalog:frontend",
