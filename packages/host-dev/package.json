{
	"name": "@pluxel/host-dev",
	"version": "0.1.0",
	"description": "Shared Pluxel host development driver",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/pluxel",
		"directory": "packages/host-dev"
	},
	"files": [
		"!**/*.map",
		"dist"
	],
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./console": {
			"@pluxel/source": "./src/console.ts",
			"default": "./dist/console.mjs"
		},
		"./hmr-log": {
			"@pluxel/source": "./src/hmr-log.ts",
			"default": "./dist/hmr-log.mjs"
		},
		"./internal/console/attachment": {
			"@pluxel/source": "./src/console/attachment.ts",
			"default": "./dist/internal/console/attachment.mjs"
		},
		"./internal/console/executor": {
			"@pluxel/source": "./src/console/executor.ts",
			"default": "./dist/internal/console/executor.mjs"
		},
		"./internal/console/protocol": {
			"@pluxel/source": "./src/console/protocol.ts",
			"default": "./dist/internal/console/protocol.mjs"
		},
		"./internal/console/server": {
			"@pluxel/source": "./src/console/server.ts",
			"default": "./dist/internal/console/server.mjs"
		},
		"./internal/dev/console": {
			"@pluxel/source": "./src/dev/console.ts",
			"default": "./dist/internal/dev/console.mjs"
		},
		"./internal/update-error": {
			"@pluxel/source": "./src/internal/update-error.ts",
			"default": "./dist/internal/update-error.mjs"
		},
		"./internal/vite-urls": {
			"@pluxel/source": "./src/internal/vite-urls.ts",
			"default": "./dist/internal/vite-urls.mjs"
		},
		"./vite": {
			"@pluxel/source": "./src/vite.ts",
			"default": "./dist/vite.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./console": "./dist/console.mjs",
			"./hmr-log": "./dist/hmr-log.mjs",
			"./internal/console/attachment": "./dist/internal/console/attachment.mjs",
			"./internal/console/executor": "./dist/internal/console/executor.mjs",
			"./internal/console/protocol": "./dist/internal/console/protocol.mjs",
			"./internal/console/server": "./dist/internal/console/server.mjs",
			"./internal/dev/console": "./dist/internal/dev/console.mjs",
			"./internal/update-error": "./dist/internal/update-error.mjs",
			"./internal/vite-urls": "./dist/internal/vite-urls.mjs",
			"./vite": "./dist/vite.mjs",
			"./package.json": "./package.json"
		},
		"access": "public"
	},
	"scripts": {
		"test": "pnpm exec vitest run",
		"build": "tsdown",
		"typecheck": "tsc --noEmit --pretty false --composite false --rootDir ../.."
	},
	"dependencies": {
		"@pluxel/core": "workspace:^",
		"@pluxel/host": "workspace:^",
		"@pluxel/rolldown": "workspace:^",
		"chokidar": "catalog:node",
		"pathe": "catalog:node"
	},
	"devDependencies": {
		"@logtape/logtape": "catalog:dev",
		"@pluxel/test": "workspace:*",
		"react": "catalog:frontend",
		"react-dom": "catalog:frontend",
		"typescript": "catalog:dev",
		"vite": "catalog:build"
	},
	"peerDependencies": {
		"vite": ">=8.2.2 <9"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		}
	}
}
