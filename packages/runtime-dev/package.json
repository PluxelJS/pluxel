{
	"name": "@pluxel/runtime-dev",
	"version": "0.1.0",
	"private": true,
	"description": "Pluxel route-neutral runtime development capabilities",
	"files": [
		"!**/*.map",
		"dist"
	],
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./hmr-log": {
			"@pluxel/source": "./src/hmr-log.ts",
			"default": "./dist/hmr-log.mjs"
		},
		"./vite": {
			"@pluxel/source": "./src/vite.ts",
			"default": "./dist/vite.mjs"
		},
		"./workbench": {
			"@pluxel/source": "./src/workbench.ts",
			"default": "./dist/workbench.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./hmr-log": "./dist/hmr-log.mjs",
			"./vite": "./dist/vite.mjs",
			"./workbench": "./dist/workbench.mjs",
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"test": "pnpm exec vitest run",
		"build": "tsdown",
		"typecheck": "tsc --noEmit --pretty false --composite false --rootDir ../.."
	},
	"dependencies": {
		"@pluxel/core": "workspace:*",
		"@pluxel/rolldown": "workspace:*",
		"@pluxel/runtime": "workspace:*",
		"@pluxel/runtime-node": "workspace:*",
		"chokidar": "catalog:node",
		"pathe": "catalog:node",
		"srvx": "catalog:prod"
	},
	"devDependencies": {
		"@logtape/logtape": "catalog:dev",
		"@pluxel/test": "workspace:*",
		"react": "catalog:frontend",
		"react-dom": "catalog:frontend",
		"typescript": "catalog:dev",
		"vite": "catalog:build"
	},
	"peerDependencies": {
		"vite": ">=8.2.2 <9"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		}
	}
}
