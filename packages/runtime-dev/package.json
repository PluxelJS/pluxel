{
	"name": "@pluxel/runtime-dev",
	"version": "0.1.0",
	"private": true,
	"description": "Pluxel route-neutral runtime development capabilities",
	"files": [
		"!**/*.map",
		"dist"
	],
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./hmr-log": {
			"@pluxel/source": "./src/hmr-log.ts",
			"default": "./dist/hmr-log.mjs"
		},
		"./vite": {
			"@pluxel/source": "./src/vite.ts",
			"default": "./dist/vite.mjs"
		},
		"./workbench": {
			"@pluxel/source": "./src/workbench.ts",
			"default": "./dist/workbench.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./hmr-log": "./dist/hmr-log.mjs",
			"./vite": "./dist/vite.mjs",
			"./workbench": "./dist/workbench.mjs",
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"test": "pnpm exec vitest run",
		"build": "tsdown",
		"typecheck": "tsc --noEmit --pretty false --composite false"
	},
	"dependencies": {
		"@pluxel/core": "workspace:*",
		"@pluxel/rolldown": "workspace:*",
		"@pluxel/runtime": "workspace:*",
		"@pluxel/runtime-node": "workspace:*",
		"chokidar": "^5.0.0",
		"pathe": "^2.0.3",
		"srvx": "0.12.7"
	},
	"devDependencies": {
		"@logtape/logtape": "^2.0.2",
		"@pluxel/test": "workspace:*",
		"react": "catalog:",
		"react-dom": "catalog:",
		"typescript": "catalog:",
		"vite": "^8.0.0-beta.18"
	},
	"peerDependencies": {
		"vite": ">=8.0.0-beta.18 <9"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		}
	}
}
