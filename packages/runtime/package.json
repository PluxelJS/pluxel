{
	"name": "@pluxel/runtime",
	"version": "1.0.0",
	"description": "Pluxel runtime kernel, control plane, and web SDK",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/pluxel",
		"directory": "packages/runtime"
	},
	"files": [
		"!**/*.map",
		"dist"
	],
	"type": "module",
	"types": "./dist/index.d.mts",
	"imports": {
		"#pluxel/database-driver/pglite": {
			"@pluxel/source": "./src/services/database-adapters/pglite.ts",
			"default": "./dist/internal/database/pglite.mjs"
		},
		"#pluxel/database-driver/postgres": {
			"@pluxel/source": "./src/services/database-adapters/postgres.ts",
			"default": "./dist/internal/database/postgres.mjs"
		}
	},
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./capnweb": {
			"@pluxel/source": "./src/capnweb.ts",
			"default": "./dist/capnweb.mjs"
		},
		"./database": {
			"@pluxel/source": "./src/database.ts",
			"default": "./dist/database.mjs"
		},
		"./environment": {
			"@pluxel/source": "./src/environment.ts",
			"default": "./dist/environment.mjs"
		},
		"./internal": {
			"@pluxel/source": "./src/internal.ts",
			"default": "./dist/internal.mjs"
		},
		"./internal/config-validation": {
			"@pluxel/source": "./src/internal-config-validation.ts",
			"default": "./dist/internal/config-validation.mjs"
		},
		"./internal/database/pglite": {
			"@pluxel/source": "./src/services/database-adapters/pglite.ts",
			"default": "./dist/internal/database/pglite.mjs"
		},
		"./internal/database/postgres": {
			"@pluxel/source": "./src/services/database-adapters/postgres.ts",
			"default": "./dist/internal/database/postgres.mjs"
		},
		"./internal/static": {
			"@pluxel/source": "./src/internal-static.ts",
			"default": "./dist/internal/static.mjs"
		},
		"./internal/static-host": {
			"@pluxel/source": "./src/internal-static-host.ts",
			"default": "./dist/internal/static-host.mjs"
		},
		"./internal/workbench-react": {
			"@pluxel/source": "./src/workbench/react-internal.tsx",
			"default": "./dist/internal/workbench-react.mjs"
		},
		"./logger": {
			"@pluxel/source": "./src/logger.ts",
			"default": "./dist/logger.mjs"
		},
		"./product": {
			"@pluxel/source": "./src/product.ts",
			"default": "./dist/product.mjs"
		},
		"./services/vault": {
			"@pluxel/source": "./src/services/vault.ts",
			"default": "./dist/services/vault.mjs"
		},
		"./test": {
			"@pluxel/source": "./src/test.ts",
			"default": "./dist/test.mjs"
		},
		"./toolchain": {
			"@pluxel/source": "./src/toolchain.ts",
			"default": "./dist/toolchain.mjs"
		},
		"./web": {
			"@pluxel/source": "./src/web.ts",
			"default": "./dist/web.mjs"
		},
		"./web/react": {
			"@pluxel/source": "./src/web-react.ts",
			"default": "./dist/web/react.mjs"
		},
		"./web/session": {
			"@pluxel/source": "./src/web/session/index.ts",
			"default": "./dist/web/session.mjs"
		},
		"./workbench": {
			"@pluxel/source": "./src/workbench.ts",
			"default": "./dist/workbench.mjs"
		},
		"./workbench/client": {
			"@pluxel/source": "./src/workbench/client.ts",
			"default": "./dist/workbench/client.mjs"
		},
		"./workbench/federation": {
			"@pluxel/source": "./src/workbench/federation.ts",
			"default": "./dist/workbench/federation.mjs"
		},
		"./workbench/react": {
			"@pluxel/source": "./src/workbench/react.tsx",
			"default": "./dist/workbench/react.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"imports": {
			"#pluxel/database-driver/pglite": "./dist/internal/database/pglite.mjs",
			"#pluxel/database-driver/postgres": "./dist/internal/database/postgres.mjs"
		},
		"exports": {
			".": "./dist/index.mjs",
			"./capnweb": "./dist/capnweb.mjs",
			"./database": "./dist/database.mjs",
			"./environment": "./dist/environment.mjs",
			"./internal": "./dist/internal.mjs",
			"./internal/config-validation": "./dist/internal/config-validation.mjs",
			"./internal/database/pglite": "./dist/internal/database/pglite.mjs",
			"./internal/database/postgres": "./dist/internal/database/postgres.mjs",
			"./internal/static": "./dist/internal/static.mjs",
			"./internal/static-host": "./dist/internal/static-host.mjs",
			"./internal/workbench-react": "./dist/internal/workbench-react.mjs",
			"./logger": "./dist/logger.mjs",
			"./product": "./dist/product.mjs",
			"./services/vault": "./dist/services/vault.mjs",
			"./test": "./dist/test.mjs",
			"./toolchain": "./dist/toolchain.mjs",
			"./web": "./dist/web.mjs",
			"./web/react": "./dist/web/react.mjs",
			"./web/session": "./dist/web/session.mjs",
			"./workbench": "./dist/workbench.mjs",
			"./workbench/client": "./dist/workbench/client.mjs",
			"./workbench/federation": "./dist/workbench/federation.mjs",
			"./workbench/react": "./dist/workbench/react.mjs",
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"test": "pnpm exec vitest run",
		"bench:logger": "pnpm exec vitest bench bench/logger.bench.ts",
		"bench:runtime-state": "pnpm exec vitest bench bench/runtime-state.bench.ts",
		"bench:workers": "pnpm exec vitest bench bench/worker-task.bench.ts",
		"build": "pnpm run build:web && pnpm run build:lib",
		"build:lib": "tsdown",
		"build:web": "vite build",
		"typecheck": "tsc --noEmit --pretty false --composite false"
	},
	"dependencies": {
		"@electric-sql/pglite": "catalog:prod",
		"@logtape/file": "catalog:prod",
		"@logtape/logtape": "catalog:prod",
		"@logtape/pretty": "catalog:prod",
		"@module-federation/bridge-react": "catalog:frontend",
		"@module-federation/runtime": "catalog:prod",
		"@module-federation/sdk": "catalog:prod",
		"@pluxel/commands": "workspace:^",
		"@pluxel/core": "workspace:^",
		"@sinclair/typebox": "catalog:prod",
		"age-encryption": "catalog:prod",
		"capnweb": "catalog:prod",
		"drizzle-orm": "catalog:backend",
		"elysia": "catalog:prod",
		"jose": "catalog:prod",
		"ohash": "catalog:prod",
		"oxc-resolver": "catalog:prod",
		"pathe": "catalog:node",
		"pg": "catalog:backend",
		"std-env": "catalog:prod",
		"superjson": "catalog:validation",
		"valibot": "catalog:validation"
	},
	"devDependencies": {
		"@mantine/core": "catalog:frontend",
		"@mantine/hooks": "catalog:frontend",
		"@mantine/notifications": "catalog:frontend",
		"@pluxel/rolldown": "workspace:*",
		"@pluxel/test": "workspace:*",
		"@tabler/icons-react": "catalog:icons",
		"@types/pg": "catalog:types",
		"@types/react": "catalog:types",
		"@types/react-dom": "catalog:types",
		"fs-fixture": "catalog:dev",
		"postcss": "catalog:dev",
		"postcss-preset-mantine": "catalog:dev",
		"postcss-simple-vars": "catalog:dev",
		"react": "catalog:frontend",
		"react-dom": "catalog:frontend",
		"valibot-form": "workspace:*",
		"vite": "catalog:build"
	},
	"peerDependencies": {
		"@mantine/core": "catalog:frontend",
		"@mantine/hooks": "catalog:frontend",
		"react": "catalog:frontend",
		"react-dom": "catalog:frontend"
	},
	"peerDependenciesMeta": {
		"@mantine/core": {
			"optional": true
		},
		"@mantine/hooks": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		}
	}
}
