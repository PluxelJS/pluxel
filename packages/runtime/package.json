{
	"name": "@pluxel/runtime",
	"version": "0.3.0",
	"description": "Pluxel runtime kernel (includes control plane, web SDK, and frozen export)",
	"files": [
		"!**/*.map",
		"dist"
	],
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./api": {
			"@pluxel/source": "./src/api/contributions.ts",
			"default": "./dist/api.mjs"
		},
		"./capnweb": {
			"@pluxel/source": "./src/capnweb.ts",
			"default": "./dist/capnweb.mjs"
		},
		"./config": {
			"@pluxel/source": "./src/config.ts",
			"default": "./dist/config.mjs"
		},
		"./events": {
			"@pluxel/source": "./src/events.ts",
			"default": "./dist/events.mjs"
		},
		"./frozen": {
			"@pluxel/source": "./src/frozen.ts",
			"default": "./dist/frozen.mjs"
		},
		"./internal": {
			"@pluxel/source": "./src/internal.ts",
			"default": "./dist/internal.mjs"
		},
		"./logger": {
			"@pluxel/source": "./src/logger.ts",
			"default": "./dist/logger.mjs"
		},
		"./plugin": {
			"@pluxel/source": "./src/plugin.ts",
			"default": "./dist/plugin.mjs"
		},
		"./plugin-catalog": {
			"@pluxel/source": "./src/plugin-catalog.ts",
			"default": "./dist/plugin-catalog.mjs"
		},
		"./protocol": {
			"@pluxel/source": "./src/protocol.ts",
			"default": "./dist/protocol.mjs"
		},
		"./services": {
			"@pluxel/source": "./src/services.ts",
			"default": "./dist/services.mjs"
		},
		"./shared": {
			"@pluxel/source": "./src/shared.ts",
			"default": "./dist/shared.mjs"
		},
		"./test": {
			"@pluxel/source": "./src/test.ts",
			"default": "./dist/test.mjs"
		},
		"./web": {
			"@pluxel/source": "./src/web.ts",
			"default": "./dist/web.mjs"
		},
		"./web/extensions": {
			"@pluxel/source": "./src/web/extensions.ts",
			"default": "./dist/web/extensions.mjs"
		},
		"./web/federation": {
			"@pluxel/source": "./src/web/federation.ts",
			"default": "./dist/web/federation.mjs"
		},
		"./web/paths": {
			"@pluxel/source": "./src/web/paths.ts",
			"default": "./dist/web/paths.mjs"
		},
		"./web/ui": {
			"@pluxel/source": "./src/web/ui.ts",
			"default": "./dist/web/ui.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./api": "./dist/api.mjs",
			"./capnweb": "./dist/capnweb.mjs",
			"./config": "./dist/config.mjs",
			"./events": "./dist/events.mjs",
			"./frozen": "./dist/frozen.mjs",
			"./internal": "./dist/internal.mjs",
			"./logger": "./dist/logger.mjs",
			"./plugin": "./dist/plugin.mjs",
			"./plugin-catalog": "./dist/plugin-catalog.mjs",
			"./protocol": "./dist/protocol.mjs",
			"./services": "./dist/services.mjs",
			"./shared": "./dist/shared.mjs",
			"./test": "./dist/test.mjs",
			"./web": "./dist/web.mjs",
			"./web/extensions": "./dist/web/extensions.mjs",
			"./web/federation": "./dist/web/federation.mjs",
			"./web/paths": "./dist/web/paths.mjs",
			"./web/ui": "./dist/web/ui.mjs",
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"test": "pnpm exec vitest run",
		"bench:logger": "pnpm exec vitest bench bench/logger.bench.ts",
		"build": "pnpm run build:web && pnpm run build:lib",
		"build:lib": "tsdown",
		"build:web": "vite build"
	},
	"dependencies": {
		"@elysiajs/eden": "^1.4.8",
		"@gqloom/core": "^0.16.1",
		"@gqloom/valibot": "^0.15.1",
		"@logtape/file": "^2.0.2",
		"@logtape/logtape": "^2.0.2",
		"@maverick-js/signals": "^6.0.0",
		"@pluxel/core": "workspace:*",
		"@signaldb/core": "^1.7.2",
		"@signaldb/maverickjs": "^1.0.0",
		"@signaldb/react": "^1.0.1",
		"@signaldb/sync": "^1.3.1",
		"age-encryption": "^0.3.0",
		"better-sse": "^0.16.1",
		"capnweb": "^0.5.0",
		"chokidar": "^5.0.0",
		"elysia": "^1.4.27",
		"graphql": "^16.13.0",
		"graphql-yoga": "^5.18.0",
		"jose": "^6.2.3",
		"ohash": "^2.0.11",
		"oxc-resolver": "^11.21.3",
		"pathe": "^2.0.3",
		"std-env": "^4.0.0-rc.1",
		"superjson": "^2.2.6",
		"valibot": "^1.2.0"
	},
	"devDependencies": {
		"@gqlens/codegen": "^0.2.0",
		"@pluxel/rolldown": "workspace:*",
		"@pluxel/test": "workspace:*",
		"@types/react": "^19.2.14",
		"postcss": "^8.5.6",
		"postcss-preset-mantine": "^1.18.0",
		"postcss-simple-vars": "^7.0.1",
		"valibot-form": "workspace:*",
		"vite": "^8.0.0-beta.18"
	},
	"peerDependencies": {
		"@tabler/icons-react": "*"
	}
}
