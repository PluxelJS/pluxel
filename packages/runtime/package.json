{
	"name": "@pluxel/runtime",
	"version": "0.3.0",
	"description": "Pluxel runtime kernel (includes control plane, web SDK, and frozen export)",
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/pluxel",
		"directory": "packages/runtime"
	},
	"files": [
		"!**/*.map",
		"dist"
	],
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./capnweb": {
			"@pluxel/source": "./src/capnweb.ts",
			"default": "./dist/capnweb.mjs"
		},
		"./database": {
			"@pluxel/source": "./src/database.ts",
			"default": "./dist/database.mjs"
		},
		"./events": {
			"@pluxel/source": "./src/events.ts",
			"default": "./dist/events.mjs"
		},
		"./internal": {
			"@pluxel/source": "./src/internal.ts",
			"default": "./dist/internal.mjs"
		},
		"./internal/static": {
			"@pluxel/source": "./src/internal-static.ts",
			"default": "./dist/internal/static.mjs"
		},
		"./internal/static-host": {
			"@pluxel/source": "./src/internal-static-host.ts",
			"default": "./dist/internal/static-host.mjs"
		},
		"./logger": {
			"@pluxel/source": "./src/logger.ts",
			"default": "./dist/logger.mjs"
		},
		"./product": {
			"@pluxel/source": "./src/product.ts",
			"default": "./dist/product.mjs"
		},
		"./services/vault": {
			"@pluxel/source": "./src/services/vault.ts",
			"default": "./dist/services/vault.mjs"
		},
		"./test": {
			"@pluxel/source": "./src/test.ts",
			"default": "./dist/test.mjs"
		},
		"./toolchain": {
			"@pluxel/source": "./src/toolchain.ts",
			"default": "./dist/toolchain.mjs"
		},
		"./web": {
			"@pluxel/source": "./src/web.ts",
			"default": "./dist/web.mjs"
		},
		"./web/paths": {
			"@pluxel/source": "./src/web/paths.ts",
			"default": "./dist/web/paths.mjs"
		},
		"./workbench": {
			"@pluxel/source": "./src/workbench.ts",
			"default": "./dist/workbench.mjs"
		},
		"./workbench/contract": {
			"@pluxel/source": "./src/workbench-contract.ts",
			"default": "./dist/workbench/contract.mjs"
		},
		"./workbench/ui": {
			"@pluxel/source": "./src/workbench-ui.ts",
			"default": "./dist/workbench/ui.mjs"
		},
		"./workbench/ui/internal": {
			"@pluxel/source": "./src/workbench-ui-internal.ts",
			"default": "./dist/workbench/ui/internal.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./capnweb": "./dist/capnweb.mjs",
			"./database": "./dist/database.mjs",
			"./events": "./dist/events.mjs",
			"./internal": "./dist/internal.mjs",
			"./internal/static": "./dist/internal/static.mjs",
			"./internal/static-host": "./dist/internal/static-host.mjs",
			"./logger": "./dist/logger.mjs",
			"./product": "./dist/product.mjs",
			"./services/vault": "./dist/services/vault.mjs",
			"./test": "./dist/test.mjs",
			"./toolchain": "./dist/toolchain.mjs",
			"./web": "./dist/web.mjs",
			"./web/paths": "./dist/web/paths.mjs",
			"./workbench": "./dist/workbench.mjs",
			"./workbench/contract": "./dist/workbench/contract.mjs",
			"./workbench/ui": "./dist/workbench/ui.mjs",
			"./workbench/ui/internal": "./dist/workbench/ui/internal.mjs",
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"test": "pnpm exec vitest run",
		"bench:logger": "pnpm exec vitest bench bench/logger.bench.ts",
		"build": "pnpm run build:web && pnpm run build:lib",
		"build:lib": "tsdown",
		"build:web": "vite build"
	},
	"dependencies": {
		"@electric-sql/pglite": "^0.5.4",
		"@elysiajs/eden": "^1.4.8",
		"@gqloom/core": "^0.16.1",
		"@gqloom/valibot": "^0.15.1",
		"@logtape/file": "^2.0.2",
		"@logtape/logtape": "^2.0.2",
		"@logtape/pretty": "^2.0.2",
		"@pluxel/commands": "workspace:*",
		"@pluxel/core": "workspace:*",
		"@sinclair/typebox": "^0.34.48",
		"age-encryption": "^0.3.0",
		"better-sse": "^0.16.1",
		"capnweb": "^0.5.0",
		"drizzle-orm": "catalog:",
		"elysia": "^1.4.27",
		"graphql": "^16.13.0",
		"graphql-yoga": "^5.18.0",
		"jose": "^6.2.3",
		"ohash": "^2.0.11",
		"oxc-resolver": "^11.21.3",
		"pathe": "^2.0.3",
		"pg": "^8.22.0",
		"std-env": "^4.0.0-rc.1",
		"superjson": "^2.2.6",
		"valibot": "^1.2.0"
	},
	"devDependencies": {
		"@gqlens/vite": "workspace:*",
		"@mantine/core": "catalog:",
		"@mantine/notifications": "catalog:",
		"@pluxel/rolldown": "workspace:*",
		"@pluxel/test": "workspace:*",
		"@tabler/icons-react": "catalog:",
		"@types/pg": "^8.20.0",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"fs-fixture": "^2.13.0",
		"postcss": "^8.5.6",
		"postcss-preset-mantine": "^1.18.0",
		"postcss-simple-vars": "^7.0.1",
		"react": "catalog:",
		"react-dom": "catalog:",
		"valibot-form": "workspace:*",
		"vite": "^8.0.0-beta.18"
	},
	"peerDependencies": {
		"@tabler/icons-react": "catalog:"
	},
	"pluxel": {
		"workbenchContractProtocol": 2
	}
}
