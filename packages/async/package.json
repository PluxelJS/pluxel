{
	"name": "@pluxel/async",
	"version": "1.1.0",
	"description": "Small async primitives for dependency graphs, bounded iteration, concurrency, retries and shared work",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/pluxel",
		"directory": "packages/async"
	},
	"files": [
		"dist",
		"README.md",
		"docs",
		"examples",
		"!**/*.map",
		"!**/*.tsbuildinfo"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		"./grfn": {
			"@pluxel/source": "./src/grfn/index.ts",
			"default": "./dist/grfn.js"
		},
		"./iter": {
			"@pluxel/source": "./src/iter/index.ts",
			"default": "./dist/iter.js"
		},
		"./limit": {
			"@pluxel/source": "./src/limit/index.ts",
			"default": "./dist/limit.js"
		},
		"./retry": {
			"@pluxel/source": "./src/retry/index.ts",
			"default": "./dist/retry.js"
		},
		"./singleflight": {
			"@pluxel/source": "./src/singleflight/index.ts",
			"default": "./dist/singleflight.js"
		},
		"./wait": {
			"@pluxel/source": "./src/wait/index.ts",
			"default": "./dist/wait.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			"./grfn": "./dist/grfn.js",
			"./iter": "./dist/iter.js",
			"./limit": "./dist/limit.js",
			"./retry": "./dist/retry.js",
			"./singleflight": "./dist/singleflight.js",
			"./wait": "./dist/wait.js",
			"./package.json": "./package.json"
		},
		"access": "public"
	},
	"scripts": {
		"build": "vp run compile",
		"typecheck": "vp run check-types",
		"test": "vp run check-tests",
		"test:watch": "vp test",
		"test:installed": "node tests/installed-package.smoke.mjs",
		"bench": "vp run build && vp test bench --config vitest.bench.config.ts --run",
		"prepack": "vp run build",
		"examples": "vp run build && node examples/run.ts",
		"examples:pacer": "vp run build && node examples/pacer-run.ts"
	},
	"devDependencies": {
		"@tanstack/pacer": "catalog:workflow",
		"@types/node": "catalog:types",
		"grfn": "catalog:test",
		"lfi": "catalog:test",
		"p-limit": "catalog:test",
		"p-map": "catalog:test",
		"p-memoize": "catalog:test",
		"p-retry": "catalog:test",
		"typescript": "catalog:dev",
		"vite-plus": "catalog:build",
		"vitest": "catalog:test"
	},
	"engines": {
		"node": ">=24"
	}
}
