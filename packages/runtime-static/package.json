{
	"name": "@pluxel/runtime-static",
	"version": "1.0.0",
	"description": "Pluxel runtime static route (fixed plugin catalog, startup reports, and drift checks)",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/pluxel",
		"directory": "packages/runtime-static"
	},
	"files": [
		"!**/*.map",
		"dist"
	],
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./internal/fetch-application": {
			"@pluxel/source": "./src/internal/fetch-application.ts",
			"default": "./dist/internal/fetch-application.mjs"
		},
		"./internal/fetch-workbench-application": {
			"@pluxel/source": "./src/internal/fetch-workbench-application.ts",
			"default": "./dist/internal/fetch-workbench-application.mjs"
		},
		"./internal/node-application": {
			"@pluxel/source": "./src/internal/node-application.ts",
			"default": "./dist/internal/node-application.mjs"
		},
		"./internal/node-workbench-application": {
			"@pluxel/source": "./src/internal/node-workbench-application.ts",
			"default": "./dist/internal/node-workbench-application.mjs"
		},
		"./internal/test": {
			"@pluxel/source": "./src/internal-test.ts",
			"default": "./dist/internal/test.mjs"
		},
		"./test": {
			"@pluxel/source": "./src/test.ts",
			"default": "./dist/test.mjs"
		},
		"./vite": {
			"@pluxel/source": "./src/vite.ts",
			"default": "./dist/vite.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./internal/fetch-application": "./dist/internal/fetch-application.mjs",
			"./internal/fetch-workbench-application": "./dist/internal/fetch-workbench-application.mjs",
			"./internal/node-application": "./dist/internal/node-application.mjs",
			"./internal/node-workbench-application": "./dist/internal/node-workbench-application.mjs",
			"./internal/test": "./dist/internal/test.mjs",
			"./test": "./dist/test.mjs",
			"./vite": "./dist/vite.mjs",
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"test": "pnpm exec vitest run",
		"build": "tsdown",
		"typecheck": "tsc --noEmit --pretty false --composite false --rootDir ../.."
	},
	"dependencies": {
		"@pluxel/core": "workspace:^",
		"@pluxel/runtime": "workspace:^",
		"@standard-schema/spec": "catalog:prod",
		"crossws": "catalog:prod",
		"elysia": "catalog:prod",
		"pathe": "catalog:node",
		"srvx": "catalog:prod",
		"valibot-form": "workspace:^"
	},
	"devDependencies": {
		"@pluxel/rolldown": "workspace:*",
		"@pluxel/runtime-dev": "workspace:*",
		"@pluxel/runtime-node": "workspace:*",
		"@pluxel/test": "workspace:*",
		"tsx": "catalog:dev",
		"vite": "catalog:build"
	},
	"peerDependencies": {
		"@pluxel/rolldown": "workspace:^",
		"vite": ">=8.2.2 <9"
	},
	"peerDependenciesMeta": {
		"@pluxel/rolldown": {
			"optional": true
		},
		"vite": {
			"optional": true
		}
	},
	"inlinedDependencies": {
		"chokidar": "5.0.0",
		"readdirp": "5.1.1"
	}
}
