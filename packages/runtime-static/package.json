{
	"name": "@pluxel/runtime-static",
	"version": "0.1.0",
	"description": "Pluxel runtime static route (fixed plugin catalog, startup reports, and drift checks)",
	"files": [
		"!**/*.map",
		"dist"
	],
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./vite": {
			"@pluxel/source": "./src/vite.ts",
			"default": "./dist/vite.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./vite": "./dist/vite.mjs",
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"test": "pnpm exec vitest run",
		"build": "tsdown"
	},
	"dependencies": {
		"@module-federation/vite": "1.16.12",
		"@pluxel/core": "workspace:*",
		"@pluxel/runtime": "workspace:*",
		"oxc-parser": "^0.115.0",
		"oxc-resolver": "^11.21.3",
		"pathe": "^2.0.3",
		"typescript": "^6.0.3"
	},
	"devDependencies": {
		"@pluxel/runtime-dev": "workspace:*",
		"@pluxel/test": "workspace:*",
		"vite": "^8.0.0-beta.18"
	},
	"peerDependencies": {
		"vite": ">=8.0.0-beta.18 <9"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		}
	},
	"inlinedDependencies": {
		"@inlang/paraglide-js": "2.20.2",
		"@inlang/sdk": "2.10.2",
		"@jridgewell/gen-mapping": "0.3.13",
		"@jridgewell/remapping": "2.3.5",
		"@jridgewell/resolve-uri": "3.1.2",
		"@jridgewell/sourcemap-codec": "1.5.5",
		"@jridgewell/trace-mapping": "0.3.31",
		"@lix-js/sdk": "0.4.10",
		"@sqlite.org/sqlite-wasm": "3.48.0-build4",
		"acorn": "8.17.0",
		"chokidar": "5.0.0",
		"consola": "3.4.0",
		"human-id": "4.2.0",
		"js-sha256": "0.11.1",
		"kysely": "0.28.17",
		"picomatch": "4.0.4",
		"readdirp": "5.0.0",
		"sqlite-wasm-kysely": "0.3.0",
		"unplugin": "2.3.11",
		"urlpattern-polyfill": "10.1.0",
		"uuid": "14.0.1",
		"webpack-virtual-modules": "0.6.2"
	}
}
