{
	"name": "@pluxel/runtime-static",
	"version": "0.1.0",
	"description": "Pluxel runtime static route (fixed plugin catalog, startup reports, and drift checks)",
	"files": [
		"!**/*.map",
		"dist"
	],
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"build": "tsdown"
	},
	"dependencies": {
		"@pluxel/core": "workspace:*",
		"@pluxel/runtime": "workspace:*"
	},
	"devDependencies": {
		"typescript": "^6.0.3"
	}
}
