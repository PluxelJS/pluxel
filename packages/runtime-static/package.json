{
	"name": "@pluxel/runtime-static",
	"version": "0.1.0",
	"description": "Pluxel runtime static route (fixed plugin catalog, startup reports, and drift checks)",
	"files": [
		"!**/*.map",
		"dist"
	],
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./hmr": {
			"@pluxel/source": "./src/hmr.ts",
			"default": "./dist/hmr.mjs"
		},
		"./vite": {
			"@pluxel/source": "./src/vite.ts",
			"default": "./dist/vite.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./hmr": "./dist/hmr.mjs",
			"./vite": "./dist/vite.mjs",
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"test": "pnpm exec vitest run",
		"build": "tsdown"
	},
	"dependencies": {
		"@pluxel/core": "workspace:*",
		"@pluxel/rolldown": "workspace:*",
		"@pluxel/runtime": "workspace:*",
		"chokidar": "^5.0.0",
		"pathe": "^2.0.3"
	},
	"devDependencies": {
		"@pluxel/runtime-dev": "workspace:*",
		"@pluxel/test": "workspace:*",
		"typescript": "^6.0.3",
		"vite": "^8.0.0-beta.18"
	},
	"peerDependencies": {
		"vite": ">=8.0.0-beta.18 <9"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		}
	}
}
