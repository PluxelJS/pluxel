{
  "include": ["src", "../hmr/src/app/index.tsx"],
  "compilerOptions": {
    "strict": true,
    "composite": true,
    "esModuleInterop": true,
    "noEmit": false,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "allowJs": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/*"],
      "valibot-form": ["../valibot-form/src/*"]
    },
    "customConditions": ["@pluxel/source"]
  },
  "references": [{ "path": "../hmr" }, { "path": "../valibot-form" }]
}
