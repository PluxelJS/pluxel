{
	"name": "@pluxel/components",
	"version": "0.1.0",
	"private": true,
	"description": "Internal Pluxel runtime UI shell and component library",
	"type": "module",
	"main": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./components": {
			"types": "./src/components/index.ts",
			"default": "./src/components/index.ts"
		},
		"./extension": {
			"types": "./src/extension/index.ts",
			"default": "./src/extension/index.ts"
		},
		"./theme": {
			"types": "./src/theme/index.ts",
			"default": "./src/theme/index.ts"
		},
		"./hooks": {
			"types": "./src/hooks/index.ts",
			"default": "./src/hooks/index.ts"
		}
	},
	"scripts": {
		"dev": "pnpm -w run build:gqlens && vite",
		"build": "pnpm -w run build:gqlens && vite build",
		"preview": "vite preview",
		"test": "pnpm exec vitest run"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/modifiers": "^9.0.0",
		"@dnd-kit/sortable": "^10.0.0",
		"@gqlens/core": "workspace:*",
		"@gqlens/react": "workspace:*",
		"@material/material-color-utilities": "^0.4.0",
		"@module-federation/runtime": "^2.7.0",
		"@pluxel/core": "workspace:*",
		"@pluxel/runtime": "workspace:*",
		"@tanstack/react-hotkeys": "^0.8.4",
		"@tanstack/react-router": "^1.168.8",
		"@tanstack/react-store": "^0.9.3",
		"@tanstack/react-virtual": "^3.13.19",
		"@worksplit/react": "workspace:*",
		"markdown-exit": "^1.0.0-beta.8",
		"valibot-form": "workspace:*"
	},
	"devDependencies": {
		"@gqlens/vite": "workspace:*",
		"@pluxel/rolldown": "workspace:*",
		"@pluxel/runtime-dynamic": "workspace:*",
		"@tanstack/router-plugin": "^1.167.9",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.4",
		"capnweb": "^0.5.0",
		"graphql": "^16.13.0",
		"postcss": "^8.5.6",
		"postcss-preset-mantine": "^1.18.0",
		"postcss-simple-vars": "^7.0.1",
		"sass-embedded": "^1.93.2",
		"valibot": "^1.2.0",
		"vite": "^8.0.0-beta.18"
	},
	"peerDependencies": {
		"@mantine/core": "^9.4.1",
		"@mantine/dates": "^9.0.0",
		"@mantine/hooks": "^9.4.1",
		"@mantine/modals": "^9.0.0",
		"@mantine/notifications": "^9.4.1",
		"@tabler/icons-react": "^3.37.1",
		"@tanstack/react-form": "^1.28.3",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"valibot": "^1.2.0"
	}
}
