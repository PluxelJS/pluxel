{
	"extends": "../../tsconfig.options.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],

		// 输出配置
		"outDir": "dist", // 输出目录
		"rootDir": "src", // 源码根目录

		// 路径映射（alias）
		"baseUrl": ".", // 相对路径基准
		"paths": {
			"~/*": ["src/*"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.tsx"]
}
