{
	"name": "valibot-form",
	"version": "1.0.0",
	"private": false,
	"description": "Valibot schema-driven form renderer",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/pluxel",
		"directory": "packages/valibot-form"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./web": {
			"@pluxel/source": "./src/web/index.ts",
			"default": "./dist/web.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./web": "./dist/web.mjs",
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"build": "tsdown",
		"test": "pnpm exec vitest run",
		"typecheck": "tsc --noEmit --pretty false"
	},
	"dependencies": {
		"valibot": "^1.2.0"
	},
	"devDependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@mantine/core": "catalog:",
		"@mantine/hooks": "catalog:",
		"@tabler/icons-react": "catalog:",
		"@tanstack/react-form": "^1.28.3",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitejs/plugin-react": "^6.1.1",
		"jsdom": "^28.1.0",
		"react": "catalog:",
		"react-dom": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vite": "^8.2.2"
	},
	"peerDependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@mantine/core": "catalog:",
		"@mantine/hooks": "catalog:",
		"@tabler/icons-react": "catalog:",
		"@tanstack/react-form": "^1.28.3",
		"react": "catalog:",
		"react-dom": "catalog:"
	},
	"peerDependenciesMeta": {
		"@dnd-kit/core": {
			"optional": true
		},
		"@dnd-kit/sortable": {
			"optional": true
		},
		"@dnd-kit/utilities": {
			"optional": true
		},
		"@mantine/core": {
			"optional": true
		},
		"@mantine/hooks": {
			"optional": true
		},
		"@tabler/icons-react": {
			"optional": true
		},
		"@tanstack/react-form": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		}
	}
}
