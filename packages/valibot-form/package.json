{
	"private": "true",
	"name": "valibot-form",
	"version": "0.1.0",
	"description": "Demo example that imports a local package",
	"main": "./src/index.ts",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.mjs"
		},
		"./web": {
			"@pluxel/source": "./src/web/index.ts",
			"import": "./dist/web.mjs",
			"require": "./dist/web.cjs",
			"types": "./dist/web.d.ts",
			"default": "./dist/web.mjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "vite",
		"web:build": "vite build",
		"preview": "vite preview",
		"test": "vitest run"
	},
	"dependencies": {},
	"peerDependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/modifiers": "^9.0.0",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@mantine/core": "^8.2.2",
		"@tabler/icons-react": "^3.34.1",
		"@tanstack/react-form": "^1.23.0",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"valibot": "^1.1.0"
	},
	"devDependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/modifiers": "^9.0.0",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@mantine/core": "^8.2.2",
		"@tabler/icons-react": "^3.34.1",
		"@tanstack/react-form": "^1.23.0",
		"@types/react": "^19.2.2",
		"@types/react-dom": "^19.2.2",
		"@vitejs/plugin-react": "^5.1.0",
		"jsdom": "^25.0.1",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"tsdown": "^0.14.2",
		"typescript": "^5.9.2",
		"valibot": "^1.1.0",
		"vite": "^7.1.12",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^3.0.4"
	}
}
