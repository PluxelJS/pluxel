{
	"name": "valibot-form",
	"version": "1.2.0",
	"private": false,
	"description": "Valibot schema-driven form renderer",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/pluxel",
		"directory": "packages/valibot-form"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./web": {
			"@pluxel/source": "./src/web/index.ts",
			"default": "./dist/web.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./web": "./dist/web.mjs",
			"./package.json": "./package.json"
		},
		"access": "public"
	},
	"scripts": {
		"build": "vp run compile",
		"test": "vp run check-tests",
		"typecheck": "vp run check-types"
	},
	"dependencies": {
		"valibot": "catalog:validation"
	},
	"devDependencies": {
		"@dnd-kit/core": "catalog:frontend",
		"@dnd-kit/sortable": "catalog:frontend",
		"@dnd-kit/utilities": "catalog:frontend",
		"@mantine/core": "catalog:frontend",
		"@mantine/hooks": "catalog:frontend",
		"@pluxel/test": "workspace:*",
		"@tabler/icons-react": "catalog:icons",
		"@tanstack/react-form": "catalog:frontend",
		"@types/react": "catalog:types",
		"@types/react-dom": "catalog:types",
		"@vitejs/plugin-react": "catalog:build",
		"jsdom": "catalog:dev",
		"react": "catalog:frontend",
		"react-dom": "catalog:frontend",
		"typescript": "catalog:dev",
		"vite": "catalog:build",
		"vite-plus": "catalog:build"
	},
	"peerDependencies": {
		"@dnd-kit/core": "catalog:frontend",
		"@dnd-kit/sortable": "catalog:frontend",
		"@dnd-kit/utilities": "catalog:frontend",
		"@mantine/core": "catalog:frontend",
		"@mantine/hooks": "catalog:frontend",
		"@tabler/icons-react": "catalog:icons",
		"@tanstack/react-form": "catalog:frontend",
		"react": "catalog:frontend",
		"react-dom": "catalog:frontend"
	},
	"peerDependenciesMeta": {
		"@dnd-kit/core": {
			"optional": true
		},
		"@dnd-kit/sortable": {
			"optional": true
		},
		"@dnd-kit/utilities": {
			"optional": true
		},
		"@mantine/core": {
			"optional": true
		},
		"@mantine/hooks": {
			"optional": true
		},
		"@tabler/icons-react": {
			"optional": true
		},
		"@tanstack/react-form": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=24"
	}
}
