{
	"sideEffects": false,
	"type": "module",
	"name": "valibot-form",
	"version": "0.1.0",
	"description": "Demo example that imports a local package",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./web": {
			"@pluxel/source": "./src/web/index.ts",
			"default": "./dist/web.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "vite",
		"preview": "vite preview",
		"test": "vitest run"
	},
	"dependencies": {
		"valibot": "catalog:prod"
	},
	"peerDependencies": {
		"@dnd-kit/core": "catalog:peer",
		"@dnd-kit/modifiers": "catalog:peer",
		"@dnd-kit/sortable": "catalog:peer",
		"@dnd-kit/utilities": "catalog:peer",
		"@mantine/core": "catalog:peer",
		"@tabler/icons-react": "catalog:icons",
		"@tanstack/react-form": "catalog:frontend",
		"react": "catalog:frontend",
		"react-dom": "catalog:frontend"
	},
	"devDependencies": {
		"@dnd-kit/core": "catalog:dev",
		"@dnd-kit/modifiers": "catalog:dev",
		"@dnd-kit/sortable": "catalog:dev",
		"@dnd-kit/utilities": "catalog:dev",
		"@mantine/core": "catalog:dev",
		"@tabler/icons-react": "catalog:icons",
		"@tanstack/react-form": "catalog:frontend",
		"@types/react": "catalog:types",
		"@types/react-dom": "catalog:types",
		"@vitejs/plugin-react": "catalog:build",
		"jsdom": "catalog:dev",
		"react": "catalog:frontend",
		"react-dom": "catalog:frontend",
		"tsdown": "catalog:build",
		"typescript": "catalog:tsc",
		"vite": "catalog:build",
		"vite-tsconfig-paths": "catalog:build",
		"vitest": "catalog:test"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.js",
			"./web": "./dist/web.js",
			"./package.json": "./package.json"
		}
	}
}
