{
	"private": "true",
	"name": "valibot-form",
	"version": "0.1.0",
	"description": "Demo example that imports a local package",
	"main": "./src/index.ts",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown"
	},
	"dependencies": {},
	"peerDependencies": {
		"valibot": "^1.1.0"
	},
	"devDependencies": {
		"tsdown": "^0.14.2",
		"typescript": "^5.9.2"
	}
}
