{
	"sideEffects": true,
	"type": "module",
	"name": "valibot-form",
	"version": "0.1.0",
	"description": "Valibot schema-driven form renderer",
	"types": "./dist/index.d.mts",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./web": {
			"@pluxel/source": "./src/web/index.ts",
			"default": "./dist/web.mjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "vite",
		"preview": "vite preview",
		"test": "vitest run"
	},
	"dependencies": {
		"valibot": "^1.2.0"
	},
	"peerDependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/modifiers": "^9.0.0",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@mantine/core": "^8.3.13",
		"@mantine/hooks": "^8.3.13",
		"@tabler/icons-react": "^3.35.0",
		"@tanstack/react-form": "^1.23.8",
		"react": "^19.2.4",
		"react-dom": "^19.2.4"
	},
	"devDependencies": {
		"@mantine/core": "^8.3.13",
		"@mantine/hooks": "^8.3.13",
		"@tabler/icons-react": "^3.35.0",
		"@tanstack/react-form": "^1.23.8",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.2",
		"jsdom": "^25.0.1",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"tsdown": "^0.20.1",
		"typescript": "^5.9.3",
		"vite": "beta",
		"vitest": "^3.2.4"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./web": "./dist/web.mjs",
			"./package.json": "./package.json"
		}
	}
}
