{
	"name": "valibot-form",
	"version": "0.1.0",
	"private": false,
	"description": "Valibot schema-driven form renderer",
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./web": {
			"@pluxel/source": "./src/web/index.ts",
			"default": "./dist/web.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./web": "./dist/web.mjs",
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"build": "tsdown",
		"dev": "vite",
		"preview": "vite preview",
		"test": "pnpm exec vitest run"
	},
	"dependencies": {
		"valibot": "^1.2.0"
	},
	"devDependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@mantine/core": "^9.4.1",
		"@mantine/hooks": "^9.4.1",
		"@tabler/icons-react": "^3.37.1",
		"@tanstack/react-form": "^1.28.3",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.4",
		"jsdom": "^28.1.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"tsdown": "^0.22.3",
		"typescript": "^6.0.3",
		"vite": "^8.0.0-beta.18"
	},
	"peerDependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@mantine/core": "^9.4.1",
		"@mantine/hooks": "^9.4.1",
		"@tabler/icons-react": "^3.37.1",
		"@tanstack/react-form": "^1.28.3",
		"react": "^19.2.7",
		"react-dom": "^19.2.7"
	},
	"peerDependenciesMeta": {
		"@dnd-kit/core": {
			"optional": true
		},
		"@dnd-kit/sortable": {
			"optional": true
		},
		"@dnd-kit/utilities": {
			"optional": true
		},
		"@mantine/core": {
			"optional": true
		},
		"@mantine/hooks": {
			"optional": true
		},
		"@tabler/icons-react": {
			"optional": true
		},
		"@tanstack/react-form": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		}
	}
}
