{
	"extends": "../../tsconfig.src.json",
	"include": ["src", "tests", "../diod", "../context"],
	"compilerOptions": {
		"rootDir": "..",
		"baseUrl": ".",
		"outDir": "dist",
		"paths": {
			"diod": ["../diod/src"],
			"diod/*": ["../diod/src/*"],
			"@pluxel/context": ["../context/src"],
			"@pluxel/context/*": ["../context/src/*"],
			"@pluxel/core": ["./src"],
			"@pluxel/core/*": ["./src/*"]
		}
	}
}
