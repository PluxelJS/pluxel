{
	"extends": "../../tsconfig.src.json",
	"include": ["src", "tests", "fsm", "../diod", "../context", "../core-di"],
	"compilerOptions": {
		"rootDir": "..",
		"baseUrl": ".",
		"outDir": "dist",
		"noEmit": false,
		"emitDeclarationOnly": true,
		"jsx": "react-jsx",
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"paths": {
			"@pluxel/core-di": ["../core-di/src"],
			"@pluxel/core-di/*": ["../core-di/src/*"],
			"diod": ["../diod/src"],
			"diod/*": ["../diod/src/*"],
			"@pluxel/context": ["../context/src"],
			"@pluxel/context/*": ["../context/src/*"],
			"@pluxel/core": ["./src"],
			"@pluxel/core/*": ["./src/*"]
		}
	}
}
