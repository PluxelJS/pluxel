{
  "compilerOptions": {
    "target": "ES2022", // 支持最新语法（也可用 ES6+）
    "moduleDetection": "force",
    "module": "Preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "experimentalDecorators": true, // ✅ 开启装饰器
    "emitDecoratorMetadata": true, // ✅ 开启元数据发射
    "strict": true, // 推荐开启严格模式
    "moduleResolution": "node", // 适配 node 模块方式
    "esModuleInterop": true, // 兼容 commonjs 引入
    "skipLibCheck": true, // 忽略库类型检查，提升编译速度
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
