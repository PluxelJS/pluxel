{
	"extends": "../../tsconfig.src.json",
	"include": ["src", "tests", "fsm", "../context/src", "../context/tests"],
	"compilerOptions": {
		"rootDir": "..",
		"baseUrl": ".",
		"outDir": "dist",
		"noEmit": false,
		"emitDeclarationOnly": true,
		"jsx": "react-jsx",
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"paths": {
			"@pluxel/context": ["../context/src"],
			"@pluxel/context/*": ["../context/src/*"],
			"@pluxel/core": ["./src"],
			"@pluxel/core/*": ["./src/*"]
		}
	}
}
