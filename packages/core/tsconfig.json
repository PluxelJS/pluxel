{
	"extends": "../../tsconfig.src.json",
	"include": ["src", "tests"],
	"compilerOptions": {
		"rootDir": ".",
		"baseUrl": ".",
		"outDir": "dist",
		"noEmit": false,
		"emitDeclarationOnly": true,
		"jsx": "react-jsx",
		"experimentalDecorators": true,
		"paths": {
			"@pluxel/core": ["./src"],
			"@pluxel/core/*": ["./src/*"]
		}
	}
}
