{
  "private": true,
  "name": "@pluxel/core",
  "version": "0.1.0",
  "description": "Demo example that imports a local package",
  "main": "./src/index.ts",
  "type": "module",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "clean": "rimraf build .turbo",
    "test:unit": "vitest --workspace ../../vitest.workspace.ts --project unit run",
    "dev": "bun --watch run src/index.ts"
  },
  "dependencies": {
    "eventure": "file:../../../event-hook",
    "option-t": "53.0.0",
    "pino": "^9.7.0",
    "reflect-metadata": "^0.2.2",
    "valtio": "2.1.4",
    "xstate": "5.19.2"
  },
  "peerDependencies": {
    "typescript": "*"
  },
  "devDependencies": {
    "tsdown": "^0.11.2"
  }
}
