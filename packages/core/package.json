{
	"name": "@pluxel/core",
	"version": "0.3.0",
	"description": "Demo example that imports a local package",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"type": "module",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"require": "./dist/index.cjs",
			"import": "./dist/index.mjs"
		},
		"./env": {
			"@pluxel/source": "./src/env.ts",
			"require": "./dist/env.cjs",
			"import": "./dist/env.mjs"
		},
		"./logger": {
			"@pluxel/source": "./src/logger/index.ts",
			"require": "./dist/logger.cjs",
			"import": "./dist/logger.mjs"
		},
		"./services": {
			"@pluxel/source": "./src/services/index.ts",
			"require": "./dist/services.cjs",
			"import": "./dist/services.mjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"!**/*.map"
	],
	"scripts": {
		"test": "pnpm exec vitest run -c vitest.config.ts",
		"build": "tsdown",
		"dev": "bun --conditions=@pluxel/source --watch run tests/start.ts",
		"bench": "bun --conditions=@pluxel/source run bench/pluginLifecycle.bench.ts",
		"bench:dist": "pnpm --filter @pluxel/build build && pnpm run build && bun run --tsconfig-override=\"./bench-tsconfig.json\" bench/pluginLifecycle.bench.ts"
	},
	"dependencies": {
		"@logtape/file": "^2.0.1",
		"@logtape/logtape": "^2.0.1",
		"@logtape/pretty": "^2.0.1",
		"@noble/hashes": "^2.0.1",
		"@standard-schema/spec": "^1.1.0",
		"eventure": "^0.4.2",
		"pathe": "^2.0.3",
		"std-env": "^3.10.0",
		"youch": "4.1.0-beta.13"
	},
	"devDependencies": {
		"@abraham/reflection": "^0.13.0",
		"@pluxel/cli": "workspace:*",
		"@pluxel/context": "workspace:*",
		"@pluxel/build": "workspace:*",
		"@pluxel/test": "workspace:*",
		"diod": "workspace:*",
		"fs-fixture": "^2.11.0",
		"option-t": "^55.1.0",
		"tinybench": "^6.0.0"
	},
	"publishConfig": {
		"exports": {
			".": {
				"require": "./dist/index.cjs",
				"import": "./dist/index.mjs"
			},
			"./env": {
				"require": "./dist/env.cjs",
				"import": "./dist/env.mjs"
			},
			"./logger": {
				"require": "./dist/logger.cjs",
				"import": "./dist/logger.mjs"
			},
			"./services": {
				"require": "./dist/services.cjs",
				"import": "./dist/services.mjs"
			},
			"./package.json": "./package.json"
		}
	}
}
