{
	"name": "@pluxel/core",
	"version": "0.2.12",
	"description": "Demo example that imports a local package",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"type": "module",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"require": "./dist/index.cjs",
			"import": "./dist/index.mjs"
		},
		"./services": {
			"@pluxel/source": "./src/services/index.ts",
			"require": "./dist/services.cjs",
			"import": "./dist/services.mjs"
		},
		"./test": {
			"@pluxel/source": "./src/test/index.ts",
			"require": "./dist/test.cjs",
			"import": "./dist/test.mjs"
		},
		"./test/setup": {
			"@pluxel/source": "./src/test/setup.ts",
			"require": "./dist/test/setup.cjs",
			"import": "./dist/test/setup.mjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"!**/*.map"
	],
	"scripts": {
		"test": "bun test --conditions=@pluxel/source",
		"build": "tsdown",
		"dev": "bun --conditions=@pluxel/source --watch run tests/start.ts",
		"bench": "bun --conditions=@pluxel/source run bench/pluginLifecycle.bench.ts",
		"bench:dist": "pnpm --filter rolldown build && pnpm run build && bun run --tsconfig-override=\"./bench-tsconfig.json\" bench/pluginLifecycle.bench.ts"
	},
	"dependencies": {
		"eventure": "^0.4.2"
	},
	"devDependencies": {
		"@abraham/reflection": "^0.13.0",
		"@pluxel/context": "workspace:*",
		"@pluxel/rolldown": "workspace:*",
		"diod": "workspace:*",
		"option-t": "^55.1.0",
		"tinybench": "^6.0.0"
	},
	"publishConfig": {
		"exports": {
			".": {
				"require": "./dist/index.cjs",
				"import": "./dist/index.mjs"
			},
			"./services": {
				"require": "./dist/services.cjs",
				"import": "./dist/services.mjs"
			},
			"./test": {
				"require": "./dist/test.cjs",
				"import": "./dist/test.mjs"
			},
			"./test/setup": {
				"require": "./dist/test/setup.cjs",
				"import": "./dist/test/setup.mjs"
			},
			"./package.json": "./package.json"
		}
	}
}
