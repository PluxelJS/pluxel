{
	"name": "@pluxel/core",
	"version": "1.0.0",
	"description": "Pluxel plugin graph, lifecycle, Context, and core services",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/pluxel",
		"directory": "packages/core"
	},
	"files": [
		"dist",
		"!**/*.map"
	],
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./federation": {
			"@pluxel/source": "./src/federation.ts",
			"import": "./dist/federation.mjs",
			"require": "./dist/federation.cjs"
		},
		"./internal": {
			"@pluxel/source": "./src/internal.ts",
			"import": "./dist/internal.mjs",
			"require": "./dist/internal.cjs"
		},
		"./internal/test": {
			"@pluxel/source": "./src/internal-test.ts",
			"import": "./dist/internal/test.mjs",
			"require": "./dist/internal/test.cjs"
		},
		"./logger": {
			"@pluxel/source": "./src/logger/index.ts",
			"import": "./dist/logger.mjs",
			"require": "./dist/logger.cjs"
		},
		"./services": {
			"@pluxel/source": "./src/services/index.ts",
			"import": "./dist/services.mjs",
			"require": "./dist/services.cjs"
		},
		"./test": {
			"@pluxel/source": "./src/test.ts",
			"import": "./dist/test.mjs",
			"require": "./dist/test.cjs"
		},
		"./toolchain": {
			"@pluxel/source": "./src/toolchain.ts",
			"import": "./dist/toolchain.mjs",
			"require": "./dist/toolchain.cjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": {
				"import": "./dist/index.mjs",
				"require": "./dist/index.cjs"
			},
			"./federation": {
				"import": "./dist/federation.mjs",
				"require": "./dist/federation.cjs"
			},
			"./internal": {
				"import": "./dist/internal.mjs",
				"require": "./dist/internal.cjs"
			},
			"./internal/test": {
				"import": "./dist/internal/test.mjs",
				"require": "./dist/internal/test.cjs"
			},
			"./logger": {
				"import": "./dist/logger.mjs",
				"require": "./dist/logger.cjs"
			},
			"./services": {
				"import": "./dist/services.mjs",
				"require": "./dist/services.cjs"
			},
			"./test": {
				"import": "./dist/test.mjs",
				"require": "./dist/test.cjs"
			},
			"./toolchain": {
				"import": "./dist/toolchain.mjs",
				"require": "./dist/toolchain.cjs"
			},
			"./package.json": "./package.json"
		},
		"access": "public"
	},
	"scripts": {
		"test": "pnpm exec vitest run",
		"build": "tsdown",
		"typecheck": "tsc --noEmit --pretty false",
		"bench:dist": "pnpm run build && node --experimental-strip-types bench/pluginLifecycle.bench.ts",
		"bench:caller-view": "pnpm run build && node --experimental-strip-types bench/pluginCallerView.bench.ts",
		"bench:fork-cost": "pnpm run build && node --expose-gc --experimental-strip-types bench/pluginForkCost.bench.ts",
		"bench:di": "pnpm exec tsdown bench/vendor/diod/src/index.ts --no-config --format esm --out-dir bench/vendor/diod/dist --minify && pnpm exec tsdown src/internal/di/index.ts --no-config --format esm --out-dir dist/bench --minify && node --experimental-strip-types bench/compare-diod.bench.ts"
	},
	"dependencies": {
		"@logtape/logtape": "catalog:prod",
		"@standard-schema/spec": "catalog:prod",
		"eventure": "catalog:prod",
		"std-env": "catalog:prod"
	},
	"devDependencies": {
		"@pluxel/context": "workspace:*",
		"@pluxel/rolldown": "workspace:*",
		"@pluxel/test": "workspace:*",
		"option-t": "catalog:validation",
		"rolldown": "catalog:build",
		"tinybench": "catalog:dev",
		"unplugin-macros": "catalog:build"
	},
	"engines": {
		"node": ">=24"
	},
	"inlinedDependencies": {
		"option-t": "56.1.2"
	}
}
