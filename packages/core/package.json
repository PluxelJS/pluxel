{
	"name": "@pluxel/core",
	"version": "0.2.0",
	"description": "Demo example that imports a local package",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"type": "module",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./services": {
			"@pluxel/source": "./src/services/index.ts",
			"import": "./dist/services.mjs",
			"require": "./dist/services.cjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"!**/*.map"
	],
	"scripts": {
		"test": "bun test",
		"build": "tsdown",
		"dev": "bun --watch run tests/start.ts",
		"bench": "bun run tests/bench/pluginLifecycle.bench.ts"
	},
	"dependencies": {
		"eventure": "^0.4.2",
		"reflect-metadata": "^0.2.2",
		"xstate": "^5.24.0"
	},
	"devDependencies": {
		"@pluxel/context": "workspace:*",
		"@pluxel/rolldown": "workspace:*",
		"diod": "workspace:*",
		"option-t": "^55.1.0",
		"tinybench": "^5.1.0"
	},
	"publishConfig": {
		"exports": {
			".": {
				"import": "./dist/index.mjs",
				"require": "./dist/index.cjs"
			},
			"./services": {
				"import": "./dist/services.mjs",
				"require": "./dist/services.cjs"
			},
			"./package.json": "./package.json"
		}
	}
}
