{
  "private": true,
  "name": "@pluxel/core",
  "version": "0.1.0",
  "description": "Demo example that imports a local package",
  "main": "./src/index.ts",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "@pluxel/source": "./src/index.ts",
        "default": "./dist/index.js",
        "types": "./dist/index.d.ts"
      },
      "require": {
        "@pluxel/source": "./src/index.ts",
        "default": "./dist/index.cjs",
        "types": "./dist/index.d.cts"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf build .turbo",
    "build": "tsdown",
    "dev": "bun --watch run src/start.ts"
  },
  "dependencies": {
    "option-t": "53.0.0",
    "pino": "^9.7.0",
    "reflect-metadata": "^0.2.2",
    "valtio": "2.1.5",
    "xstate": "5.20.1"
  },
  "peerDependencies": {
    "tsdown": "*",
    "typescript": "*"
  },
  "devDependencies": {
    "@pluxel/context": "workspace:*",
    "diod": "workspace:*",
    "eventure": "file:..\\..\\..\\event-hook"
  }
}
