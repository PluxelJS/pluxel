{
	"name": "@pluxel/core",
	"version": "0.3.0",
	"description": "Demo example that imports a local package",
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/pluxel",
		"directory": "packages/core"
	},
	"files": [
		"dist",
		"!**/*.map"
	],
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./env": {
			"@pluxel/source": "./src/env.ts",
			"import": "./dist/env.mjs",
			"require": "./dist/env.cjs"
		},
		"./federation": {
			"@pluxel/source": "./src/federation.ts",
			"import": "./dist/federation.mjs",
			"require": "./dist/federation.cjs"
		},
		"./logger": {
			"@pluxel/source": "./src/logger/index.ts",
			"import": "./dist/logger.mjs",
			"require": "./dist/logger.cjs"
		},
		"./services": {
			"@pluxel/source": "./src/services/index.ts",
			"import": "./dist/services.mjs",
			"require": "./dist/services.cjs"
		},
		"./test": {
			"@pluxel/source": "./src/test.ts",
			"import": "./dist/test.mjs",
			"require": "./dist/test.cjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": {
				"import": "./dist/index.mjs",
				"require": "./dist/index.cjs"
			},
			"./env": {
				"import": "./dist/env.mjs",
				"require": "./dist/env.cjs"
			},
			"./federation": {
				"import": "./dist/federation.mjs",
				"require": "./dist/federation.cjs"
			},
			"./logger": {
				"import": "./dist/logger.mjs",
				"require": "./dist/logger.cjs"
			},
			"./services": {
				"import": "./dist/services.mjs",
				"require": "./dist/services.cjs"
			},
			"./test": {
				"import": "./dist/test.mjs",
				"require": "./dist/test.cjs"
			},
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"test": "pnpm exec vitest run",
		"build": "tsdown",
		"bench:dist": "pnpm run build && node bench/pluginLifecycle.bench.ts"
	},
	"dependencies": {
		"@logtape/logtape": "^2.0.2",
		"@logtape/pretty": "^2.0.2",
		"@standard-schema/spec": "^1.1.0",
		"eventure": "^0.4.4",
		"pathe": "^2.0.3",
		"std-env": "^4.0.0-rc.1",
		"youch": "^4.1.0"
	},
	"devDependencies": {
		"@abraham/reflection": "^0.13.0",
		"@pluxel/context": "workspace:*",
		"@pluxel/core-di": "workspace:*",
		"option-t": "^55.1.2",
		"rolldown": "^1.1.5",
		"tinybench": "^6.0.0",
		"unplugin-macros": "^0.20.2"
	},
	"inlinedDependencies": {
		"@abraham/reflection": "0.13.0",
		"option-t": "55.1.2"
	}
}
