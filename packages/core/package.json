{
	"name": "@pluxel/core",
	"version": "0.1.2",
	"description": "Demo example that imports a local package",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.cts",
	"type": "module",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./service": {
			"@pluxel/source": "./src/service/index.ts",
			"import": "./dist/service.js",
			"require": "./dist/service.cjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"test": "bun test",
		"build": "tsdown",
		"dev": "bun --watch run tests/start.ts",
		"bench": "bun run tests/bench/pluginLifecycle.bench.ts"
	},
	"dependencies": {
		"eventure": "^0.3.0",
		"option-t": "54.2.4",
		"reflect-metadata": "^0.2.2",
		"xstate": "5.20.1"
	},
	"devDependencies": {
		"@pluxel/context": "workspace:*",
		"diod": "workspace:*",
		"tinybench": "^5.1.0"
	},
	"publishConfig": {
		"exports": {
			".": {
				"import": "./dist/index.js",
				"require": "./dist/index.cjs"
			},
			"./service": {
				"import": "./dist/service.js",
				"require": "./dist/service.cjs"
			},
			"./package.json": "./package.json"
		}
	}
}