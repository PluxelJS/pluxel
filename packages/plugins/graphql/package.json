{
	"name": "pluxel-plugin-graphql",
	"version": "0.1.0",
	"description": "Pluxel builtin plugin: GraphQL runtime + codegen",
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/hmr": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"!**/*.map",
		"dist"
	],
	"scripts": {
		"build:plugin": "pluxel build",
		"test": "bun test --conditions=@pluxel/source"
	},
	"dependencies": {
		"@gqloom/core": "^0.15.0",
		"@gqloom/valibot": "^0.15.0",
		"@gqty/cli": "^5.0.0",
		"graphql": "^16.12.0",
		"graphql-yoga": "^5.18.0",
		"valibot": "^1.2.0"
	},
	"peerDependencies": {
		"@pluxel/core": "workspace:*",
		"@pluxel/hmr": "workspace:*"
	},
	"devDependencies": {
		"@pluxel/rolldown": "workspace:*",
		"tsdown": "0.20.1",
		"typescript": "^5.9.3"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./package.json": "./package.json"
		}
	},
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs"
}
