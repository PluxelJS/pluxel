{
	"$schema": "https://market.pluxel.dev/schema/package.json",
	"name": "@pluxel/wretch",
	"version": "0.1.0",
	"description": "Pluxel builtin forkable HTTP client plugin powered by wretch",
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/hmr": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"!**/*.map",
		"dist"
	],
	"scripts": {
		"build": "pluxel build",
		"build:plugin": "pluxel build",
		"test": "pnpm exec vitest run -c vitest.config.ts"
	},
	"dependencies": {
		"valibot": "^1.2.0",
		"wretch": "^3.0.6"
	},
	"peerDependencies": {
		"@pluxel/core": "workspace:*",
		"@pluxel/hmr": "workspace:*"
	},
	"devDependencies": {
		"@pluxel/cli": "workspace:*",
		"@pluxel/test": "workspace:*",
		"tsdown": "^0.20.3",
		"typescript": "^5.9.3"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./package.json": "./package.json"
		}
	}
}
