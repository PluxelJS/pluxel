{
	"$schema": "https://market.pluxel.dev/schema/package.json",
	"name": "pluxel-plugin-market-ui",
	"private": true,
	"version": "0.1.0",
	"description": "Pluxel builtin plugin: Market UI",
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/runtime": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"!**/*.map",
		"dist"
	],
	"scripts": {
		"build": "pluxel build && pnpm run build:ui",
		"build:lib": "pluxel build && pnpm run build:ui",
		"build:plugin": "pluxel build && pnpm run build:ui",
		"build:ui": "node scripts/build-ui.mjs",
		"test": "pnpm exec vitest run"
	},
	"peerDependencies": {
		"@mantine/core": "^8.3.15",
		"@mantine/hooks": "^8.3.15",
		"@pluxel/core": "workspace:*",
		"@pluxel/hmr": "workspace:*",
		"@pluxel/runtime": "workspace:*",
		"@pluxel/market": "^0.1.0",
		"@tabler/icons-react": "^3.37.1",
		"react": "^19.2.4",
		"react-dom": "^19.2.4"
	},
	"devDependencies": {
		"@pluxel/cli": "workspace:*",
		"@pluxel/hmr": "workspace:*",
		"@pluxel/runtime": "workspace:*",
		"@pluxel/test": "workspace:*",
		"tsdown": "^0.20.3",
		"typescript": "^5.9.3"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./package.json": "./package.json"
		}
	}
}
