{
	"extends": "../../../../../tsconfig.options.json",
	"compilerOptions": {
		// Demo-only typecheck:
		// - do NOT pull workspace source via `@pluxel/source` (use dist .d.ts)
		// - do NOT require composite/project-reference file lists
		"customConditions": [],
		"composite": false,
		"declaration": false,
		"declarationMap": false,
		"incremental": false,
		"noEmit": true,
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"jsx": "react-jsx",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"baseUrl": "../../../../../",
		"paths": {
			"@pluxel/context": ["packages/context/src/index.ts"],
			"@pluxel/context/*": ["packages/context/src/*"],
			"@pluxel/core": ["packages/core/src/index.ts"],
			"@pluxel/core/*": ["packages/core/src/*"],
			"@pluxel/runtime": ["packages/runtime/src/index.ts"],
			"@pluxel/runtime/services": ["packages/runtime/src/services.ts"],
			"@pluxel/runtime/web/ui": ["packages/runtime/src/web/ui.ts"],
			"@pluxel/runtime/web/extensions": ["packages/runtime/src/web/extensions.ts"],
			"@pluxel/runtime/web/federation": ["packages/runtime/src/web/federation.ts"]
		}
	},
	"include": ["./**/*.ts", "./**/*.tsx"]
}
