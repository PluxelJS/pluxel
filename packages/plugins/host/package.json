		"hot": "bun --hot --conditions=@pluxel/source src/start.ts"
	},
	"dependencies": {
		"@pluxel/core": "workspace:*",
		"@pluxel/hmr": "workspace:*",
		"pluxel-plugin-graphql": "workspace:*",
		"pluxel-plugin-market-ui": "workspace:*",
		"pluxel-plugin-wretch": "workspace:*"
	},
	"devDependencies": {
		"@mantine/core": "^8.3.13",
		"@mantine/hooks": "^8.3.13",
		"@tabler/icons-react": "^3.35.0",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"react": "^19.2.3",
		"react-dom": "^19.2.3"
	}
}
