{
	"name": "@pluxel/plugins-host",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node scripts/host.mjs dev",
		"prompt": "pnpm exec pluxel hmr prompt --root ../../.. --config packages/plugins/host/pluxel.hmr.jsonc --profile plugins-host",
		"doctor": "pnpm exec pluxel hmr doctor --root ../../.. --config packages/plugins/host/pluxel.hmr.jsonc --profile plugins-host",
