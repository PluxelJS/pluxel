{
	"name": "@pluxel/plugins-host",
	"private": true,
	"type": "module",
	"scripts": {
		"dynamic": "pnpm exec vite --config vite.dynamic.config.ts --host 127.0.0.1",
		"static": "pnpm exec vite --config vite.static.config.ts --host 127.0.0.1",
		"static:direct": "pnpm exec tsx src/static.ts",
		"typecheck": "pnpm exec tsc -p src/demo/tsconfig.json --pretty false",
		"dynamic:prompt": "pnpm exec pluxel hmr prompt --root ../../.. --config packages/plugins/host/pluxel.loader.hmr.jsonc --profile plugins-host",
		"dynamic:doctor": "pnpm exec pluxel hmr doctor --root ../../.. --config packages/plugins/host/pluxel.loader.hmr.jsonc --profile plugins-host"
	},
	"dependencies": {
		"@pluxel/runtime": "workspace:*",
		"@pluxel/runtime-dynamic": "workspace:*",
		"@pluxel/runtime-static": "workspace:*"
	},
	"devDependencies": {
		"@mantine/core": "^9.4.1",
		"@pluxel/cli": "workspace:*",
		"@tabler/icons-react": "^3.37.1",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"pathe": "^2.0.3",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"tinypool": "^2.1.0",
		"tsx": "^4.22.4",
		"vite": "^8.0.0-beta.18"
	}
}
