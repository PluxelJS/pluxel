{
	"name": "@pluxel/plugins-static-commercial-demo",
	"private": true,
	"type": "module",
	"scripts": {
		"codegen": "tsx tooling/generate-gqlens.ts",
		"dev": "tsx tooling/generate-gqlens.ts && vite --host 127.0.0.1",
