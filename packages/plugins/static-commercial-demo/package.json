		"@gqloom/valibot": "^0.15.1",
		"@pluxel/runtime": "workspace:*",
		"@pluxel/runtime-static": "workspace:*",
		"graphql": "^16.13.0",
		"graphql-yoga": "^5.18.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"valibot": "^1.2.0"
	},
	"devDependencies": {
		"@gqlens/codegen": "link:../../../../GQLens/packages/codegen",
		"@types/node": "^25.9.3",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.4",
