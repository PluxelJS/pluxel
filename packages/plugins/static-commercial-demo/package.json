{
	"name": "@pluxel/plugins-static-commercial-demo",
	"private": true,
	"type": "module",
	"scripts": {
		"codegen": "pnpm -w run build:gqlens && node tooling/generate-gqlens.ts",
		"dev": "pnpm run codegen && vite --host 127.0.0.1",
		"build": "pnpm run codegen && vite build",
		"typecheck": "pnpm run codegen && tsc --noEmit",
		"static": "pnpm run codegen && vite --host 127.0.0.1",
		"verify": "pnpm run codegen && tsc --noEmit && vite build"
	},
	"dependencies": {
		"@gqlens/core": "workspace:*",
		"@gqlens/react": "workspace:*",
		"@gqloom/core": "^0.16.1",
		"@gqloom/valibot": "^0.15.1",
		"@libsql/client": "^0.17.4",
		"@pluxel/runtime": "workspace:*",
		"@pluxel/runtime-static": "workspace:*",
		"drizzle-orm": "^0.45.2",
		"graphql": "^16.13.0",
		"graphql-yoga": "^5.18.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"valibot": "^1.2.0"
	},
	"devDependencies": {
		"@gqlens/vite": "workspace:*",
		"@types/node": "^25.9.3",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.4",
		"typescript": "^6.0.3",
		"vite": "^8.0.0-beta.18"
	}
}
