{
	"name": "@pluxel/plugins-static-commercial-demo",
	"private": true,
	"type": "module",
	"scripts": {
		"codegen": "tsx tooling/generate-gqlens.ts",
		"dev": "tsx tooling/generate-gqlens.ts && vite --host 127.0.0.1",
		"build": "tsx tooling/generate-gqlens.ts && vite build",
		"typecheck": "tsx tooling/generate-gqlens.ts && tsc --noEmit",
		"static": "tsx src/static.ts",
		"verify": "tsx tooling/generate-gqlens.ts && tsc --noEmit && vite build"
	},
	"dependencies": {
		"@gqlens/core": "^0.2.0",
		"@gqlens/react": "^0.2.0",
		"@gqloom/core": "^0.16.1",
		"@gqloom/valibot": "^0.15.1",
		"@libsql/client": "^0.17.4",
		"@pluxel/runtime": "workspace:*",
		"@pluxel/runtime-static": "workspace:*",
		"drizzle-orm": "^0.45.2",
		"graphql": "^16.13.0",
		"graphql-yoga": "^5.18.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"valibot": "^1.2.0"
	},
	"devDependencies": {
		"@gqlens/codegen": "^0.2.0",
		"@gqlens/vite": "^0.2.0",
		"@types/node": "^25.9.3",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.4",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"vite": "^8.0.0-beta.18"
	}
}
