{
	"name": "@pluxel/services",
	"version": "0.1.0",
	"description": "Explicitly installed runtime services for Pluxel Hosts",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/pluxel",
		"directory": "packages/services"
	},
	"files": [
		"dist",
		"!**/*.map"
	],
	"type": "module",
	"types": "./dist/index.d.mts",
	"imports": {
		"#pluxel/database-driver/pglite": {
			"@pluxel/source": "./src/database/adapters/pglite.ts",
			"default": "./dist/internal/database/pglite.mjs"
		},
		"#pluxel/database-driver/postgres": {
			"@pluxel/source": "./src/database/adapters/postgres.ts",
			"default": "./dist/internal/database/postgres.mjs"
		}
	},
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./build": {
			"@pluxel/source": "./src/build.ts",
			"default": "./dist/build.mjs"
		},
		"./capnweb": {
			"@pluxel/source": "./src/capnweb.ts",
			"default": "./dist/capnweb.mjs"
		},
		"./commands": {
			"@pluxel/source": "./src/commands.ts",
			"default": "./dist/commands.mjs"
		},
		"./database": {
			"@pluxel/source": "./src/database.ts",
			"default": "./dist/database.mjs"
		},
		"./database/pglite": {
			"@pluxel/source": "./src/database/pglite.ts",
			"default": "./dist/database/pglite.mjs"
		},
		"./database/postgres": {
			"@pluxel/source": "./src/database/postgres.ts",
			"default": "./dist/database/postgres.mjs"
		},
		"./http": {
			"@pluxel/source": "./src/http.ts",
			"default": "./dist/http.mjs"
		},
		"./http/node": {
			"@pluxel/source": "./src/http-node.ts",
			"default": "./dist/http/node.mjs"
		},
		"./http/vite": {
			"@pluxel/source": "./src/development/http.ts",
			"default": "./dist/http/vite.mjs"
		},
		"./internal": {
			"@pluxel/source": "./src/internal.ts",
			"default": "./dist/internal.mjs"
		},
		"./internal/test": {
			"@pluxel/source": "./src/internal-test.ts",
			"default": "./dist/internal/test.mjs"
		},
		"./logging": {
			"@pluxel/source": "./src/logging/index.ts",
			"default": "./dist/logging.mjs"
		},
		"./logging/internal": {
			"@pluxel/source": "./src/logging/internal.ts",
			"default": "./dist/logging/internal.mjs"
		},
		"./logging/protocol": {
			"@pluxel/source": "./src/logging/protocol.ts",
			"default": "./dist/logging/protocol.mjs"
		},
		"./management": {
			"@pluxel/source": "./src/management/index.ts",
			"default": "./dist/management.mjs"
		},
		"./management/access": {
			"@pluxel/source": "./src/management/access.ts",
			"default": "./dist/management/access.mjs"
		},
		"./management/client": {
			"@pluxel/source": "./src/management/client.ts",
			"default": "./dist/management/client.mjs"
		},
		"./management/commands": {
			"@pluxel/source": "./src/management/commands.ts",
			"default": "./dist/management/commands.mjs"
		},
		"./management/http": {
			"@pluxel/source": "./src/management/http.ts",
			"default": "./dist/management/http.mjs"
		},
		"./management/internal": {
			"@pluxel/source": "./src/management/internal.ts",
			"default": "./dist/management/internal.mjs"
		},
		"./management/internal/http": {
			"@pluxel/source": "./src/management/http-internal.ts",
			"default": "./dist/management/internal/http.mjs"
		},
		"./management/internal/test": {
			"@pluxel/source": "./src/management/test-internal.ts",
			"default": "./dist/management/internal/test.mjs"
		},
		"./management/product": {
			"@pluxel/source": "./src/management/product-contract.ts",
			"default": "./dist/management/product.mjs"
		},
		"./management/protocol": {
			"@pluxel/source": "./src/management/protocol.ts",
			"default": "./dist/management/protocol.mjs"
		},
		"./management/react": {
			"@pluxel/source": "./src/management/react.ts",
			"default": "./dist/management/react.mjs"
		},
		"./management/service": {
			"@pluxel/source": "./src/management/service.ts",
			"default": "./dist/management/service.mjs"
		},
		"./management/session": {
			"@pluxel/source": "./src/management/web/session/index.ts",
			"default": "./dist/management/session.mjs"
		},
		"./mcp": {
			"@pluxel/source": "./src/mcp.ts",
			"default": "./dist/mcp.mjs"
		},
		"./node": {
			"@pluxel/source": "./src/node.ts",
			"default": "./dist/node.mjs"
		},
		"./node/vite": {
			"@pluxel/source": "./src/development/node.ts",
			"default": "./dist/node/vite.mjs"
		},
		"./persistence": {
			"@pluxel/source": "./src/persistence.ts",
			"default": "./dist/persistence.mjs"
		},
		"./preset": {
			"@pluxel/source": "./src/preset.ts",
			"default": "./dist/preset.mjs"
		},
		"./vault": {
			"@pluxel/source": "./src/vault.ts",
			"default": "./dist/vault.mjs"
		},
		"./vite": {
			"@pluxel/source": "./src/vite.ts",
			"default": "./dist/vite.mjs"
		},
		"./workers": {
			"@pluxel/source": "./src/workers.ts",
			"default": "./dist/workers.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"imports": {
			"#pluxel/database-driver/pglite": "./dist/internal/database/pglite.mjs",
			"#pluxel/database-driver/postgres": "./dist/internal/database/postgres.mjs"
		},
		"exports": {
			".": "./dist/index.mjs",
			"./build": "./dist/build.mjs",
			"./capnweb": "./dist/capnweb.mjs",
			"./commands": "./dist/commands.mjs",
			"./database": "./dist/database.mjs",
			"./database/pglite": "./dist/database/pglite.mjs",
			"./database/postgres": "./dist/database/postgres.mjs",
			"./http": "./dist/http.mjs",
			"./http/node": "./dist/http/node.mjs",
			"./http/vite": "./dist/http/vite.mjs",
			"./internal": "./dist/internal.mjs",
			"./internal/test": "./dist/internal/test.mjs",
			"./logging": "./dist/logging.mjs",
			"./logging/internal": "./dist/logging/internal.mjs",
			"./logging/protocol": "./dist/logging/protocol.mjs",
			"./management": "./dist/management.mjs",
			"./management/access": "./dist/management/access.mjs",
			"./management/client": "./dist/management/client.mjs",
			"./management/commands": "./dist/management/commands.mjs",
			"./management/http": "./dist/management/http.mjs",
			"./management/internal": "./dist/management/internal.mjs",
			"./management/internal/http": "./dist/management/internal/http.mjs",
			"./management/internal/test": "./dist/management/internal/test.mjs",
			"./management/product": "./dist/management/product.mjs",
			"./management/protocol": "./dist/management/protocol.mjs",
			"./management/react": "./dist/management/react.mjs",
			"./management/service": "./dist/management/service.mjs",
			"./management/session": "./dist/management/session.mjs",
			"./mcp": "./dist/mcp.mjs",
			"./node": "./dist/node.mjs",
			"./node/vite": "./dist/node/vite.mjs",
			"./persistence": "./dist/persistence.mjs",
			"./preset": "./dist/preset.mjs",
			"./vault": "./dist/vault.mjs",
			"./vite": "./dist/vite.mjs",
			"./workers": "./dist/workers.mjs",
			"./package.json": "./package.json"
		},
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit --pretty false",
		"test": "pnpm exec vitest run",
		"test:installed": "pnpm exec vitest run --config tests/installed.config.mts && node tests/installed-plugin.smoke.mjs && node tests/installed-node.smoke.mjs",
		"bench:worker-task": "pnpm exec vitest bench bench/worker-task.bench.ts",
		"bench:logger": "vitest bench bench/logger.bench.ts"
	},
	"dependencies": {
		"@logtape/file": "catalog:prod",
		"@logtape/logtape": "catalog:prod",
		"@logtape/pretty": "catalog:prod",
		"age-encryption": "catalog:prod",
		"capnweb": "catalog:prod",
		"chokidar": "catalog:node",
		"crossws": "catalog:prod",
		"drizzle-orm": "catalog:backend",
		"pathe": "catalog:node",
		"srvx": "catalog:prod",
		"std-env": "catalog:prod",
		"valibot-form": "workspace:^"
	},
	"devDependencies": {
		"@electric-sql/pglite": "catalog:prod",
		"@modelcontextprotocol/sdk": "catalog:prod",
		"@pluxel/commands": "workspace:*",
		"@pluxel/core": "workspace:*",
		"@pluxel/host": "workspace:*",
		"@pluxel/host-dev": "workspace:*",
		"@pluxel/rolldown": "workspace:*",
		"@pluxel/test": "workspace:*",
		"@pluxel/workbench": "workspace:*",
		"@types/node": "catalog:types",
		"@types/pg": "catalog:types",
		"@types/react": "catalog:types",
		"elysia": "catalog:prod",
		"fs-fixture": "catalog:dev",
		"pg": "catalog:backend",
		"react": "catalog:frontend",
		"tsx": "catalog:dev",
		"valibot": "catalog:validation",
		"vite": "catalog:build"
	},
	"peerDependencies": {
		"@electric-sql/pglite": "catalog:prod",
		"@modelcontextprotocol/sdk": "catalog:prod",
		"@pluxel/commands": "workspace:^",
		"@pluxel/core": "workspace:^",
		"@pluxel/host": "workspace:^",
		"@pluxel/host-dev": "workspace:^",
		"@pluxel/rolldown": "workspace:^",
		"@pluxel/workbench": "workspace:^",
		"elysia": "catalog:prod",
		"pg": "catalog:backend",
		"react": "catalog:frontend",
		"vite": ">=8.2.2 <9"
	},
	"peerDependenciesMeta": {
		"@electric-sql/pglite": {
			"optional": true
		},
		"@modelcontextprotocol/sdk": {
			"optional": true
		},
		"pg": {
			"optional": true
		},
		"elysia": {
			"optional": true
		},
		"@pluxel/rolldown": {
			"optional": true
		},
		"@pluxel/host-dev": {
			"optional": true
		},
		"vite": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"@pluxel/workbench": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=24"
	}
}
