{
	"name": "@pluxel/services",
	"version": "0.1.0",
	"description": "Explicitly installed runtime services for Pluxel Hosts",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/pluxel",
		"directory": "packages/services"
	},
	"files": [
		"dist",
		"!**/*.map"
	],
	"type": "module",
	"types": "./dist/index.d.mts",
	"imports": {
		"#pluxel/database-driver/pglite": {
			"@pluxel/source": "./src/database/adapters/pglite.ts",
			"default": "./dist/internal/database/pglite.mjs"
		},
		"#pluxel/database-driver/postgres": {
			"@pluxel/source": "./src/database/adapters/postgres.ts",
			"default": "./dist/internal/database/postgres.mjs"
		}
	},
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./build": {
			"@pluxel/source": "./src/build.ts",
			"default": "./dist/build.mjs"
		},
		"./commands": {
			"@pluxel/source": "./src/commands.ts",
			"default": "./dist/commands.mjs"
		},
		"./database": {
			"@pluxel/source": "./src/database.ts",
			"default": "./dist/database.mjs"
		},
		"./database/pglite": {
			"@pluxel/source": "./src/database/pglite.ts",
			"default": "./dist/database/pglite.mjs"
		},
		"./database/postgres": {
			"@pluxel/source": "./src/database/postgres.ts",
			"default": "./dist/database/postgres.mjs"
		},
		"./http": {
			"@pluxel/source": "./src/http.ts",
			"default": "./dist/http.mjs"
		},
		"./http/application": {
			"@pluxel/source": "./src/http/application.ts",
			"default": "./dist/http/application.mjs"
		},
		"./http/assets": {
			"@pluxel/source": "./src/http/assets.ts",
			"default": "./dist/http/assets.mjs"
		},
		"./http/listener": {
			"@pluxel/source": "./src/http/listener.ts",
			"default": "./dist/http/listener.mjs"
		},
		"./http/node": {
			"@pluxel/source": "./src/http/node.ts",
			"default": "./dist/http/node.mjs"
		},
		"./http/vite": {
			"@pluxel/source": "./src/http-vite.ts",
			"default": "./dist/http/vite.mjs"
		},
		"./internal/database": {
			"@pluxel/source": "./src/database/internal.ts",
			"default": "./dist/internal/database.mjs"
		},
		"./internal/database/pglite": {
			"@pluxel/source": "./src/database/adapters/pglite.ts",
			"default": "./dist/internal/database/pglite.mjs"
		},
		"./internal/database/postgres": {
			"@pluxel/source": "./src/database/adapters/postgres.ts",
			"default": "./dist/internal/database/postgres.mjs"
		},
		"./internal/http": {
			"@pluxel/source": "./src/http/internal.ts",
			"default": "./dist/internal/http.mjs"
		},
		"./internal/node": {
			"@pluxel/source": "./src/node/internal.ts",
			"default": "./dist/internal/node.mjs"
		},
		"./internal/node-declaration": {
			"@pluxel/source": "./src/node/declaration.ts",
			"default": "./dist/internal/node-declaration.mjs"
		},
		"./internal/owner-view": {
			"@pluxel/source": "./src/internal/owner-view.ts",
			"default": "./dist/internal/owner-view.mjs"
		},
		"./internal/persistence": {
			"@pluxel/source": "./src/persistence/service.ts",
			"default": "./dist/internal/persistence.mjs"
		},
		"./internal/plugin-address": {
			"@pluxel/source": "./src/internal/plugin-address.ts",
			"default": "./dist/internal/plugin-address.mjs"
		},
		"./internal/security": {
			"@pluxel/source": "./src/internal/security.ts",
			"default": "./dist/internal/security.mjs"
		},
		"./internal/test": {
			"@pluxel/source": "./src/internal-test.ts",
			"default": "./dist/internal/test.mjs"
		},
		"./internal/vault": {
			"@pluxel/source": "./src/vault/service.ts",
			"default": "./dist/internal/vault.mjs"
		},
		"./internal/vault-types": {
			"@pluxel/source": "./src/vault/types.ts",
			"default": "./dist/internal/vault-types.mjs"
		},
		"./internal/vite-node-carrier": {
			"@pluxel/source": "./src/development/vite-node-carrier.ts",
			"default": "./dist/internal/vite-node-carrier.mjs"
		},
		"./internal/workspace-fs": {
			"@pluxel/source": "./src/internal/workspace-fs.ts",
			"default": "./dist/internal/workspace-fs.mjs"
		},
		"./node": {
			"@pluxel/source": "./src/node.ts",
			"default": "./dist/node.mjs"
		},
		"./node/vite": {
			"@pluxel/source": "./src/node-vite.ts",
			"default": "./dist/node/vite.mjs"
		},
		"./persistence": {
			"@pluxel/source": "./src/persistence.ts",
			"default": "./dist/persistence.mjs"
		},
		"./preset": {
			"@pluxel/source": "./src/preset.ts",
			"default": "./dist/preset.mjs"
		},
		"./test": {
			"@pluxel/source": "./src/test.ts",
			"default": "./dist/test.mjs"
		},
		"./vault": {
			"@pluxel/source": "./src/vault.ts",
			"default": "./dist/vault.mjs"
		},
		"./vite": {
			"@pluxel/source": "./src/vite.ts",
			"default": "./dist/vite.mjs"
		},
		"./workers": {
			"@pluxel/source": "./src/workers.ts",
			"default": "./dist/workers.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"imports": {
			"#pluxel/database-driver/pglite": "./dist/internal/database/pglite.mjs",
			"#pluxel/database-driver/postgres": "./dist/internal/database/postgres.mjs"
		},
		"exports": {
			".": "./dist/index.mjs",
			"./build": "./dist/build.mjs",
			"./commands": "./dist/commands.mjs",
			"./database": "./dist/database.mjs",
			"./database/pglite": "./dist/database/pglite.mjs",
			"./database/postgres": "./dist/database/postgres.mjs",
			"./http": "./dist/http.mjs",
			"./http/application": "./dist/http/application.mjs",
			"./http/assets": "./dist/http/assets.mjs",
			"./http/listener": "./dist/http/listener.mjs",
			"./http/node": "./dist/http/node.mjs",
			"./http/vite": "./dist/http/vite.mjs",
			"./internal/database": "./dist/internal/database.mjs",
			"./internal/database/pglite": "./dist/internal/database/pglite.mjs",
			"./internal/database/postgres": "./dist/internal/database/postgres.mjs",
			"./internal/http": "./dist/internal/http.mjs",
			"./internal/node": "./dist/internal/node.mjs",
			"./internal/node-declaration": "./dist/internal/node-declaration.mjs",
			"./internal/owner-view": "./dist/internal/owner-view.mjs",
			"./internal/persistence": "./dist/internal/persistence.mjs",
			"./internal/plugin-address": "./dist/internal/plugin-address.mjs",
			"./internal/security": "./dist/internal/security.mjs",
			"./internal/test": "./dist/internal/test.mjs",
			"./internal/vault": "./dist/internal/vault.mjs",
			"./internal/vault-types": "./dist/internal/vault-types.mjs",
			"./internal/vite-node-carrier": "./dist/internal/vite-node-carrier.mjs",
			"./internal/workspace-fs": "./dist/internal/workspace-fs.mjs",
			"./node": "./dist/node.mjs",
			"./node/vite": "./dist/node/vite.mjs",
			"./persistence": "./dist/persistence.mjs",
			"./preset": "./dist/preset.mjs",
			"./test": "./dist/test.mjs",
			"./vault": "./dist/vault.mjs",
			"./vite": "./dist/vite.mjs",
			"./workers": "./dist/workers.mjs",
			"./package.json": "./package.json"
		},
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit --pretty false",
		"test": "pnpm exec vitest run",
		"test:installed": "pnpm exec vitest run --config tests/installed.config.mts && node tests/installed-plugin.smoke.mjs && node tests/installed-node.smoke.mjs",
		"bench:worker-task": "pnpm exec vitest bench bench/worker-task.bench.ts"
	},
	"dependencies": {
		"@pluxel/commands": "workspace:^",
		"@pluxel/core": "workspace:^",
		"@pluxel/host": "workspace:^",
		"age-encryption": "catalog:prod",
		"capnweb": "catalog:prod",
		"chokidar": "catalog:node",
		"crossws": "catalog:prod",
		"drizzle-orm": "catalog:backend",
		"pathe": "catalog:node",
		"srvx": "catalog:prod",
		"std-env": "catalog:prod"
	},
	"devDependencies": {
		"@electric-sql/pglite": "catalog:prod",
		"@pluxel/host-dev": "workspace:*",
		"@pluxel/logging": "workspace:*",
		"@pluxel/management": "workspace:*",
		"@pluxel/rolldown": "workspace:*",
		"@pluxel/test": "workspace:*",
		"@pluxel/workbench": "workspace:*",
		"@types/pg": "catalog:types",
		"elysia": "catalog:prod",
		"fs-fixture": "catalog:dev",
		"pg": "catalog:backend",
		"tsx": "catalog:dev",
		"valibot": "catalog:validation",
		"valibot-form": "workspace:*",
		"vite": "catalog:build"
	},
	"peerDependencies": {
		"@electric-sql/pglite": "catalog:prod",
		"@pluxel/host-dev": "workspace:^",
		"@pluxel/logging": "workspace:^",
		"@pluxel/management": "workspace:^",
		"@pluxel/rolldown": "workspace:^",
		"@pluxel/workbench": "workspace:^",
		"elysia": "catalog:prod",
		"pg": "catalog:backend",
		"vite": ">=8.2.2 <9"
	},
	"peerDependenciesMeta": {
		"@electric-sql/pglite": {
			"optional": true
		},
		"pg": {
			"optional": true
		},
		"elysia": {
			"optional": true
		},
		"@pluxel/logging": {
			"optional": true
		},
		"@pluxel/management": {
			"optional": true
		},
		"@pluxel/workbench": {
			"optional": true
		},
		"@pluxel/rolldown": {
			"optional": true
		},
		"@pluxel/host-dev": {
			"optional": true
		},
		"vite": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=24"
	}
}
