{
	"name": "@pluxel/commands",
	"version": "1.0.0",
	"description": "Typed command kernel for CLIs and transport adapters",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/pluxel",
		"directory": "packages/commands"
	},
	"files": [
		"dist",
		"docs",
		"!**/*.map",
		"!**/*.tsbuildinfo"
	],
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./argv": {
			"@pluxel/source": "./src/argv.ts",
			"import": "./dist/argv.mjs",
			"require": "./dist/argv.cjs"
		},
		"./capnweb": {
			"@pluxel/source": "./src/capnweb.ts",
			"import": "./dist/capnweb.mjs",
			"require": "./dist/capnweb.cjs"
		},
		"./internal": {
			"@pluxel/source": "./src/internal.ts",
			"import": "./dist/internal.mjs",
			"require": "./dist/internal.cjs"
		},
		"./mcp": {
			"@pluxel/source": "./src/mcp.ts",
			"import": "./dist/mcp.mjs",
			"require": "./dist/mcp.cjs"
		},
		"./typebox": {
			"@pluxel/source": "./src/typebox.ts",
			"import": "./dist/typebox.mjs",
			"require": "./dist/typebox.cjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": {
				"import": "./dist/index.mjs",
				"require": "./dist/index.cjs"
			},
			"./argv": {
				"import": "./dist/argv.mjs",
				"require": "./dist/argv.cjs"
			},
			"./capnweb": {
				"import": "./dist/capnweb.mjs",
				"require": "./dist/capnweb.cjs"
			},
			"./internal": {
				"import": "./dist/internal.mjs",
				"require": "./dist/internal.cjs"
			},
			"./mcp": {
				"import": "./dist/mcp.mjs",
				"require": "./dist/mcp.cjs"
			},
			"./typebox": {
				"import": "./dist/typebox.mjs",
				"require": "./dist/typebox.cjs"
			},
			"./package.json": "./package.json"
		},
		"access": "public"
	},
	"scripts": {
		"test": "pnpm exec vitest run",
		"bench": "pnpm exec vitest bench bench/commands.bench.ts",
		"typecheck": "tsc --noEmit --pretty false",
		"build": "tsdown"
	},
	"dependencies": {
		"@sinclair/typebox": "catalog:prod",
		"better-result": "catalog:prod"
	},
	"devDependencies": {
		"@modelcontextprotocol/sdk": "catalog:prod",
		"@pluxel/test": "workspace:*",
		"@sinclair/parsebox": "catalog:dev",
		"@types/node": "catalog:types",
		"capnweb": "catalog:dev"
	},
	"peerDependencies": {
		"@modelcontextprotocol/sdk": "catalog:prod",
		"capnweb": "catalog:prod"
	},
	"peerDependenciesMeta": {
		"@modelcontextprotocol/sdk": {
			"optional": true
		},
		"capnweb": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=24"
	}
}
