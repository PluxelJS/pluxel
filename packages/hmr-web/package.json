{
	"private": true,
	"name": "@pluxel/hmr-web",
	"version": "0.1.0",
	"description": "Browser client for Pluxel HMR (RPC/SSE helpers + React hooks)",
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./react": {
			"@pluxel/source": "./src/react.tsx",
			"default": "./dist/react.mjs"
		},
		"./vendors": {
			"@pluxel/source": "./src/vendors.ts",
			"default": "./dist/vendors.mjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"!**/*.map",
		"dist"
	],
	"scripts": {
		"build": "tsdown"
	},
	"dependencies": {
		"capnweb": "^0.5.0",
		"hono": "^4.12.2"
	},
	"peerDependencies": {
		"react": "^19.2.4"
	},
	"devDependencies": {
		"@types/react": "^19.2.14",
		"tsdown": "^0.20.3"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./react": "./dist/react.mjs",
			"./vendors": "./dist/vendors.mjs",
			"./package.json": "./package.json"
		}
	}
}
