import { withRuntimeHost } from '@pluxel/runtime/test'
import { describe, expect, it } from 'vitest'
import { {{className}}Plugin } from '../src/index.ts'

describe('{{className}}Plugin', () => {
	it('keeps business HTTP available without Web Management', async () => {
		await withRuntimeHost(
			async (host) => {
				host.add({{className}}Plugin)
				host.cfg({{className}}Plugin).enable()
				await host.commit()

				expect(host.isRunning({{className}}Plugin)).toBe(true)

				const response = await host.ctx.http.fetch(
					new Request(
						'http://local.test/__pluxel/plugins/{{className}}Plugin/api/greeting?name=Pluxel',
					),
				)

				expect(response.status).toBe(200)
				expect(await response.json()).toEqual({ message: 'Hello, Pluxel!' })

				const graphQL = await host.ctx.http.fetch(
					new Request('http://local.test/__pluxel/plugins/{{className}}Plugin/api/graphql', {
						method: 'POST',
						headers: { 'content-type': 'application/json' },
						body: JSON.stringify({
							query: 'query Greeting($name: String) { greeting(name: $name) }',
							variables: { name: 'GQLens' },
						}),
					}),
				)
				expect(graphQL.status).toBe(200)
				expect(await graphQL.json()).toEqual({ data: { greeting: 'Hello, GQLens!' } })
			},
			{ webManagement: false },
		)
	})
})
