{
	"name": "{{packageName}}",
	"description": "{{description}}",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.8.0",
	"engines": {
		"node": ">=24",
		"pnpm": ">=11"
	},
	"scripts": {
		"dev": "pnpm --filter {{packageName}}-host dev",
		"build": "pnpm -r --if-present build",
		"lint": "oxlint apps packages plugins",
		"test": "pnpm -r --if-present test",
		"typecheck": "pnpm -r --if-present typecheck",
		"verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
	},
	"devDependencies": {
		"@pluxel/rolldown": "^0.1.0",
		"@types/node": "^25.0.0",
		"oxlint": "^1.72.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.0",
		"vitest": "^4.1.9"
	}
}
