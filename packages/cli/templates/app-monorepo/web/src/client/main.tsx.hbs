import { createGraphDataStore } from '@gqlens/core'
import { GQLensProvider } from '@gqlens/react'
import { StrictMode, useMemo, useState } from 'react'
import { createRoot } from 'react-dom/client'
import { useQuery } from './gqlens/accessor'
import { graphqlFetcher } from './graphql-fetcher'
import './styles.css'

function GreetingApp() {
	const store = useMemo(() => createGraphDataStore(), [])
	const config = useMemo(() => ({ fetcher: graphqlFetcher, store }), [store])

	return (
		<GQLensProvider config={config}>
			<GreetingDemo />
		</GQLensProvider>
	)
}

function GreetingDemo() {
	const [name, setName] = useState('Pluxel')
	const query = useQuery()
	const greeting = query.greeting({ name })

	return (
		<main>
			<p className="eyebrow">Static runtime · React HMR · GQLens codegen</p>
			<h1>{greeting || 'Loading greeting…'}</h1>
			<label>
				<span>Name</span>
				<input value={name} onChange={(event) => setName(event.currentTarget.value)} />
			</label>
			<p>
				Edit <code>web/src/client/main.tsx</code> for React HMR, or change the domain GraphQL schema
				to see GQLens regenerate typed accessors.
			</p>
		</main>
	)
}

const root = document.querySelector('#root')
if (!root) throw new Error('Missing #root element')
createRoot(root).render(
	<StrictMode>
		<GreetingApp />
	</StrictMode>,
)
