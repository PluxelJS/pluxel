import { gqlens } from '@gqlens/vite'
import { staticRuntimeVitePlugin } from '@pluxel/runtime-static/vite'
import react from '@vitejs/plugin-react'
import { defineConfig } from 'vite'

const graphqlEndpoint = '/__pluxel/plugins/{{className}}Plugin/api/graphql'

export default defineConfig(({ mode }) => ({
	appType: 'spa',
	server: {
		host: process.env.PLUXEL_HOST_BIND ?? '127.0.0.1',
		port: Number(process.env.PLUXEL_HOST_PORT ?? 3310),
	},
	plugins:
		mode === 'test'
			? []
			: [
					staticRuntimeVitePlugin({ config: './src/pluxel.static.ts' }),
					gqlens({
						output: 'src/client/gqlens',
						entry: '/src/graphql-entry.ts',
						endpoint: graphqlEndpoint,
						include: [/\/plugins\/example\/src\//, /\/packages\/domain\/src\//],
						framework: 'react',
						middleware: false,
					}),
					react(),
				],
}))
