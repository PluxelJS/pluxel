import { BasePlugin, Plugin, v } from '@pluxel/runtime'

const MessageConfig = v.optional(v.string(), 'ready')

@Plugin({ name: '{{className}}Plugin' })
export class {{className}}Plugin extends BasePlugin {
	readonly message = this.configs.use(MessageConfig)

	override init(): void {
		this.ctx.logger.info('{{className}}Plugin ready', { message: this.message })
	}
}
