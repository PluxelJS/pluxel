import { withRuntimeHost } from '@pluxel/runtime/test'
import { describe, expect, it } from 'vitest'
import { {{className}} } from '../src/{{pluginName}}'

describe('{{className}}', () => {
	it('starts inside a host with validated config metadata', async () => {
		await withRuntimeHost(async (host) => {
			host.add({{className}})

			host.cfg({{className}}).enable()
			expect(host.cfg({{className}}).enabled()).toBe(true)

			await host.start({{className}})
			expect(host.isRunning({{className}})).toBe(true)
			expect(host.require({{className}}).enabled).toBe(true)

			host.cfg({{className}}).disable()
			expect(host.cfg({{className}}).enabled()).toBe(false)
		})
	})
})
