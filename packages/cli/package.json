{
	"name": "@pluxel/cli",
	"version": "0.2.12",
	"description": "Demo example that imports a local package",
	"bin": {
		"pluxel": "bin/pluxel.mjs"
	},
	"exports": {
		"./hmr": {
			"@pluxel/source": "./src/hmr/index.ts",
			"import": "./dist/hmr.mjs",
			"default": "./dist/hmr.mjs"
		},
		"./workspace": {
			"@pluxel/source": "./src/workspace/index.ts",
			"import": "./dist/workspace.mjs",
			"default": "./dist/workspace.mjs"
		},
		"./build": {
			"@pluxel/source": "./src/build.ts",
			"import": "./dist/build.mjs",
			"default": "./dist/build.mjs"
		},
		"./rolldown": {
			"@pluxel/source": "./src/rolldown.ts",
			"import": "./dist/rolldown.mjs",
			"default": "./dist/rolldown.mjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"bin",
		"dist",
		"!**/*.map"
	],
	"type": "module",
	"scripts": {
		"dev": "bun src/cli.ts new plugin",
		"build": "tsdown",
		"test": "pnpm exec vitest run -c vitest.config.ts"
	},
	"peerDependencies": {
		"@pluxel/market": "*",
		"tsdown": "*"
	},
	"dependencies": {
		"@clack/prompts": "^0.11.0",
		"fdir": "^6.5.0",
		"gunshi": "^0.26.3",
		"jsonc-parser": "^3.3.1",
		"node-plop": "^0.32.3",
		"package-manager-detector": "^1.5.0",
		"pathe": "^2.0.3",
		"picomatch": "^4.0.2",
		"pkg-types": "^2.3.0",
		"yaml": "^2.5.0"
	},
	"devDependencies": {
		"@pluxel/build": "workspace:*",
		"@pluxel/test": "workspace:*",
		"@types/picomatch": "^4.0.2",
		"fs-fixture": "^2.11.0",
		"tsdown": "^0.20.1",
		"typescript": "^5.9.3"
	}
}
