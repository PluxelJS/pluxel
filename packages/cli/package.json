{
	"name": "@pluxel/cli",
	"version": "1.0.0",
	"description": "Pluxel CLI",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/pluxel",
		"directory": "packages/cli"
	},
	"bin": {
		"pluxel": "bin/pluxel.mjs"
	},
	"files": [
		"bin",
		"dist",
		"!**/*.map"
	],
	"type": "module",
	"exports": {
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			"./package.json": "./package.json"
		},
		"access": "public"
	},
	"scripts": {
		"dev": "pnpm run build && node dist/cli.mjs new --dry-run --no-install",
		"build": "tsdown",
		"test": "pnpm exec vitest run",
		"test:templates": "node scripts/smoke-plugin.ts",
		"typecheck": "tsc --noEmit --pretty false --composite false --customConditions development"
	},
	"dependencies": {
		"@clack/prompts": "catalog:prod",
		"gunshi": "catalog:prod",
		"jsonc-parser": "catalog:prod",
		"package-manager-detector": "catalog:prod",
		"pathe": "catalog:node",
		"picomatch": "catalog:prod",
		"pkg-types": "catalog:node",
		"semver": "catalog:prod",
		"yaml": "catalog:prod"
	},
	"devDependencies": {
		"@pluxel/market": "catalog:dev",
		"@pluxel/rolldown": "workspace:*",
		"@pluxel/runtime-dynamic": "workspace:*",
		"@pluxel/test": "workspace:*",
		"@types/picomatch": "catalog:types",
		"@types/react": "catalog:types",
		"@types/semver": "catalog:types",
		"ink": "catalog:dev",
		"react": "catalog:frontend",
		"tsdown": "catalog:build",
		"typescript": "catalog:dev"
	},
	"peerDependencies": {
		"@pluxel/market": "catalog:peer",
		"@pluxel/rolldown": "workspace:^",
		"@pluxel/runtime-dynamic": "workspace:^",
		"oxlint": "catalog:peer",
		"tsdown": "catalog:build"
	},
	"peerDependenciesMeta": {
		"@pluxel/market": {
			"optional": true
		},
		"@pluxel/rolldown": {
			"optional": true
		},
		"@pluxel/runtime-dynamic": {
			"optional": true
		},
		"oxlint": {
			"optional": true
		},
		"tsdown": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=24"
	}
}
