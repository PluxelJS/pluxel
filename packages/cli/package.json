{
	"name": "@pluxel/cli",
	"version": "1.2.0",
	"description": "Pluxel CLI",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/pluxel",
		"directory": "packages/cli"
	},
	"bin": {
		"pluxel": "bin/pluxel.mjs"
	},
	"files": [
		"bin",
		"dist",
		"!**/*.map"
	],
	"type": "module",
	"exports": {
		"./pncat": {
			"types": "./dist/pncat-config.d.mts",
			"default": "./dist/pncat-config.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			"./pncat": {
				"types": "./dist/pncat-config.d.mts",
				"default": "./dist/pncat-config.mjs"
			},
			"./package.json": "./package.json"
		},
		"access": "public"
	},
	"scripts": {
		"dev": "vp run build && node dist/cli.mjs new --dry-run --no-install",
		"build": "vp run compile",
		"test": "vp run check-tests",
		"test:templates": "node scripts/smoke-plugin.ts",
		"typecheck": "vp run check-types"
	},
	"dependencies": {
		"@clack/prompts": "catalog:prod",
		"gunshi": "catalog:prod",
		"jsonc-parser": "catalog:prod",
		"package-manager-detector": "catalog:prod",
		"pathe": "catalog:node",
		"picomatch": "catalog:prod",
		"pkg-types": "catalog:node",
		"semver": "catalog:prod",
		"yaml": "catalog:prod"
	},
	"devDependencies": {
		"@pluxel-internal/pncat": "workspace:*",
		"@pluxel/market": "catalog:dev",
		"@pluxel/rolldown": "workspace:*",
		"@pluxel/test": "workspace:*",
		"@types/picomatch": "catalog:types",
		"@types/semver": "catalog:types",
		"tsx": "catalog:dev",
		"typescript": "catalog:dev",
		"vite-plus": "catalog:build"
	},
	"peerDependencies": {
		"@pluxel/market": "catalog:peer",
		"@pluxel/rolldown": "workspace:^",
		"vite-plus": "catalog:build"
	},
	"peerDependenciesMeta": {
		"@pluxel/market": {
			"optional": true
		},
		"@pluxel/rolldown": {
			"optional": true
		},
		"vite-plus": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=24"
	}
}
