{
	"name": "@pluxel/cli",
	"version": "0.3.0",
	"description": "Pluxel CLI",
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/pluxel",
		"directory": "packages/cli"
	},
	"bin": {
		"pluxel": "bin/pluxel.mjs"
	},
	"files": [
		"bin",
		"dist",
		"!**/*.map"
	],
	"type": "module",
	"exports": {
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"dev": "pnpm run build && node dist/cli.mjs new --dry-run --no-install",
		"build": "tsdown",
		"test": "pnpm exec vitest run",
		"test:templates": "node scripts/smoke-app-monorepo.ts"
	},
	"dependencies": {
		"@clack/prompts": "^1.0.1",
		"gunshi": "^0.29.2",
		"jsonc-parser": "^3.3.1",
		"package-manager-detector": "^1.6.0",
		"pathe": "^2.0.3",
		"picomatch": "^4.0.3",
		"pkg-types": "^2.3.0",
		"yaml": "^2.8.2"
	},
	"devDependencies": {
		"@pluxel/market": "^0.1.0",
		"@pluxel/rolldown": "workspace:*",
		"@pluxel/runtime-dynamic": "workspace:*",
		"@pluxel/test": "workspace:*",
		"@types/picomatch": "^4.0.2",
		"@types/react": "^19.2.14",
		"ink": "^6.8.0",
		"react": "^19.2.7",
		"tsdown": "^0.22.5",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"@pluxel/market": "^0.1.0",
		"@pluxel/rolldown": "^0.1.0",
		"@pluxel/runtime-dynamic": "^0.3.0",
		"oxlint": "^1.58.0",
		"tsdown": "^0.22.5"
	},
	"peerDependenciesMeta": {
		"@pluxel/market": {
			"optional": true
		},
		"@pluxel/rolldown": {
			"optional": true
		},
		"@pluxel/runtime-dynamic": {
			"optional": true
		},
		"oxlint": {
			"optional": true
		},
		"tsdown": {
			"optional": true
		}
	}
}
