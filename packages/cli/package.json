{
	"name": "@pluxel/cli",
	"version": "1.0.0",
	"description": "Pluxel CLI",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/pluxel",
		"directory": "packages/cli"
	},
	"bin": {
		"pluxel": "bin/pluxel.mjs"
	},
	"files": [
		"bin",
		"dist",
		"!**/*.map"
	],
	"type": "module",
	"exports": {
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"dev": "pnpm run build && node dist/cli.mjs new --dry-run --no-install",
		"build": "tsdown",
		"test": "pnpm exec vitest run",
		"test:templates": "node scripts/smoke-plugin.ts"
	},
	"dependencies": {
		"@clack/prompts": "^1.0.1",
		"gunshi": "^0.29.2",
		"jsonc-parser": "^3.3.1",
		"package-manager-detector": "^1.6.0",
		"pathe": "^2.0.3",
		"picomatch": "^4.0.3",
		"pkg-types": "^2.3.0",
		"semver": "^7.8.5",
		"yaml": "catalog:"
	},
	"devDependencies": {
		"@pluxel/market": "catalog:",
		"@pluxel/rolldown": "workspace:*",
		"@pluxel/runtime-dynamic": "workspace:*",
		"@pluxel/test": "workspace:*",
		"@types/picomatch": "^4.0.2",
		"@types/react": "catalog:",
		"ink": "^6.8.0",
		"react": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"@pluxel/market": "catalog:",
		"@pluxel/rolldown": "workspace:^",
		"@pluxel/runtime-dynamic": "workspace:^",
		"oxlint": "^1.58.0",
		"tsdown": "catalog:"
	},
	"peerDependenciesMeta": {
		"@pluxel/market": {
			"optional": true
		},
		"@pluxel/rolldown": {
			"optional": true
		},
		"@pluxel/runtime-dynamic": {
			"optional": true
		},
		"oxlint": {
			"optional": true
		},
		"tsdown": {
			"optional": true
		}
	}
}
