{
	"name": "@example/todo-plugin",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"@pluxel/hmr": "./src/index.ts",
			"default": "./dist/index.mjs"
		}
	},
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc --noEmit --pretty false",
		"build": "pluxel build"
	},
	"dependencies": {
