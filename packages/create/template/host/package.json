{
	"name": "@example/host",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite --config vite.config.ts",
		"start": "node dist/app.mjs",
		"build": "vite build --config vite.config.ts && tsdown && pluxel distribution create ./dist",
		"typecheck": "tsc --noEmit --pretty false"
	},
	"dependencies": {
		"@example/audit-plugin": "workspace:*",
		"@example/http-plugin": "workspace:*",
		"@example/todo-plugin": "workspace:*",
		"@pluxel/host-dynamic": "catalog:pluxel",
		"@pluxel/runtime": "catalog:pluxel",
		"react": "catalog:frontend",
		"react-dom": "catalog:frontend"
	},
	"devDependencies": {
		"@example/web": "workspace:*",
		"@mantine/core": "catalog:frontend",
		"@mantine/hooks": "catalog:frontend",
		"@pluxel/cli": "catalog:pluxel",
		"@pluxel/host-dev": "catalog:pluxel",
		"@pluxel/rolldown": "catalog:pluxel",
		"@tabler/icons-react": "catalog:frontend",
		"@types/node": "catalog:tooling",
		"@types/react": "catalog:frontend",
		"@types/react-dom": "catalog:frontend",
		"@vitejs/plugin-react": "catalog:frontend",
		"tsdown": "catalog:tooling",
		"typescript": "catalog:tooling",
		"vite": "catalog:tooling"
	}
}
