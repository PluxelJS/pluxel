{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"test": {
			"outputs": ["coverage/**"],
			"dependsOn": ["build"]
		},
		"web": {
			"outputs": ["public/**"],
			"dependsOn": []
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
