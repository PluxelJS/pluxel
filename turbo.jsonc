{
	"$schema": "https://turbo.build/schema.json",
	"concurrency": "100%",
	"globalDependencies": ["mise.toml"],
	"cacheDir": ".turbo/cache",
	"cacheMaxAge": "30d",
	"cacheMaxSize": "5GB",
	"globalPassThroughEnv": [
		"CHOKIDAR_USEPOLLING",
		"PNPM_CONFIG_PM_ON_FAIL",
		"PNPM_CONFIG_WORKSPACE_DIR",
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "public/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/tsconfig*.json",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"@pluxel/commands#build": {
			"dependsOn": [],
			"outputs": ["dist/**"],
		},
		"@pluxel/core#build": {
			"dependsOn": ["@pluxel/context#build", "eventure#build"],
			"outputs": ["dist/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/tsconfig*.json",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"valibot-form#build": {
			"dependsOn": [],
			"outputs": ["dist/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/tsconfig*.json",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"@pluxel/rolldown#build": {
			"dependsOn": ["@pluxel/core#build", "valibot-form#build"],
			"outputs": ["dist/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/tsconfig*.json",
				"$TURBO_ROOT$/packages/workbench/package.json",
				"$TURBO_ROOT$/packages/workbench/src/workbench/shared-transport.ts",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"@pluxel/test#build": {
			"dependsOn": ["@pluxel/rolldown#build", "@pluxel/services#build", "@pluxel/workbench#build"],
			"outputs": ["dist/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"@pluxel/host-vite#build": {
			"dependsOn": ["@pluxel/core#build", "@pluxel/host#build", "@pluxel/rolldown#build"],
			"outputs": ["dist/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"@pluxel/cli#build": {
			"dependsOn": ["@pluxel/rolldown#build"],
			"outputs": ["dist/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/docs/**",
				"$TURBO_ROOT$/.agents/skills/pluxel-development/**",
				"$TURBO_ROOT$/pnpm-workspace.yaml",
				"$TURBO_ROOT$/vendor/pncat/src/**",
				"$TURBO_ROOT$/vendor/pncat/package.json",
				"$TURBO_ROOT$/tsconfig.cli-build.json",
				"$TURBO_ROOT$/vendor/pncat/LICENSE.md",
				"$TURBO_ROOT$/vendor/pncat/UPSTREAM.md",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"@pluxel/cli#typecheck": {
			"dependsOn": ["^build"],
			"outputs": [],
		},
		"@pluxel/create#build": {
			"dependsOn": [],
			"outputs": ["dist/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/pnpm-workspace.yaml",
				"$TURBO_ROOT$/packages/cli/scripts/dependency-policy.*",
				"$TURBO_ROOT$/packages/*/package.json",
				"$TURBO_ROOT$/plugins/**/package.json",
				"$TURBO_ROOT$/docs/**",
				"!README.md",
				"!IMPLEMENTATION_INDEX.md",
				"!scripts/**",
				"!tests/**",
			],
			"outputLogs": "new-only",
		},
		"pluxel-docs#build": {
			"dependsOn": ["valibot-form#build"],
			"outputs": ["dist/**", ".source/**", ".vercel/output/**"],
			"env": ["VERCEL*"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/**"],
			"outputLogs": "new-only",
		},
		"build:lib": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"],
			"outputLogs": "new-only",
		},
		"build:web": {
			"dependsOn": [],
			"outputs": ["public/**"],
			"outputLogs": "new-only",
		},
		"build:plugin": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "public/**"],
			"outputLogs": "new-only",
		},
		"test": {
			"dependsOn": ["^build", "@pluxel/test#build"],
			"outputs": [],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/oxlint.config.ts",
				"$TURBO_ROOT$/tsconfig*.json",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
			],
			"outputLogs": "errors-only",
		},
		"@pluxel/redis#test": {
			"dependsOn": ["^build"],
			"outputs": [],
			"env": ["PLUXEL_REDIS_TEST_URL"],
		},
		"@pluxel/cli#test": {
			"dependsOn": ["^build", "build"],
		},
		"@pluxel/package-manager#test": {
			"dependsOn": ["^build", "build", "@pluxel/test#build"],
		},
		"@pluxel/plugins-host#test": {
			"dependsOn": ["^build", "build", "@pluxel/test#build"],
		},
		"@pluxel/create#test": {
			"dependsOn": ["^build", "build", "@pluxel/test#build"],
		},
		"@pluxel/host-vite#test": {
			"dependsOn": ["^build", "build", "@pluxel/host#build", "@pluxel/test#build"],
		},
		"@pluxel/rolldown#test": {
			"dependsOn": ["^build"],
			"outputs": [],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/oxlint.config.ts",
				"$TURBO_ROOT$/tsconfig*.json",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
			],
			"outputLogs": "errors-only",
		},
		"@worksplit/react#test": {
			"dependsOn": ["^build", "@pluxel/test#build"],
		},
		"typecheck": {
			"dependsOn": ["^build"],
			"outputs": [],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/tsconfig*.json",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
			],
			"outputLogs": "errors-only",
		},
		"@worksplit/react#typecheck": {
			"dependsOn": ["^build", "@pluxel/host-vite#build"],
		},
		"@pluxel/plugins-host#typecheck": {
			"dependsOn": ["^build"],
			"outputs": [],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig*.json"],
			"outputLogs": "errors-only",
		},
		"dev": {
			"cache": false,
			"persistent": true,
		},
		"@pluxel/services#build": {
			"dependsOn": ["@pluxel/commands#build", "@pluxel/host#build", "@pluxel/host-vite#build"],
			"outputs": ["dist/**", "public/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/tsconfig*.json",
				"$TURBO_ROOT$/packages/workbench/package.json",
				"$TURBO_ROOT$/packages/workbench/tsconfig.json",
				"$TURBO_ROOT$/packages/workbench/src/**",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
		},
		"@pluxel/workbench#build": {
			"dependsOn": [
				"@pluxel/services#build",
				"@pluxel/rolldown#build",
				"@worksplit/react#build",
				"valibot-form#build",
			],
			"outputs": ["dist/**", "public/**"],
			"inputs": ["$TURBO_DEFAULT$", "!README.md", "!**/*.md", "!tests/**", "!**/*.test.*"],
		},
		"@pluxel/host#build": {
			"dependsOn": ["@pluxel/core#build"],
			"outputs": ["dist/**"],
		},
	},
}
