{
	"$schema": "https://turbo.build/schema.json",
	// Build/test packages are independent once their declared artifact prerequisites are ready.
	// Use every logical processor; callers can still lower this with `--concurrency` when needed.
	"concurrency": "100%",
	// Keep a useful local history without allowing build artifacts to grow without bounds.
	"cacheMaxAge": "30d",
	"cacheMaxSize": "5GB",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "public/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/tsconfig*.json",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"@pluxel/test#build": {
			// `@pluxel/test` is a dev-only helper package. It compiles against the
			// source-export surface of core/runtime and must not pull those build
			// tasks into Turbo's topological graph, otherwise internal packages that
			// use `@pluxel/test` in devDependencies create a false build cycle.
			// Its bundled rolldown helpers do need built dist artifacts.
			"dependsOn": ["@pluxel/rolldown#build"],
			"outputs": ["dist/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"@pluxel/ops#build": {
			"dependsOn": [],
			"outputs": ["dist/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"@pluxel/runtime#build": {
			"dependsOn": [
				"@pluxel/core#build",
				"@pluxel/ops#build",
				"@pluxel/rolldown#build",
				"valibot-form#build",
			],
			"outputs": ["dist/**", "public/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"@pluxel/runtime-dynamic#build": {
			"dependsOn": [
				"@pluxel/rolldown#build",
				"@pluxel/core#build",
				"@pluxel/runtime#build",
				"@pluxel/runtime-dev#build",
			],
			"outputs": ["dist/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"@pluxel/runtime-dev#build": {
			// Test helpers are development-only consumers; production compiler entries only need
			// core, runtime and rolldown artifacts.
			"dependsOn": ["@pluxel/core#build", "@pluxel/rolldown#build", "@pluxel/runtime#build"],
			"outputs": ["dist/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"@pluxel/runtime-static#build": {
			"dependsOn": ["@pluxel/core#build", "@pluxel/runtime#build", "@pluxel/runtime-dev#build"],
			"outputs": ["dist/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"@pluxel/cli#build": {
			// CLI declarations reference the toolchain, while runtime integrations stay external and
			// are loaded only when their commands execute.
			"dependsOn": ["@pluxel/rolldown#build"],
			"outputs": ["dist/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"@pluxel/components#build": {
			"dependsOn": ["@pluxel/runtime#build", "@pluxel/runtime-dynamic#build", "valibot-form#build"],
			"outputs": ["dist/**", "public/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"build:lib": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"],
			"outputLogs": "new-only",
		},
		"build:web": {
			"dependsOn": [],
			"outputs": ["public/**"],
			"outputLogs": "new-only",
		},
		"build:plugin": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "public/**"],
			"outputLogs": "new-only",
		},
		"test": {
			// Vitest resolves workspace packages from source. Only its shared config package needs a
			// built entry; tests that inspect production artifacts declare that dependency below.
			"dependsOn": ["@pluxel/test#build"],
			"outputs": [],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/oxlint.config.ts",
				"$TURBO_ROOT$/tsconfig*.json",
				"$TURBO_ROOT$/vitest.config.ts",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
			],
			"outputLogs": "errors-only",
		},
		"@pluxel/rolldown#test": {
			// Packaging invariants intentionally inspect the runtime-static production declarations.
			"dependsOn": ["@pluxel/test#build", "@pluxel/runtime-static#build"],
			"outputs": [],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/oxlint.config.ts",
				"$TURBO_ROOT$/tsconfig*.json",
				"$TURBO_ROOT$/vitest.config.ts",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
			],
			"outputLogs": "errors-only",
		},
		"typecheck": {
			// Product projects intentionally validate the published runtime declaration boundary.
			// Their Vite configs import runtime-static source, whose compiler bridge consumes
			// runtime-dev declarations before Vite resolve conditions are active.
			"dependsOn": ["@pluxel/runtime#build", "@pluxel/runtime-dev#build"],
			"outputs": [],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/tsconfig*.json",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
			],
			"outputLogs": "errors-only",
		},
		"@pluxel/plugins-authelia-oidc-demo#typecheck": {
			"dependsOn": ["@pluxel/runtime-static#build"],
		},
		"@repo/project-chatbots#typecheck": {
			"dependsOn": ["@pluxel/runtime-static#build"],
		},
		"@repo/project-external-api-gateway#typecheck": {
			"dependsOn": ["@pluxel/runtime-static#build"],
		},
		"@pluxel/plugins-host#typecheck": {
			// The maintainer host is the explicit dist-boundary smoke check.
			"dependsOn": [
				"@pluxel/cli#build",
				"@pluxel/runtime-dynamic#build",
				"@pluxel/runtime-static#build",
			],
			"outputs": [],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig*.json"],
			"outputLogs": "errors-only",
		},
		"dev": {
			"cache": false,
			"persistent": true,
		},
	},
}
