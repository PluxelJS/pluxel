{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": [
		"package.json",
		"pnpm-lock.yaml",
		"oxlint.config.ts",
		// Many packages extend root TS configs; changing them must invalidate caches.
		"tsconfig*.json",
		// Workspace-level Vitest entry (used by `pnpm exec vitest` at repo root).
		"vitest.config.ts",
		"pnpm-workspace.yaml",
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "public/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"@pluxel/test#build": {
			// `@pluxel/test` is a dev-only helper package. It compiles against the
			// source-export surface of core/runtime and must not pull those build
			// tasks into Turbo's topological graph, otherwise internal packages that
			// use `@pluxel/test` in devDependencies create a false build cycle.
			// Its bundled rolldown helpers do need built dist artifacts.
			"dependsOn": ["@pluxel/rolldown#build"],
			"outputs": ["dist/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"@pluxel/core-di#build": {
			"dependsOn": [],
			"outputs": ["dist/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"@pluxel/ops#build": {
			"dependsOn": [],
			"outputs": ["dist/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"@pluxel/runtime#build": {
			"dependsOn": [
				"@pluxel/core#build",
				"@pluxel/ops#build",
				"@pluxel/rolldown#build",
				"valibot-form#build",
			],
			"outputs": ["dist/**", "public/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"@pluxel/runtime-dynamic#build": {
			"dependsOn": [
				"@pluxel/rolldown#build",
				"@pluxel/core#build",
				"@pluxel/runtime#build",
				"@pluxel/runtime-dev#build",
			],
			"outputs": ["dist/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"@pluxel/runtime-static#build": {
			"dependsOn": ["@pluxel/core#build", "@pluxel/runtime#build", "@pluxel/runtime-dev#build"],
			"outputs": ["dist/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"@pluxel/cli#build": {
			"dependsOn": ["@pluxel/rolldown#build", "@pluxel/runtime#build"],
			"outputs": ["dist/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"@pluxel/components#build": {
			"dependsOn": ["@pluxel/runtime#build", "@pluxel/runtime-dynamic#build", "valibot-form#build"],
			"outputs": ["dist/**", "public/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"build:lib": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"],
			"outputLogs": "new-only",
		},
		"build:web": {
			"dependsOn": [],
			"outputs": ["public/**"],
			"outputLogs": "new-only",
		},
		"build:plugin": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "public/**"],
			"outputLogs": "new-only",
		},
		"test": {
			"dependsOn": ["^build", "build", "@pluxel/test#build"],
			"outputs": [],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
			],
			"outputLogs": "errors-only",
		},
		"dev": {
			"cache": false,
			"persistent": true,
		},
	},
}
