{
	"$schema": "https://turbo.build/schema.json",
	// Build/test packages are independent once their declared artifact prerequisites are ready.
	// Use every logical processor; callers can still lower this with `--concurrency` when needed.
	"concurrency": "100%",
	// Keep a useful local history without allowing build artifacts to grow without bounds.
	"cacheMaxAge": "30d",
	"cacheMaxSize": "5GB",
	// Test fixtures start file watchers; let constrained hosts opt into polling for every task.
	"globalPassThroughEnv": ["CHOKIDAR_USEPOLLING"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "public/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/tsconfig*.json",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"@pluxel/core#build": {
			// Core bundles Context; test-only tooling does not participate in its artifact build.
			"dependsOn": ["@pluxel/context#build"],
			"outputs": ["dist/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/tsconfig*.json",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"valibot-form#build": {
			// The form library only consumes external production dependencies.
			"dependsOn": [],
			"outputs": ["dist/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/tsconfig*.json",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"@pluxel/rolldown#build": {
			// Build production dependencies before tooling; its test helper depends on this artifact.
			"dependsOn": ["@pluxel/core#build", "valibot-form#build"],
			"outputs": ["dist/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/tsconfig*.json",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"@pluxel/test#build": {
			// `@pluxel/test` is a dev-only helper package. It compiles against the
			// source-export surface of core/runtime and must not pull those build
			// tasks into Turbo's topological graph, otherwise internal packages that
			// use `@pluxel/test` in devDependencies create a false build cycle.
			// Its bundled rolldown helpers do need built dist artifacts.
			"dependsOn": ["@pluxel/rolldown#build"],
			"outputs": ["dist/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"@pluxel/runtime#build": {
			"dependsOn": [
				"@pluxel/commands#build",
				"@pluxel/core#build",
				"@pluxel/rolldown#build",
				"valibot-form#build",
			],
			"outputs": ["dist/**", "public/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				// The runtime Web build compiles the private Workbench shell directly.
				"$TURBO_ROOT$/packages/workbench-app/src/**",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"@pluxel/runtime-dynamic#build": {
			"dependsOn": [
				"@pluxel/rolldown#build",
				"@pluxel/core#build",
				"@pluxel/runtime#build",
				"@pluxel/runtime-dev#build",
			],
			"outputs": ["dist/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"@pluxel/runtime-dev#build": {
			// Test helpers are development-only consumers; production compiler entries only need
			// core, runtime and rolldown artifacts.
			"dependsOn": ["@pluxel/core#build", "@pluxel/rolldown#build", "@pluxel/runtime#build"],
			"outputs": ["dist/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"@pluxel/runtime-static#build": {
			"dependsOn": ["@pluxel/core#build", "@pluxel/runtime#build", "@pluxel/runtime-dev#build"],
			"outputs": ["dist/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"@pluxel/cli#build": {
			// CLI declarations reference the toolchain, while runtime integrations stay external and
			// are loaded only when their commands execute. Bundled Plugin templates are package-local
			// inputs; versioned user docs belong only to @pluxel/create.
			"dependsOn": ["@pluxel/rolldown#build"],
			"outputs": ["dist/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"@pluxel/cli#typecheck": {
			// The CLI loads toolchain capabilities through package exports. Typecheck the same dist
			// boundary used in production after the capability owners have emitted declarations.
			"dependsOn": ["^build"],
			"outputs": [],
		},
		"@pluxel/create#build": {
			// The published initializer copies the package-local fixed starter and the repository user
			// docs. Both asset trees must invalidate its tsdown output cache.
			"dependsOn": [],
			"outputs": ["dist/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/docs/**",
				"!README.md",
				"!IMPLEMENTATION_INDEX.md",
				"!scripts/**",
				"!tests/**",
			],
			"outputLogs": "new-only",
		},
		"@pluxel/workbench-app#build": {
			"dependsOn": [
				"@pluxel/runtime#build",
				"@pluxel/runtime-dynamic#build",
				"@worksplit/react#build",
				"valibot-form#build",
			],
			"outputs": ["dist/**", "public/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"pluxel-docs#build": {
			// The docs preview imports the published `valibot-form/web` entry. On a clean runner that
			// export points at dist, so the docs build must not race the package build.
			"dependsOn": ["valibot-form#build"],
			"outputs": ["dist/**", ".source/**", ".vercel/output/**"],
			"env": ["VERCEL*"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/**"],
			"outputLogs": "new-only",
		},
		"build:lib": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"],
			"outputLogs": "new-only",
		},
		"build:web": {
			"dependsOn": [],
			"outputs": ["public/**"],
			"outputLogs": "new-only",
		},
		"build:plugin": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "public/**"],
			"outputLogs": "new-only",
		},
		"test": {
			// Vite evaluates vitest.config before the preset can install workspace source conditions,
			// so bootstrap the shared preset through its built package export. Do not replace this with
			// relative source imports or a process-wide condition: test-module resolution below the
			// config still uses @pluxel/source/@pluxel/hmr. Workspace dependency builds also carry
			// source-consumer cache hashes, so upstream changes invalidate dependent tests.
			"dependsOn": ["^build", "@pluxel/test#build"],
			"outputs": [],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/oxlint.config.ts",
				"$TURBO_ROOT$/tsconfig*.json",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
			],
			"outputLogs": "errors-only",
		},
		"@pluxel/redis#test": {
			// Pass the CI service URL through strict env filtering and keep integration results
			// separate from local runs where the Redis suite is skipped.
			"dependsOn": ["^build"],
			"outputs": [],
			"env": ["PLUXEL_REDIS_TEST_URL"],
		},
		"@pluxel/cli#test": {
			// Launcher tests execute bin/pluxel.mjs, which loads the built CLI entry.
			"dependsOn": ["^build", "build"],
		},
		"@pluxel/create#test": {
			// Standalone tests build their own launcher; serialize against Turbo's clean build.
			"dependsOn": ["^build", "build", "@pluxel/test#build"],
		},
		"@pluxel/runtime#test": {
			// Runtime compiler/worker fixtures cross the package export boundary. Keep declarations
			// stable instead of testing while the runtime build cleans and replaces dist.
			"dependsOn": ["^build", "@pluxel/runtime#build"],
		},
		"@pluxel/runtime-dynamic#test": {
			// Real distribution-mode config reloads and the fixed-plugin identity smoke test resolve
			// package exports outside Vitest's source condition. Their own dist must not race a clean
			// runtime-dynamic build, and the child process also consumes the runtime distribution.
			"dependsOn": ["^build", "@pluxel/runtime-dynamic#build"],
		},
		"@pluxel/runtime-static#test": {
			// Static host integration exercises Node-facing runtime package exports, and its real
			// package-root lowering smoke imports this package's built Vite entry in a child process.
			// Serialize the test after its own build so a concurrent clean cannot invalidate chunks.
			"dependsOn": ["^build", "build"],
		},
		"@pluxel/rolldown#test": {
			// Packaging invariants intentionally inspect the runtime-static production declarations.
			"dependsOn": ["^build", "@pluxel/runtime-static#build"],
			"outputs": [],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/oxlint.config.ts",
				"$TURBO_ROOT$/tsconfig*.json",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
			],
			"outputLogs": "errors-only",
		},
		"@worksplit/react#test": {
			"dependsOn": ["^build", "@pluxel/test#build", "@pluxel/runtime#build"],
		},
		"typecheck": {
			// Plugin projects and the test helpers validate the published runtime declaration boundary.
			// Workspace dependency builds propagate source and declaration changes into consumer hashes.
			// Extra edges below cover fixtures outside the declared package dependencies.
			"dependsOn": ["^build", "@pluxel/runtime#build"],
			"outputs": [],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/tsconfig*.json",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
			],
			"outputLogs": "errors-only",
		},
		"@worksplit/react#typecheck": {
			"dependsOn": ["^build", "@pluxel/runtime#build", "@pluxel/runtime-dev#build"],
		},
		"@pluxel/plugins-host#typecheck": {
			// The maintainer host is the explicit dist-boundary smoke check. Wait for every direct
			// workspace dependency so its typecheck cannot race a package build cleaning dist.
			"dependsOn": ["^build"],
			"outputs": [],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig*.json"],
			"outputLogs": "errors-only",
		},
		"dev": {
			"cache": false,
			"persistent": true,
		},
	},
}
