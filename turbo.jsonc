{
	"$schema": "https://turborepo.com/schema.json",
	"globalDependencies": [
		// Many packages extend root TS configs; changing them must invalidate caches.
		"tsconfig*.json",
		// Workspace-level Vitest entry (used by `pnpm exec vitest` at repo root).
		"vitest.config.ts",
		"pnpm-workspace.yaml"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "public/**"]
		},
		"build:plugin": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "public/**"]
		},
		"test": {
			"dependsOn": ["build"],
			"outputs": []
		},
		"web": {
			"outputs": ["public/**"],
			"dependsOn": []
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
