{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": [
		"package.json",
		"pnpm-lock.yaml",
		"oxlint.config.ts",
		// Many packages extend root TS configs; changing them must invalidate caches.
		"tsconfig*.json",
		// Workspace-level Vitest entry (used by `pnpm exec vitest` at repo root).
		"vitest.config.ts",
		"pnpm-workspace.yaml",
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "public/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"@pluxel/build#build": {
			// Most internal packages resolve workspace sources through `@pluxel/source`
			// or explicit source aliases. They need dependency source changes hashed,
			// but they do not need upstream dist artifacts built first.
			"dependsOn": [],
			"outputs": ["dist/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"@pluxel/test#build": {
			// `@pluxel/test` is a dev-only helper package. It compiles against the
			// source-export surface of core/runtime and must not pull their build
			// tasks into Turbo's topological graph, otherwise internal packages that
			// use `@pluxel/test` in devDependencies create a false build cycle.
			"dependsOn": [],
			"outputs": ["dist/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"@pluxel/core#build": {
			"dependsOn": ["@pluxel/build#build", "@pluxel/context#build", "@pluxel/core-di#build"],
			"outputs": ["dist/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"@pluxel/core-di#build": {
			"dependsOn": [],
			"outputs": ["dist/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"@pluxel/ops#build": {
			"dependsOn": [],
			"outputs": ["dist/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"@pluxel/runtime#build": {
			"dependsOn": ["@pluxel/core#build", "@pluxel/ops#build", "@pluxel/workspace#build", "valibot-form#build"],
			"outputs": ["dist/**", "public/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"@pluxel/hmr#build": {
			"dependsOn": ["@pluxel/build#build", "@pluxel/core#build", "@pluxel/runtime#build", "@pluxel/workspace#build"],
			"outputs": ["dist/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"@pluxel/cli#build": {
			"dependsOn": ["@pluxel/build#build", "@pluxel/hmr#build", "@pluxel/runtime#build", "@pluxel/workspace#build"],
			"outputs": ["dist/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"@pluxel/components#build": {
			"dependsOn": ["@pluxel/runtime#build", "valibot-form#build"],
			"outputs": ["dist/**", "public/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
				"!test/**",
				"!tests/**",
				"!**/test/**",
				"!**/tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
			],
			"outputLogs": "new-only",
		},
		"build:lib": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"],
			"outputLogs": "new-only",
		},
		"build:web": {
			"dependsOn": [],
			"outputs": ["public/**"],
			"outputLogs": "new-only",
		},
		"build:plugin": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "public/**"],
			"outputLogs": "new-only",
		},
		"test": {
			"dependsOn": ["build"],
			"outputs": [],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/*.md",
				"!docs/**",
				"!**/docs/**",
				"!bench/**",
				"!**/bench/**",
			],
			"outputLogs": "errors-only",
		},
		"web": {
			"outputs": ["public/**"],
			"dependsOn": [],
			"outputLogs": "new-only",
		},
		"dev": {
			"cache": false,
			"persistent": true,
		},
	},
}
