{
	"name": "@pluxel-internal/plugin-market",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vp run compile",
		"build:web": "vp run compile-web",
		"test": "vp run check-tests",
		"typecheck": "vp run check-types",
		"dev": "vp run serve-local",
		"dev:sandbox": "vp run serve-sandbox",
		"dev:registry": "pnpr -c dev/pnpr.yaml --listen 127.0.0.1:$PORT --public-url http://127.0.0.1:$PORT",
		"sandbox:prepare": "vp run prepare-sandbox",
		"sandbox:verify": "vp run verify-sandbox",
		"sandbox:admin": "node examples/admin.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply plugin-market --local"
	},
	"dependencies": {
		"capnweb": "catalog:dev",
		"drizzle-orm": "catalog:backend",
		"modern-tar": "catalog:prod",
		"semver": "catalog:dev",
		"validate-npm-package-name": "catalog:prod"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "catalog:dev",
		"@pluxel/plugin-package-manager": "workspace:*",
		"@pnpm/pnpr": "catalog:dev",
		"@types/jsdom": "catalog:types",
		"@types/node": "catalog:types",
		"@types/react": "catalog:types",
		"@types/react-dom": "catalog:types",
		"@types/semver": "catalog:types",
		"@types/validate-npm-package-name": "catalog:types",
		"drizzle-kit": "catalog:backend",
		"esbuild": "catalog:build",
		"jsdom": "catalog:dev",
		"miniflare": "catalog:dev",
		"react": "catalog:frontend",
		"react-dom": "catalog:frontend",
		"typescript": "catalog:tooling",
		"vite-plus": "catalog:build",
		"vitest": "catalog:test",
		"wrangler": "catalog:dev"
	}
}
