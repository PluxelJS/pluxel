{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pluxel-plugin-market",
	"main": "src/worker.ts",
	"compatibility_date": "2026-11-03",
	"workers_dev": false,
	"assets": {
		"directory": "./dist/web",
		"not_found_handling": "none",
		"run_worker_first": ["/v1", "/v1/*", "/admin", "/admin/*"],
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "plugin-market",
			"database_id": "00000000-0000-0000-0000-000000000001",
			"migrations_dir": "migrations",
		},
	],
	"triggers": { "crons": ["*/5 * * * *"] },
}
