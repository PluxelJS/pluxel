+
+/// Cancel remaining timers while the owning executor is still running.
+pub fn cancel_runtime_timers(ctx: &Ctx<'_>) {
+    let rt = unsafe { qjs::JS_GetRuntime(ctx.as_raw().as_ptr()) };
+    let mut states = RT_TIMER_STATE.lock().unwrap();
+    if let Some(state) = states.iter_mut().find(|state| state.rt == rt) {
+        state.timers.clear();
+        state.notify.notify_one();
+    }
+}
+
+/// Release the process registry slot after timer futures have drained.
+pub fn dispose_runtime_timers(ctx: &Ctx<'_>) {
+    let rt = unsafe { qjs::JS_GetRuntime(ctx.as_raw().as_ptr()) };
+    RT_TIMER_STATE.lock().unwrap().retain(|state| state.rt != rt);
+}
+
+pub fn runtime_timer_state_count() -> usize {
+    RT_TIMER_STATE.lock().unwrap().len()
+}
