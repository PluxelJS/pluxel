{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"experimentalDecorators": true,
		"skipLibCheck": true,
		"customConditions": ["@pluxel/source"],
		"lib": ["ESNext", "DOM"],
		"types": ["node"],
		"allowImportingTsExtensions": true
	},
	"include": ["src", "sdk/src", "tests", "vitest.config.ts", "dev"],
	"extends": "../../tsconfig.json"
}
