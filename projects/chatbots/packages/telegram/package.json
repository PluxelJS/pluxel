{
	"name": "@repo/chatbots-telegram",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./api": {
			"types": "./src/api/index.ts",
			"default": "./src/api/index.ts"
		}
	},
	"scripts": {
		"api:generate": "node --experimental-strip-types scripts/generate-api.ts",
		"api:check": "node --experimental-strip-types scripts/generate-api.ts --check",
		"typecheck": "pnpm api:check && tsc --noEmit --pretty false",
		"test": "vitest run --passWithNoTests"
	},
	"dependencies": {
		"@gramio/types": "^10.1.0",
		"@repo/chatbots-adapter-kit": "workspace:*"
	},
	"devDependencies": {
		"@types/react": "^19.2.14",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"@mantine/core": "^9.4.1",
		"@pluxel/runtime": "workspace:*",
		"@tabler/icons-react": "^3.37.1",
		"react": "^19.2.7"
	},
	"peerDependenciesMeta": {
		"@mantine/core": {
			"optional": true
		},
		"@tabler/icons-react": {
			"optional": true
		},
		"react": {
			"optional": true
		}
	}
}
