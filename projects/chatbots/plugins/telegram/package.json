{
	"name": "@repo/chatbots-telegram",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./api": {
			"types": "./src/api/index.ts",
			"default": "./src/api/index.ts"
		}
	},
	"scripts": {
		"api:generate": "node --experimental-strip-types scripts/generate-api.ts",
		"api:check": "node --experimental-strip-types scripts/generate-api.ts --check",
		"typecheck": "pnpm api:check && tsc --noEmit --pretty false"
	},
	"dependencies": {
		"@gramio/types": "^10.1.0",
		"@repo/chatbots-adapter-kit": "workspace:*"
	},
	"devDependencies": {
		"@types/react": "catalog:",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"@mantine/core": "catalog:",
		"@pluxel/runtime": "workspace:*",
		"@tabler/icons-react": "catalog:",
		"react": "catalog:"
	},
	"peerDependenciesMeta": {
		"@mantine/core": {
			"optional": true
		},
		"@tabler/icons-react": {
			"optional": true
		},
		"react": {
			"optional": true
		}
	}
}
