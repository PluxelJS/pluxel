{
	"name": "pluxel-docs",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"scripts": {
		"generate:playground-types": "node scripts/generate-playground-types.mjs",
		"predev": "pnpm generate:playground-types",
		"dev": "cross-env DEBUG= DOCS_TWOSLASH_MODE=development NODE_OPTIONS=--import=./scripts/register-typescript-legacy.mjs fumapress dev",
