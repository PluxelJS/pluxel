		"build": "cross-env DEBUG= DOCS_TWOSLASH_MODE=production NODE_OPTIONS=--import=./scripts/register-typescript-legacy.mjs fumapress build",
		"start": "fumapress start",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --tsconfig tsconfig.json --type-aware -A typescript/no-implied-eval src press.config.tsx source.config.ts vite.config.ts scripts"
	},
