{
	"name": "@repo/external-api-gateway-shared",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./constants": {
			"types": "./src/constants.ts",
			"default": "./src/constants.ts"
		},
		"./db": {
			"types": "./src/db/use-db.ts",
			"default": "./src/db/use-db.ts"
		},
		"./gateway": {
			"types": "./src/gateway/contracts.ts",
			"default": "./src/gateway/contracts.ts"
		},
		"./usage": {
			"types": "./src/usage/contracts.ts",
			"default": "./src/usage/contracts.ts"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"test": "vitest run --config vitest.config.ts",
		"typecheck": "tsc --noEmit --pretty false"
	},
	"dependencies": {
		"@libsql/client": "^0.17.4",
		"@pluxel/runtime": "workspace:*",
		"drizzle-orm": "^0.45.2"
	},
	"devDependencies": {
		"vitest": "^4.1.10"
	}
}
