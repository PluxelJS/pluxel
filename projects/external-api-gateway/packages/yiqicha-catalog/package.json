{
	"name": "@repo/external-api-gateway-yiqicha-catalog",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"development": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./data/apis.json": "./data/apis.json",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./data/apis.json": "./data/apis.json",
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"build": "tsdown",
		"generate-types": "node scripts/generate-types.mjs",
		"scrape": "node scripts/scrape.mjs",
		"typecheck": "tsc --noEmit"
	},
	"engines": {
		"node": ">=24.12"
	}
}
