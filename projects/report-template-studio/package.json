{
	"name": "@report-template-studio/app",
	"private": true,
	"files": [
		"dist",
		"financial-document-assets",
		"package.json",
		"README.md",
		"examples",
		"workspace-assets"
	],
	"type": "module",
	"main": "dist/electron/main.mjs",
	"exports": {
		"./plugin": {
			"types": "./dist/plugin.d.mts",
			"@pluxel/hmr": "./src/backend/plugin.ts",
			"default": "./dist/plugin.mjs"
		},
		"./client": {
			"types": "./dist/client.d.mts",
			"default": "./dist/client.mjs"
		},
		"./contracts": {
			"types": "./dist/contracts.d.mts",
			"default": "./dist/contracts.mjs"
		},
		"./runtime": {
			"types": "./dist/runtime.d.mts",
			"default": "./dist/runtime.mjs"
		}
	},
	"scripts": {
		"prepare:worksplit": "node scripts/prepare-worksplit.mjs",
		"build": "tsdown && vite build",
		"start": "electron .",
		"dev": "node scripts/dev.mjs",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"package": "node scripts/package.mjs",
		"test:desktop": "node tests/desktop.mjs",
		"test:runtime": "node tests/runtime.mjs"
	},
	"dependencies": {
		"@assistant-ui/react": "catalog:frontend",
		"@assistant-ui/react-streamdown": "catalog:frontend",
		"@assistant-ui/styles": "catalog:frontend",
		"@dnd-kit/core": "catalog:frontend",
		"@dnd-kit/sortable": "catalog:frontend",
		"@dnd-kit/utilities": "catalog:frontend",
		"@mantine/core": "catalog:frontend",
		"@mantine/hooks": "catalog:frontend",
		"@mariozechner/pi-coding-agent": "catalog:prod",
		"@myriaddreamin/typst-ts-renderer": "catalog:prod",
		"@myriaddreamin/typst.ts": "catalog:prod",
		"@pluxel/core": "workspace:*",
		"@pluxel/fonts": "workspace:*",
		"@pluxel/host": "workspace:*",
		"@pluxel/services": "workspace:*",
		"@pluxel/typst": "workspace:*",
		"@streamdown/cjk": "catalog:frontend",
		"@streamdown/code": "catalog:frontend",
		"@tabler/icons-react": "catalog:icons",
		"@tanstack/react-form": "catalog:frontend",
		"@tanstack/react-hotkeys": "catalog:frontend",
		"@tanstack/react-router": "catalog:frontend",
		"@tanstack/react-store": "catalog:frontend",
		"@worksplit/core": "file:vendor/worksplit-core.tgz",
		"@worksplit/react": "file:vendor/worksplit-react.tgz",
		"capnweb": "catalog:prod",
		"fflate": "catalog:prod",
		"flexlayout-react": "catalog:frontend",
		"just-bash": "catalog:prod",
		"modern-monaco": "catalog:prod",
		"quickjs-emscripten": "catalog:prod",
		"react": "catalog:frontend",
		"react-dom": "catalog:frontend",
		"rolldown": "catalog:build",
		"streamdown": "catalog:frontend",
		"typebox": "catalog:dev",
		"valibot": "catalog:validation",
		"valibot-form": "workspace:*",
		"vite": "catalog:build",
		"yauzl": "catalog:prod"
	},
	"devDependencies": {
		"@electron/packager": "catalog:dev",
		"@pluxel/host-vite": "workspace:*",
		"@pluxel/rolldown": "workspace:*",
		"@pluxel/test": "workspace:*",
		"@pluxel/workbench": "workspace:*",
		"@types/node": "catalog:types",
		"@types/react": "catalog:types",
		"@types/react-dom": "catalog:types",
		"@types/yauzl": "catalog:types",
		"@vitejs/plugin-react": "catalog:build",
		"dts-bundle-generator": "catalog:dev",
		"electron": "catalog:dev",
		"playwright": "catalog:dev",
		"tm-grammars": "catalog:dev",
		"tm-themes": "catalog:dev",
		"tsdown": "catalog:build",
		"typescript": "catalog:dev",
		"typescript-legacy": "catalog:dev",
		"vitest": "catalog:test"
	}
}
