{
	"extends": "../../../../tsconfig.options.json",
	"compilerOptions": {
		// Demo-only typecheck:
		// - do NOT pull workspace source via `@pluxel/source` (use dist .d.ts)
		// - do NOT require composite/project-reference file lists
		"customConditions": [],
		"composite": false,
		"declaration": false,
		"declarationMap": false,
		"incremental": false,
		"noEmit": true,
		"experimentalDecorators": true,
		"jsx": "react-jsx",
		"lib": ["ES2023", "ESNext.Disposable", "DOM", "DOM.Iterable"]
	},
	"include": ["./**/*.ts", "./**/*.tsx"]
}
