{
	"name": "@pluxel/plugins-host",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "pnpm run static",
		"build": "pnpm run build:static",
		"start": "node dist/app.mjs",
		"dynamic": "pnpm exec vite --config vite.dynamic.config.ts",
		"static": "pnpm exec vite --config vite.static.config.ts",
		"build:static": "pnpm exec tsdown --config tsdown.static.config.ts",
		"test": "vitest run --config vitest.config.ts",
		"typecheck": "pnpm exec tsc -p src/tsconfig.json --pretty false",
		"dynamic:prompt": "pnpm exec pluxel hmr prompt --root ../.. --config projects/plugin-host/pluxel.loader.hmr.jsonc --profile plugins-host",
		"dynamic:doctor": "pnpm exec pluxel hmr doctor --root ../.. --config projects/plugin-host/pluxel.loader.hmr.jsonc --profile plugins-host"
	},
	"dependencies": {
		"@opentelemetry/api": "catalog:prod",
		"@opentelemetry/api-logs": "catalog:prod",
		"@pluxel/auth": "workspace:*",
		"@pluxel/cache": "workspace:*",
		"@pluxel/canvas": "workspace:*",
		"@pluxel/commands": "workspace:*",
		"@pluxel/echarts": "workspace:*",
		"@pluxel/fonts": "workspace:*",
		"@pluxel/otel": "workspace:*",
		"@pluxel/package-manager": "workspace:*",
		"@pluxel/rates": "workspace:*",
		"@pluxel/redis": "workspace:*",
		"@pluxel/runtime": "workspace:*",
		"@pluxel/runtime-dynamic": "workspace:*",
		"@pluxel/runtime-static": "workspace:*",
		"@pluxel/storage": "workspace:*",
		"@pluxel/takumi": "workspace:*",
		"@pluxel/wretch": "workspace:*"
	},
	"devDependencies": {
		"@mantine/core": "catalog:frontend",
		"@mantine/hooks": "catalog:frontend",
		"@pluxel/cli": "workspace:*",
		"@pluxel/rolldown": "workspace:*",
		"@pluxel/test": "workspace:*",
		"@tabler/icons-react": "catalog:icons",
		"@types/react": "catalog:types",
		"@types/react-dom": "catalog:types",
		"pathe": "catalog:node",
		"react": "catalog:frontend",
		"react-dom": "catalog:frontend",
		"tsdown": "catalog:build",
		"typescript": "catalog:dev",
		"vite": "catalog:build",
		"vitest": "catalog:test"
	}
}
