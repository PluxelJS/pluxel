{
	"name": "@pluxel/plugins-host",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node scripts/compile-report-card-css.mjs && vp run prepare-dev --concurrency-limit=1 && vp dev --config vite.config.ts",
		"build": "vp run compile",
		"start": "node start.mjs",
		"test": "vp run check-tests",
		"test:runtime": "vp test run --config vitest.runtime.config.ts",
		"test:workbench-browser": "node dev/workbench.browser.mjs",
		"typecheck": "vp run check-types",
		"start:vite": "NODE_ENV=production node start-vite.mjs",
		"styles:report-card": "node scripts/compile-report-card-css.mjs"
	},
	"dependencies": {
		"@heroui/react": "catalog:frontend",
		"@heroui/styles": "catalog:frontend",
		"@opentelemetry/api": "catalog:prod",
		"@opentelemetry/api-logs": "catalog:prod",
		"@pluxel/auth": "workspace:*",
		"@pluxel/cache": "workspace:*",
		"@pluxel/canvas": "workspace:*",
		"@pluxel/commands": "workspace:*",
		"@pluxel/core": "workspace:^",
		"@pluxel/echarts": "workspace:*",
		"@pluxel/fonts": "workspace:*",
		"@pluxel/host": "workspace:*",
		"@pluxel/host-vite": "workspace:*",
		"@pluxel/otel": "workspace:*",
		"@pluxel/package-manager": "workspace:*",
		"@pluxel/rates": "workspace:*",
		"@pluxel/redis": "workspace:*",
		"@pluxel/services": "workspace:*",
		"@pluxel/storage": "workspace:*",
		"@pluxel/takumi": "workspace:*",
		"@pluxel/takumi-markdown": "workspace:*",
		"@pluxel/typst": "workspace:*",
		"@pluxel/workbench": "workspace:*",
		"@pluxel/wretch": "workspace:*",
		"@sinclair/typebox": "catalog:prod",
		"capnweb": "catalog:prod",
		"elysia": "catalog:prod",
		"exact-mirror": "catalog:prod",
		"react": "catalog:frontend",
		"typebox": "catalog:dev",
		"valibot": "catalog:validation",
		"valibot-form": "workspace:^",
		"vite": "catalog:build"
	},
	"devDependencies": {
		"@mantine/core": "catalog:frontend",
		"@mantine/hooks": "catalog:frontend",
		"@pluxel/cli": "workspace:*",
		"@pluxel/rolldown": "workspace:*",
		"@pluxel/test": "workspace:*",
		"@tabler/icons-react": "catalog:icons",
		"@tailwindcss/node": "catalog:frontend",
		"@types/react": "catalog:types",
		"@types/react-dom": "catalog:types",
		"capnweb": "catalog:prod",
		"pathe": "catalog:node",
		"playwright": "catalog:dev",
		"react-dom": "catalog:frontend",
		"tailwindcss": "catalog:frontend",
		"typescript": "catalog:dev",
		"vite-plus": "catalog:build",
		"vitest": "catalog:test"
	},
	"peerDependencies": {
		"capnweb": "catalog:prod"
	}
}
