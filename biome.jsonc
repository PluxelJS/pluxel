{
	"$schema": "https://biomejs.dev/schemas/2.4.4/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": ["packages/**"]
	},
	"formatter": {
		// Formatter is enabled for local dev (`biome format` / `biome check --write`).
		// We don't enforce formatting repo-wide via `biome ci` to avoid churn from legacy files.
		"enabled": true,
		"indentStyle": "tab",
		"lineEnding": "lf",
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "asNeeded",
			"trailingCommas": "all"
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "off"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"correctness": {
				"useExhaustiveDependencies": "off",
				"useHookAtTopLevel": "off",
				"noUnusedFunctionParameters": "off",
				"noUnusedImports": "info",
				"noUnusedVariables": "info"
			},
			"complexity": {
				"useOptionalChain": "off",
				"useLiteralKeys": "off",
				"noUselessTernary": "off",
				"noCommaOperator": "off",
				"noBannedTypes": "off"
			},
			"suspicious": {
				// These two rules are intentionally off: the codebase commonly uses `??=` and similar
				// expressions for caching and lazy init, and Biome currently flags those heavily.
				"noAssignInExpressions": "off",
				"noConfusingVoidType": "off",
				"noControlCharactersInRegex": "error",
				"noConstEnum": "off",
				"useIterableCallbackReturn": "off",
				"noThenProperty": "error",
				"noEmptyInterface": "off",
				"noArrayIndexKey": "off",
				"noExplicitAny": "off"
			},
			"security": {
				// Allow only with explicit justification at the call site.
				"noDangerouslySetInnerHtml": "error"
			},
			"style": {
				"noDefaultExport": "off",
				"noNonNullAssertion": "off",
				"useImportType": "off",
				"useTemplate": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.mjs"]
		},
		{
			"includes": [
				"packages/**/__tests__/**/*.{js,jsx,ts,tsx}",
				"packages/**/tests/**/*.{js,jsx,ts,tsx}",
				"packages/**/*.{test,spec}.{js,jsx,ts,tsx}"
			],
			"linter": {
				"rules": {
					"suspicious": {
						// Tests commonly use thenables/mocks; keep production strict but avoid noise in tests.
						"noThenProperty": "off"
					}
				}
			}
		},
		{
			"includes": [
				"packages/**/__fixtures__/**/*",
				"packages/**/tests/fixtures/**/*",
				"packages/**/__tests__/fixtures/**/*"
			],
			"linter": { "enabled": false }
		},
		{
			"includes": [
				"packages/components/src/**/*.{ts,tsx}",
				"packages/valibot-form/src/web/**/*.{ts,tsx}"
			],
			"linter": {
				"rules": {
					"correctness": {
						"useHookAtTopLevel": "error"
					}
				}
			}
		}
	]
}
