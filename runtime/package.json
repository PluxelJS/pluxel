{
	"private": true,
	"name": "@pluxel/runtime",
	"type": "module",
	"version": "0.1.0",
	"description": "使用 HMR 管理插件的运行时，让 HMR Build 后以提升加载速度。",
	"main": "./src/index.ts",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"@pluxel/source": "./src/index.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"dev": "bun src/index.js",
		"new": "bunx pluxel new plugin",
		"feat": "bunx pluxel new plugin features"
	},
	"dependencies": {
		"@pluxel/cli": "link:../packages/cli",
		"@pluxel/core": "file:../packages/core",
		"@pluxel/hmr": "file:../packages/hmr"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.3",
		"@repobuddy/biome": "^2.0.1"
	}
}
