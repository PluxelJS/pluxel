{
	"name": "@pluxel/canvas",
	"version": "1.0.0",
	"description": "Official bounded server-side Canvas capability for Pluxel plugins",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/pluxel",
		"directory": "plugins/render/canvas"
	},
	"files": [
		"dist",
		"!**/*.map"
	],
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/hmr": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./pretext": {
			"@pluxel/hmr": "./src/pretext.ts",
			"default": "./dist/pretext.mjs"
		},
		"./table": {
			"@pluxel/hmr": "./src/table.ts",
			"default": "./dist/table.mjs"
		},
		"./worker": {
			"@pluxel/hmr": "./src/worker.ts",
			"default": "./dist/worker.mjs"
		},
		"./worker/pretext": {
			"@pluxel/hmr": "./src/worker-pretext.ts",
			"default": "./dist/worker/pretext.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./pretext": "./dist/pretext.mjs",
			"./table": "./dist/table.mjs",
			"./worker": "./dist/worker.mjs",
			"./worker/pretext": "./dist/worker/pretext.mjs",
			"./package.json": "./package.json"
		},
		"access": "public"
	},
	"scripts": {
		"bench:native-capacity": "node bench/native-capacity.mjs",
		"build": "pluxel build",
		"test": "vitest run --config vitest.config.ts",
		"typecheck": "tsc --noEmit --pretty false"
	},
	"dependencies": {
		"@chenglou/pretext": "catalog:prod",
		"@napi-rs/canvas": "catalog:prod"
	},
	"devDependencies": {
		"@pluxel/cli": "workspace:*",
		"@pluxel/fonts": "workspace:*",
		"@pluxel/rolldown": "workspace:*",
		"@pluxel/runtime": "workspace:*",
		"@pluxel/test": "workspace:*",
		"tsdown": "catalog:build",
		"typescript": "catalog:dev",
		"vitest": "catalog:test"
	},
	"peerDependencies": {
		"@pluxel/fonts": "workspace:^",
		"@pluxel/runtime": "workspace:^"
	},
	"engines": {
		"node": ">=24"
	},
	"pluxel": {
		"pluginPackages": {
			"@pluxel/fonts": "required"
		}
	}
}
