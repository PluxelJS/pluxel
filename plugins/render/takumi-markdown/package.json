{
	"name": "@pluxel/plugin-takumi-markdown",
	"version": "1.1.0",
	"description": "GFM Markdown and trusted document extensions for Takumi's native rendering API",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/pluxel",
		"directory": "plugins/render/takumi-markdown"
	},
	"files": [
		"dist",
		"!**/*.map"
	],
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/hmr": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./package.json": "./package.json"
		},
		"access": "public"
	},
	"scripts": {
		"build": "vp run compile",
		"test": "vp run check-tests",
		"typecheck": "vp run check-types"
	},
	"dependencies": {
		"rangi": "catalog:prod",
		"satteri": "catalog:prod",
		"valibot": "catalog:validation",
		"valibot-form": "workspace:^"
	},
	"devDependencies": {
		"@pluxel/cli": "workspace:*",
		"@pluxel/core": "workspace:*",
		"@pluxel/host": "workspace:*",
		"@pluxel/host-vite": "workspace:*",
		"@pluxel/plugin-fonts": "workspace:*",
		"@pluxel/plugin-takumi": "workspace:*",
		"@pluxel/plugin-typst": "workspace:*",
		"@pluxel/rolldown": "workspace:*",
		"@pluxel/services": "workspace:*",
		"@pluxel/test": "workspace:*",
		"@pluxel/workbench": "workspace:*",
		"tsx": "catalog:dev",
		"typescript": "catalog:dev",
		"vite": "catalog:build",
		"vite-plus": "catalog:build",
		"vitest": "catalog:test"
	},
	"peerDependencies": {
		"@pluxel/core": "workspace:^",
		"@pluxel/plugin-takumi": "workspace:^",
		"@pluxel/plugin-typst": "workspace:^"
	},
	"peerDependenciesMeta": {
		"@pluxel/plugin-typst": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=24"
	},
	"pluxel": {
		"pluginPackages": {
			"@pluxel/plugin-takumi": "required",
			"@pluxel/plugin-typst": "optional"
		},
		"artifactRoot": "dist",
		"nodeArtifacts": true,
		"workbenchArtifacts": true
	}
}
