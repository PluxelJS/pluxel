{
	"name": "@pluxel/echarts",
	"version": "1.0.0",
	"description": "Official server-side Apache ECharts capability for Pluxel plugins",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/pluxel",
		"directory": "plugins/render/echarts"
	},
	"files": [
		"dist",
		"!**/*.map"
	],
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/hmr": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./package.json": "./package.json"
		},
		"access": "public"
	},
	"scripts": {
		"bench:render": "vitest bench bench/render.bench.ts --config vitest.config.ts",
		"build": "pluxel build",
		"test": "vitest run --config vitest.config.ts",
		"typecheck": "tsc --noEmit --pretty false"
	},
	"dependencies": {
		"echarts": "catalog:prod",
		"valibot": "catalog:validation",
		"valibot-form": "workspace:^"
	},
	"devDependencies": {
		"@pluxel/canvas": "workspace:*",
		"@pluxel/cli": "workspace:*",
		"@pluxel/core": "workspace:*",
		"@pluxel/fonts": "workspace:*",
		"@pluxel/host-dev": "workspace:*",
		"@pluxel/rolldown": "workspace:*",
		"@pluxel/runtime": "workspace:*",
		"@pluxel/services": "workspace:*",
		"@pluxel/test": "workspace:*",
		"@pluxel/workbench": "workspace:*",
		"tsdown": "catalog:build",
		"tsx": "catalog:dev",
		"typescript": "catalog:dev",
		"vite": "catalog:build",
		"vitest": "catalog:test"
	},
	"peerDependencies": {
		"@pluxel/canvas": "workspace:^",
		"@pluxel/core": "workspace:^",
		"@pluxel/fonts": "workspace:^",
		"@pluxel/services": "workspace:^",
		"@pluxel/workbench": "workspace:^"
	},
	"engines": {
		"node": ">=24"
	},
	"pluxel": {
		"pluginPackages": {
			"@pluxel/canvas": "required",
			"@pluxel/fonts": "required"
		}
	}
}
