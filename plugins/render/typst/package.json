{
	"name": "@pluxel/plugin-typst",
	"private": true,
	"description": "Typst document sessions with isolated compilation and file resources",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/pluxel",
		"directory": "plugins/render/typst"
	},
	"files": [
		"dist",
		"native/compiler.node",
		"!**/*.map"
	],
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/hmr": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./browser": {
			"@pluxel/hmr": "./src/browser/preview.ts",
			"default": "./dist/browser.mjs"
		},
		"./template": {
			"@pluxel/hmr": "./src/template.ts",
			"default": "./dist/template.mjs"
		},
		"./tiptap": {
			"@pluxel/hmr": "./src/tiptap/index.ts",
			"default": "./dist/tiptap.mjs"
		},
		"./tiptap/react": {
			"@pluxel/hmr": "./src/tiptap/react.tsx",
			"default": "./dist/tiptap/react.mjs"
		},
		"./package.json": "./package.json",
		"./tiptap/style.css": {
			"@pluxel/hmr": "./src/tiptap/style.css",
			"default": "./dist/tiptap/style.css"
		}
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./browser": "./dist/browser.mjs",
			"./template": "./dist/template.mjs",
			"./tiptap": "./dist/tiptap.mjs",
			"./tiptap/react": "./dist/tiptap/react.mjs",
			"./package.json": "./package.json",
			"./tiptap/style.css": "./dist/tiptap/style.css"
		}
	},
	"scripts": {
		"prepare:native": "node native/build.mjs",
		"build": "vp run compile",
		"test": "vp run check-tests",
		"test:consumer": "node tests/consumer.mjs",
		"dev:consumer": "vp dev --config tests/consumer/vite.config.ts",
		"typecheck": "vp run check-types"
	},
	"dependencies": {
		"@myriaddreamin/typst-ts-node-compiler": "catalog:prod",
		"@myriaddreamin/typst.ts": "catalog:prod",
		"marked": "catalog:frontend",
		"valibot": "catalog:validation"
	},
	"devDependencies": {
		"@myriaddreamin/typst-ts-renderer": "catalog:prod",
		"@pluxel/cli": "workspace:*",
		"@pluxel/core": "workspace:*",
		"@pluxel/host": "workspace:*",
		"@pluxel/host-vite": "workspace:*",
		"@pluxel/plugin-fonts": "workspace:*",
		"@pluxel/rolldown": "workspace:*",
		"@pluxel/services": "workspace:*",
		"@pluxel/test": "workspace:*",
		"@pluxel/workbench": "workspace:*",
		"@tiptap/core": "catalog:frontend",
		"@tiptap/extension-image": "catalog:frontend",
		"@tiptap/extension-table": "catalog:frontend",
		"@tiptap/extension-text-style": "catalog:frontend",
		"@tiptap/markdown": "catalog:frontend",
		"@tiptap/pm": "catalog:frontend",
		"@tiptap/react": "catalog:frontend",
		"@tiptap/starter-kit": "catalog:frontend",
		"@types/react": "catalog:frontend",
		"@types/react-dom": "catalog:frontend",
		"playwright": "catalog:dev",
		"react": "catalog:frontend",
		"react-dom": "catalog:frontend",
		"tsx": "catalog:dev",
		"typescript": "catalog:dev",
		"vite": "catalog:build",
		"vite-plus": "catalog:build",
		"vitest": "catalog:test"
	},
	"peerDependencies": {
		"@pluxel/core": "workspace:^",
		"@pluxel/plugin-fonts": "workspace:^",
		"@pluxel/services": "workspace:^",
		"@tiptap/core": "catalog:frontend",
		"@tiptap/extension-image": "catalog:frontend",
		"@tiptap/extension-table": "catalog:frontend",
		"@tiptap/extension-text-style": "catalog:frontend",
		"@tiptap/markdown": "catalog:frontend",
		"@tiptap/pm": "catalog:frontend",
		"@tiptap/react": "catalog:frontend",
		"@tiptap/starter-kit": "catalog:frontend",
		"react": "catalog:frontend",
		"react-dom": "catalog:frontend"
	},
	"peerDependenciesMeta": {
		"@tiptap/extension-text-style": {
			"optional": true
		},
		"@tiptap/core": {
			"optional": true
		},
		"@tiptap/pm": {
			"optional": true
		},
		"@tiptap/starter-kit": {
			"optional": true
		},
		"@tiptap/extension-table": {
			"optional": true
		},
		"@tiptap/extension-image": {
			"optional": true
		},
		"@tiptap/markdown": {
			"optional": true
		},
		"@tiptap/react": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=24"
	},
	"pluxel": {
		"pluginPackages": {
			"@pluxel/plugin-fonts": "required"
		},
		"artifactRoot": "dist",
		"nodeArtifacts": true,
		"workbenchArtifacts": true
	}
}
