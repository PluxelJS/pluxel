{
	"name": "@pluxel/takumi",
	"version": "0.1.0",
	"description": "Official bounded Takumi HTML and node-tree rendering capability for Pluxel plugins",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/pluxel",
		"directory": "plugins/render/takumi"
	},
	"files": [
		"dist",
		"!**/*.map"
	],
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/hmr": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"build": "pluxel build",
		"test": "vitest run --config vitest.config.ts",
		"typecheck": "tsc --noEmit --pretty false"
	},
	"dependencies": {
		"takumi-js": "catalog:prod"
	},
	"devDependencies": {
		"@pluxel/cli": "workspace:*",
		"@pluxel/fonts": "workspace:*",
		"@pluxel/rolldown": "workspace:*",
		"@pluxel/runtime": "workspace:*",
		"@pluxel/test": "workspace:*",
		"@types/react": "catalog:types",
		"react": "catalog:frontend",
		"tsdown": "catalog:build",
		"typescript": "catalog:dev",
		"vitest": "catalog:test"
	},
	"peerDependencies": {
		"@pluxel/fonts": "workspace:^",
		"@pluxel/runtime": "workspace:^",
		"react": "catalog:frontend"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=24"
	},
	"pluxel": {
		"pluginPackages": {
			"@pluxel/fonts": "required"
		}
	}
}
