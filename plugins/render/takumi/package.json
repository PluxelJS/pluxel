{
	"name": "@pluxel/plugin-takumi",
	"version": "1.2.0",
	"description": "Native Takumi API and shared Worker rendering with reusable font and image resources",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/pluxel",
		"directory": "plugins/render/takumi"
	},
	"files": [
		"dist",
		"!**/*.map"
	],
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/hmr": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./worker": {
			"@pluxel/hmr": "./src/worker.ts",
			"default": "./dist/worker.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./worker": "./dist/worker.mjs",
			"./package.json": "./package.json"
		},
		"access": "public"
	},
	"scripts": {
		"bench:event-loop": "node bench/event-loop.mjs",
		"build": "vp run compile",
		"test": "vp run check-tests",
		"typecheck": "vp run check-types"
	},
	"dependencies": {
		"@takumi-rs/core": "catalog:prod",
		"@takumi-rs/helpers": "catalog:prod",
		"takumi-js": "catalog:prod"
	},
	"devDependencies": {
		"@pluxel/cli": "workspace:*",
		"@pluxel/core": "workspace:*",
		"@pluxel/rolldown": "workspace:*",
		"@pluxel/services": "workspace:*",
		"@pluxel/test": "workspace:*",
		"@types/react": "catalog:types",
		"react": "catalog:frontend",
		"typescript": "catalog:dev",
		"vite-plus": "catalog:build",
		"vitest": "catalog:test"
	},
	"peerDependencies": {
		"@pluxel/core": "workspace:^",
		"@pluxel/services": "workspace:^",
		"react": "catalog:frontend"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=24"
	},
	"pluxel": {
		"artifactRoot": "dist",
		"nodeArtifacts": true,
		"workbenchArtifacts": true
	}
}
