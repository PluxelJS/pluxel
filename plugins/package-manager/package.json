{
	"name": "@pluxel/package-manager",
	"version": "0.0.0",
	"private": true,
	"description": "Official pnpm-backed managed plugin package installer for Pluxel",
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/pluxel",
		"directory": "plugins/package-manager"
	},
	"files": [
		"dist",
		"!**/*.map"
	],
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/hmr": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./workbench": {
			"@pluxel/hmr": "./src/workbench-contract.ts",
			"default": "./dist/workbench.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./workbench": "./dist/workbench.mjs",
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"build": "pluxel build",
		"test": "vitest run --config vitest.config.ts",
		"typecheck": "tsc --noEmit --pretty false"
	},
	"dependencies": {
		"@pnpm/napi": "catalog:"
	},
	"devDependencies": {
		"@mantine/core": "catalog:",
		"@pluxel/cli": "workspace:*",
		"@pluxel/commands": "workspace:*",
		"@pluxel/rolldown": "workspace:*",
		"@pluxel/runtime": "workspace:*",
		"@pluxel/test": "workspace:*",
		"@tabler/icons-react": "catalog:",
		"@types/react": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vite": "^8.0.0-beta.18",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@mantine/core": "catalog:",
		"@pluxel/commands": "workspace:*",
		"@pluxel/runtime": "workspace:*",
		"@tabler/icons-react": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:"
	},
	"peerDependenciesMeta": {
		"@mantine/core": {
			"optional": true
		},
		"@tabler/icons-react": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		}
	}
}
