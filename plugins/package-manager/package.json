{
	"name": "@pluxel/package-manager",
	"version": "0.0.0",
	"private": true,
	"description": "Official pnpm-backed managed plugin package installer for Pluxel",
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/pluxel",
		"directory": "plugins/package-manager"
	},
	"files": [
		"dist",
		"!**/*.map"
	],
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/hmr": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./workbench": {
			"@pluxel/hmr": "./src/workbench.ts",
			"default": "./dist/workbench.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./workbench": "./dist/workbench.mjs",
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"build": "pluxel build",
		"test": "vitest run --config vitest.config.ts",
		"typecheck": "tsc --noEmit --pretty false"
	},
	"dependencies": {
		"@pnpm/napi": "catalog:prod"
	},
	"devDependencies": {
		"@mantine/core": "catalog:frontend",
		"@pluxel/cli": "workspace:*",
		"@pluxel/commands": "workspace:*",
		"@pluxel/core": "workspace:*",
		"@pluxel/rolldown": "workspace:*",
		"@pluxel/runtime": "workspace:*",
		"@pluxel/runtime-dynamic": "workspace:*",
		"@pluxel/test": "workspace:*",
		"@tabler/icons-react": "catalog:icons",
		"@types/react": "catalog:types",
		"@types/react-dom": "catalog:types",
		"react": "catalog:frontend",
		"react-dom": "catalog:frontend",
		"tsdown": "catalog:build",
		"typescript": "catalog:dev",
		"vite": "catalog:build",
		"vitest": "catalog:test"
	},
	"peerDependencies": {
		"@mantine/core": "catalog:frontend",
		"@pluxel/commands": "workspace:^",
		"@pluxel/runtime": "workspace:^",
		"@pluxel/runtime-dynamic": "workspace:^",
		"@tabler/icons-react": "catalog:icons",
		"react": "catalog:frontend",
		"react-dom": "catalog:frontend"
	},
	"peerDependenciesMeta": {
		"@mantine/core": {
			"optional": true
		},
		"@tabler/icons-react": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		}
	}
}
