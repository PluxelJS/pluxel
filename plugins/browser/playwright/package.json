{
	"name": "@pluxel/plugin-playwright",
	"version": "0.1.0",
	"description": "Official external CDP and Playwright browser connector for Pluxel plugins",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/pluxel",
		"directory": "plugins/browser/playwright"
	},
	"files": [
		"dist",
		"!**/*.map"
	],
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/hmr": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json",
		"./control": {
			"types": "./dist/control/index.d.mts",
			"import": "./dist/control/index.mjs",
			"default": "./dist/control/index.mjs"
		}
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./package.json": "./package.json",
			"./control": {
				"types": "./dist/control/index.d.mts",
				"import": "./dist/control/index.mjs",
				"default": "./dist/control/index.mjs"
			}
		},
		"access": "public"
	},
	"scripts": {
		"build": "vp run compile",
		"test": "vp run check-tests",
		"test:external": "vp test run --config vitest.external.config.ts",
		"test:native": "vp test run --config vitest.native.config.ts",
		"typecheck": "vp run check-types"
	},
	"dependencies": {
		"playwright-core": "catalog:prod",
		"valibot": "catalog:validation"
	},
	"devDependencies": {
		"@pluxel/cli": "workspace:*",
		"@pluxel/core": "workspace:*",
		"@pluxel/host": "workspace:*",
		"@pluxel/rolldown": "workspace:*",
		"@pluxel/services": "workspace:*",
		"@pluxel/test": "workspace:*",
		"typescript": "catalog:dev",
		"vite-plus": "catalog:build",
		"vitest": "catalog:test"
	},
	"peerDependencies": {
		"@pluxel/core": "workspace:^",
		"@pluxel/services": "workspace:^"
	},
	"engines": {
		"node": ">=24"
	},
	"pluxel": {
		"artifactRoot": "dist",
		"nodeArtifacts": true,
		"workbenchArtifacts": true,
		"control": "./dist/control/manifest.json"
	}
}
