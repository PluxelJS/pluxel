{
	"name": "@pluxel/plugin-invoice",
	"version": "0.1.0",
	"description": "VLM-assisted fiscal ticket and digital tax invoice extraction and browser verification",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/pluxel",
		"directory": "plugins/browser/invoice"
	},
	"files": [
		"dist",
		"!**/*.map"
	],
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/hmr": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./package.json": "./package.json"
		},
		"access": "public"
	},
	"scripts": {
		"build": "vp run compile",
		"test": "vp run check-tests",
		"typecheck": "vp run check-types",
		"test:browser": "vp test run --config vitest.browser.config.ts",
		"test:live": "vp test run --config vitest.live.config.ts"
	},
	"dependencies": {
		"playwright-core": "catalog:prod",
		"valibot": "catalog:validation"
	},
	"devDependencies": {
		"@pluxel/cli": "workspace:*",
		"@pluxel/core": "workspace:*",
		"@pluxel/host": "workspace:*",
		"@pluxel/plugin-playwright": "workspace:*",
		"@pluxel/services": "workspace:*",
		"@pluxel/test": "workspace:*",
		"@types/jsdom": "catalog:types",
		"jsdom": "catalog:dev",
		"typescript": "catalog:dev",
		"vite-plus": "catalog:build",
		"vitest": "catalog:test"
	},
	"peerDependencies": {
		"@pluxel/core": "workspace:^",
		"@pluxel/plugin-playwright": "workspace:^",
		"@pluxel/services": "workspace:^"
	},
	"pluxel": {
		"artifactRoot": "dist",
		"nodeArtifacts": true,
		"workbenchArtifacts": true,
		"pluginPackages": {
			"@pluxel/plugin-playwright": "required"
		}
	}
}
