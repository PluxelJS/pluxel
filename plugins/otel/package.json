{
	"name": "@pluxel/otel",
	"version": "0.0.0",
	"private": true,
	"description": "Official OpenTelemetry metrics, traces, and logs runtime for Pluxel plugins",
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/pluxel",
		"directory": "plugins/otel"
	},
	"files": [
		"dist",
		"!**/*.map"
	],
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/hmr": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"build": "pluxel build",
		"test": "vitest run --config vitest.config.ts && node --test tests-node/*.test.ts",
		"typecheck": "tsc --noEmit --pretty false"
	},
	"dependencies": {
		"@grpc/grpc-js": "catalog:",
		"@opentelemetry/context-async-hooks": "catalog:",
		"@opentelemetry/core": "catalog:",
		"@opentelemetry/exporter-logs-otlp-grpc": "catalog:",
		"@opentelemetry/exporter-logs-otlp-http": "catalog:",
		"@opentelemetry/exporter-logs-otlp-proto": "catalog:",
		"@opentelemetry/exporter-metrics-otlp-grpc": "catalog:",
		"@opentelemetry/exporter-metrics-otlp-http": "catalog:",
		"@opentelemetry/exporter-metrics-otlp-proto": "catalog:",
		"@opentelemetry/exporter-prometheus": "catalog:",
		"@opentelemetry/exporter-trace-otlp-grpc": "catalog:",
		"@opentelemetry/exporter-trace-otlp-http": "catalog:",
		"@opentelemetry/exporter-trace-otlp-proto": "catalog:",
		"@opentelemetry/resources": "catalog:",
		"@opentelemetry/sdk-logs": "catalog:",
		"@opentelemetry/sdk-metrics": "catalog:",
		"@opentelemetry/sdk-trace-base": "catalog:"
	},
	"devDependencies": {
		"@opentelemetry/api": "catalog:",
		"@opentelemetry/api-logs": "catalog:",
		"@pluxel/cli": "workspace:*",
		"@pluxel/rolldown": "workspace:*",
		"@pluxel/runtime": "workspace:*",
		"@pluxel/test": "workspace:*",
		"@types/node": "^25.9.3",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@opentelemetry/api": "catalog:",
		"@opentelemetry/api-logs": "catalog:",
		"@pluxel/runtime": "workspace:^"
	}
}
