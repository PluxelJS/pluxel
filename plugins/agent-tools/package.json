{
	"name": "@pluxel/agent-tools",
	"version": "1.0.0",
	"description": "Official command toolset and Agent assignment plugin for Pluxel",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/pluxel",
		"directory": "plugins/agent-tools"
	},
	"files": [
		"dist",
		"!**/*.map"
	],
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/hmr": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./package.json": "./package.json"
		},
		"access": "public"
	},
	"scripts": {
		"build": "pluxel build",
		"test": "vitest run --config vitest.config.ts",
		"typecheck": "tsc --noEmit --pretty false"
	},
	"devDependencies": {
		"@pluxel/cli": "workspace:*",
		"@pluxel/commands": "workspace:*",
		"@pluxel/rolldown": "workspace:*",
		"@pluxel/runtime": "workspace:*",
		"@pluxel/test": "workspace:*",
		"tsdown": "catalog:build",
		"typescript": "catalog:dev",
		"vitest": "catalog:test"
	},
	"peerDependencies": {
		"@pluxel/commands": "workspace:^",
		"@pluxel/runtime": "workspace:^"
	},
	"engines": {
		"node": ">=24"
	}
}
