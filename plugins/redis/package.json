{
	"name": "@pluxel/plugin-redis",
	"version": "0.0.0",
	"private": true,
	"description": "Official named Redis connection catalog, Lua helpers, cache backend, and rates backend",
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/pluxel",
		"directory": "plugins/redis"
	},
	"files": [
		"dist",
		"!**/*.map"
	],
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/hmr": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"build": "vp run compile",
		"test": "vp run check-tests",
		"typecheck": "vp run check-types"
	},
	"dependencies": {
		"redis": "catalog:backend",
		"valibot": "catalog:validation",
		"valibot-form": "workspace:^"
	},
	"devDependencies": {
		"@pluxel/cli": "workspace:*",
		"@pluxel/core": "workspace:*",
		"@pluxel/plugin-cache": "workspace:*",
		"@pluxel/plugin-rates": "workspace:*",
		"@pluxel/rolldown": "workspace:*",
		"@pluxel/services": "workspace:*",
		"@pluxel/test": "workspace:*",
		"@pluxel/workbench": "workspace:*",
		"typescript": "catalog:dev",
		"vite-plus": "catalog:build",
		"vitest": "catalog:test"
	},
	"peerDependencies": {
		"@pluxel/core": "workspace:^",
		"@pluxel/plugin-cache": "workspace:^",
		"@pluxel/plugin-rates": "workspace:^",
		"@pluxel/workbench": "workspace:^"
	},
	"pluxel": {
		"artifactRoot": "dist",
		"nodeArtifacts": true,
		"workbenchArtifacts": true
	}
}
