{
	"private": true,
	"type": "module",
	"name": "monorepo",
	"repository": "https://github.com/jkomyno/pnpm-monorepo-example.git",
	"engines": {
		"pnpm": ">=9"
	},
	"scripts": {
		"test": "turbo run test",
		"test:affected": "turbo run test --filter=...[origin/main]",
		"test:watch": "vitest",
		"build": "turbo run build",
		"audit:logs": "node scripts/audit-logs.mjs",
		"update": "pnpm pncat migrate && pnpm up --latest && pnpm pncat revert",
		"dev": "pnpm --filter @pluxel/plugins-host dev",
		"deploy": "pnpm --filter @pluxel/plugins-host deploy",
		"frozen": "pnpm --filter @pluxel/plugins-host frozen"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.10",
		"@pluxel/cli": "workspace:*",
		"@pluxel/test": "workspace:*",
		"@repobuddy/biome": "^2.3.1",
		"@types/bun": "^1.3.11",
		"pncat": "^0.11.1",
		"tsdown": "^0.21.7",
		"turbo": "^2.9.3",
		"typescript": "^6.0.2",
		"unplugin-preprocessor-directives": "^1.2.0",
		"vitest": "^4.1.2"
	},
	"pre-commit": "lint-staged",
	"lint-staged": {
		"*.{js,ts,cjs,mjs,md,json,jsonc}": "biome check --write --no-errors-on-unmatched"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
	"dependencies": {
		"@mantine/core": "^9.0.0",
		"@mantine/hooks": "^9.0.0",
		"@mantine/notifications": "^9.0.0",
		"@pluxel/market": "^0.1.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4"
	},
	"pnpm": {
		"peerDependencyRules": {
			"allowedVersions": {
				"@mantine/core": "^8.3.1",
				"@mantine/dates": "^8.3.1",
				"@mantine/hooks": "^8.3.1",
				"@mantine/modals": "^8.3.1",
				"@mantine/notifications": "^8.3.1",
				"@tanstack/react-form": "^1.23.0",
				"@tabler/icons-react": "^3.35.0",
				"react": "^19.1.1",
				"react-dom": "^19.1.1"
			}
		},
		"overrides": {
			"vite": "beta"
		}
	}
}
