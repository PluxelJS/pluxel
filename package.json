{
	"private": true,
	"type": "module",
	"name": "monorepo",
	"repository": "https://github.com/jkomyno/pnpm-monorepo-example.git",
	"engines": {
		"pnpm": ">=9"
	},
	"scripts": {
		"test": "turbo run test",
		"build": "turbo run build",
		"dev:core": "pnpm --filter core dev",
		"dev:hmr": "pnpm --filter hmr dev"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.6",
		"@repobuddy/biome": "^2.1.0",
		"@types/bun": "^1.3.2",
		"tsdown": "^0.16.5",
		"turbo": "^2.6.1",
		"typescript": "^5.9.3"
	},
	"pre-commit": "lint-staged",
	"lint-staged": {
		"*.{js,ts,cjs,mjs,md,json,jsonc}": "biome ci --no-errors-on-unmatched"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"packageManager": "pnpm@10.21.0+sha512.da3337267e400fdd3d479a6c68079ac6db01d8ca4f67572083e722775a796788a7a9956613749e000fac20d424b594f7a791a5f4e2e13581c5ef947f26968a40",
	"dependencies": {
		"@mantine/core": "^8.3.8",
		"@mantine/hooks": "^8.3.8",
		"@mantine/notifications": "^8.3.8",
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	},
	"pnpm": {
		"peerDependencyRules": {
			"allowedVersions": {
				"@mantine/core": "^8.3.1",
				"@mantine/dates": "^8.3.1",
				"@mantine/hooks": "^8.3.1",
				"@mantine/modals": "^8.3.1",
				"@mantine/notifications": "^8.3.1",
				"@tanstack/react-form": "^1.23.0",
				"@tabler/icons-react": "^3.35.0",
				"react": "^19.1.1",
				"react-dom": "^19.1.1",
				"tsdown": "^0.16.4"
			}
		},
		"overrides": {
			"vite": "npm:rolldown-vite@7.2.2"
		}
	}
}
