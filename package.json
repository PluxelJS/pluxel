{
	"name": "monorepo",
	"private": true,
	"repository": "https://github.com/jkomyno/pnpm-monorepo-example.git",
	"workspaces": [
		"packages/*",
		"packages/plugins/*",
		"projects/*"
	],
	"type": "module",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"test": "turbo run test",
		"test:full": "turbo run test --force",
		"test:watch": "vitest",
		"build": "turbo run build --filter=!@pluxel/plugins-host",
		"build:full": "turbo run build --force --filter=!@pluxel/plugins-host",
		"bench:core:compare": "scripts/core-bench-compare.sh",
		"lint": "oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error packages scripts oxlint.config.ts vitest.config.ts pncat.config.ts",
		"lint:fix": "oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error packages scripts oxlint.config.ts vitest.config.ts pncat.config.ts --fix",
		"format": "oxfmt -c .oxfmtrc.json --ignore-path .gitignore --ignore-path .oxfmtignore --write .",
		"format:check": "oxfmt -c .oxfmtrc.json --ignore-path .gitignore --ignore-path .oxfmtignore --check .",
		"generate:gqlens": "node scripts/generate-gqlens.ts",
		"plugin-host:dynamic": "pnpm --filter @pluxel/plugins-host dynamic",
		"plugin-host:static": "pnpm --filter @pluxel/plugins-host static",
		"plugin-host:static:direct": "pnpm --filter @pluxel/plugins-host static:direct",
		"plugin-demo:authelia-oidc": "pnpm --filter @pluxel/plugins-authelia-oidc-demo static",
		"plugin-demo:static-commercial": "pnpm --filter @pluxel/plugins-static-commercial-demo dev",
		"project:external-api-gateway": "pnpm --filter @pluxel/project-external-api-gateway dev"
	},
	"dependencies": {
		"@mantine/core": "^9.4.1",
		"@mantine/hooks": "^9.4.1",
		"@mantine/notifications": "^9.4.1",
		"@pluxel/market": "^0.1.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7"
	},
	"devDependencies": {
		"@gqlens/codegen": "^0.2.0",
		"@pluxel/cli": "workspace:*",
		"@pluxel/rolldown": "workspace:*",
		"@pluxel/test": "workspace:*",
		"@types/bun": "^1.3.14",
		"oxfmt": "^0.57.0",
		"oxlint": "^1.72.0",
		"pncat": "^0.12.0",
		"tsdown": "^0.22.3",
		"turbo": "^2.10.3",
		"typescript": "^6.0.3",
		"unplugin-preprocessor-directives": "^1.2.0",
		"vitest": "^4.1.9"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,cjs,mjs,md,json,jsonc}": [
			"oxfmt -c .oxfmtrc.json --ignore-path .gitignore --ignore-path .oxfmtignore --write --no-error-on-unmatched-pattern",
			"oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error --quiet"
		]
	},
	"pre-commit": "lint-staged",
	"engines": {
		"node": ">=24",
		"pnpm": ">=9"
	},
	"packageManager": "pnpm@11.8.0"
}
