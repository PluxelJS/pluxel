{
	"name": "monorepo",
	"private": true,
	"repository": "https://github.com/jkomyno/pnpm-monorepo-example.git",
	"type": "module",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"test": "turbo run test",
		"test:affected": "turbo run test --filter=...[origin/main]",
		"test:watch": "vitest",
		"build": "turbo run build",
		"lint": "oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error packages scripts oxlint.config.ts vitest.config.ts pncat.config.ts",
		"lint:fix": "oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error packages scripts oxlint.config.ts vitest.config.ts pncat.config.ts --fix",
		"format": "oxfmt -c .oxfmtrc.json --ignore-path .gitignore --ignore-path .oxfmtignore --write .",
		"format:check": "oxfmt -c .oxfmtrc.json --ignore-path .gitignore --ignore-path .oxfmtignore --check .",
		"update": "pnpm pncat migrate && pnpm up --latest && pnpm pncat revert",
		"dev": "pnpm --filter @pluxel/plugins-host dev",
		"deploy": "pnpm --filter @pluxel/plugins-host deploy",
		"frozen": "pnpm --filter @pluxel/plugins-host frozen"
	},
	"dependencies": {
		"@mantine/core": "^9.0.1",
		"@mantine/hooks": "^9.0.1",
		"@mantine/notifications": "^9.0.1",
		"@pluxel/market": "^0.1.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4"
	},
	"devDependencies": {
		"@pluxel/cli": "workspace:*",
		"@pluxel/test": "workspace:*",
		"@pluxel/workspace": "workspace:*",
		"@types/bun": "^1.3.11",
		"oxfmt": "^0.44.0",
		"oxlint": "^1.59.0",
		"pncat": "^0.11.1",
		"tsdown": "^0.21.7",
		"turbo": "^2.9.5",
		"typescript": "^6.0.2",
		"unplugin-preprocessor-directives": "^1.2.0",
		"vitest": "^4.1.3"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,cjs,mjs,md,json,jsonc}": [
			"oxfmt -c .oxfmtrc.json --ignore-path .gitignore --ignore-path .oxfmtignore --write --no-error-on-unmatched-pattern",
			"oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error --quiet"
		]
	},
	"pre-commit": "lint-staged",
	"engines": {
		"pnpm": ">=9"
	},
	"packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
	"pnpm": {
		"peerDependencyRules": {
			"allowedVersions": {
				"@mantine/core": "^9.0.0",
				"@mantine/dates": "^9.0.0",
				"@mantine/hooks": "^9.0.0",
				"@mantine/modals": "^9.0.0",
				"@mantine/notifications": "^9.0.0",
				"@tanstack/react-form": "^1.23.0",
				"@tabler/icons-react": "^3.35.0",
				"react": "^19.1.1",
				"react-dom": "^19.1.1"
			}
		},
		"overrides": {
			"vite": "beta"
		}
	}
}
