{
	"name": "pluxel",
	"private": true,
	"description": "A TypeScript plugin runtime with dependency graphs, lifecycle management, static delivery, and dynamic development workflows.",
	"keywords": [
		"microfrontend",
		"module-federation",
		"plugin-runtime",
		"plugin-system",
		"typescript"
	],
	"homepage": "https://github.com/PluxelJS/pluxel#readme",
	"bugs": {
		"url": "https://github.com/PluxelJS/pluxel/issues"
	},
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/pluxel"
	},
	"type": "module",
	"scripts": {
		"dev": "node packages/cli/bin/pluxel.mjs dev",
		"docs": "node packages/cli/bin/pluxel.mjs dev --profile docs",
		"build": "vp run workspace:build",
		"test": "vp run workspace:test",
		"typecheck": "vp run workspace:typecheck",
		"check": "vp check",
		"fix": "vp check --fix",
		"verify": "vp run workspace:verify",
		"hooks:install": "hk install --mise",
		"dev:status": "node packages/cli/bin/pluxel.mjs dev status",
		"dev:logs": "pitchfork logs plugin-host --follow",
		"dev:stop": "pitchfork stop plugin-host",
		"pluxel": "node packages/cli/bin/pluxel.mjs"
	},
	"devDependencies": {
		"@fumapress/tegami": "catalog:dev",
		"@types/node": "catalog:types",
		"tegami": "1.5.0",
		"typescript": "catalog:dev",
		"unplugin-preprocessor-directives": "catalog:build",
		"vite": "catalog:build",
		"vite-plus": "catalog:build",
		"vitest": "catalog:test",
		"yaml": "catalog:dev"
	},
	"engines": {
		"node": ">=24",
		"pnpm": ">=11 <12"
	},
	"packageManager": "pnpm@11.28.6",
	"pluxel": {
		"dev": {
			"default": "plugin-host",
			"plugin-host": {
				"root": "projects/plugin-host",
				"pitchfork": "plugin-host"
			},
			"docs": {
				"root": "projects/docs",
				"pitchfork": "docs",
				"console": false
			}
		}
	}
}
