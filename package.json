{
	"private": true,
	"type": "module",
	"name": "monorepo",
	"repository": "https://github.com/jkomyno/pnpm-monorepo-example.git",
	"engines": {
		"pnpm": ">=9"
	},
	"scripts": {
		"test": "turbo run test",
		"test:affected": "turbo run test --filter=...[origin/main]",
		"test:watch": "vitest",
		"build": "turbo run build",
		"build:plugin": "pnpm run build:plugins",
		"build:runtime": "pnpm --filter @pluxel/runtime build && pnpm --filter @pluxel/hmr build",
		"build:plugins": "pnpm --filter @pluxel/snapshot build && pnpm --filter pluxel-plugin-market-ui build",
		"audit:logs": "node scripts/audit-logs.mjs",
		"update": "pnpm pncat migrate && pnpm up --latest && pnpm pncat revert",
		"dev:core": "pnpm --filter @pluxel/core dev",
		"dev:host": "pnpm --filter @pluxel/plugins-host dev",
		"dev": "pnpm --filter @pluxel/plugins-host dev",
		"dev:hmr": "pnpm --filter @pluxel/plugins-host dev",
		"dev:smoke": "pnpm --filter @pluxel/plugins-host dev:smoke",
		"dev:hmr:smoke": "pnpm --filter @pluxel/plugins-host dev:smoke",
		"deploy:managed": "pnpm --filter @pluxel/plugins-host deploy:managed",
		"deploy:managed:smoke": "pnpm --filter @pluxel/plugins-host deploy:managed:smoke",
		"deploy:frozen": "pnpm --filter @pluxel/plugins-host deploy:frozen",
		"deploy:frozen:smoke": "pnpm --filter @pluxel/plugins-host deploy:frozen:smoke"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.8",
		"@pluxel/cli": "workspace:*",
		"@pluxel/test": "workspace:*",
		"@repobuddy/biome": "^2.3.1",
		"@types/bun": "^1.3.11",
		"pncat": "^0.11.0",
		"tsdown": "^0.21.4",
		"turbo": "^2.8.20",
		"typescript": "^6.0.2",
		"unplugin-preprocessor-directives": "^1.2.0",
		"vitest": "^4.1.1"
	},
	"pre-commit": "lint-staged",
	"lint-staged": {
		"*.{js,ts,cjs,mjs,md,json,jsonc}": "biome check --write --no-errors-on-unmatched"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
	"dependencies": {
		"@mantine/core": "^8.3.18",
		"@mantine/hooks": "^8.3.18",
		"@mantine/notifications": "^8.3.18",
		"@pluxel/market": "^0.1.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4"
	},
	"pnpm": {
		"peerDependencyRules": {
			"allowedVersions": {
				"@mantine/core": "^8.3.1",
				"@mantine/dates": "^8.3.1",
				"@mantine/hooks": "^8.3.1",
				"@mantine/modals": "^8.3.1",
				"@mantine/notifications": "^8.3.1",
				"@tanstack/react-form": "^1.23.0",
				"@tabler/icons-react": "^3.35.0",
				"react": "^19.1.1",
				"react-dom": "^19.1.1"
			}
		},
		"overrides": {
			"vite": "beta"
		}
	}
}
