{
	"private": true,
	"type": "module",
	"name": "monorepo",
	"repository": "https://github.com/jkomyno/pnpm-monorepo-example.git",
	"engines": {
		"pnpm": ">=9"
	},
	"scripts": {
		"test": "turbo run test",
		"build": "turbo run build",
		"build:plugin": "turbo run build:plugin",
		"audit:logs": "node scripts/audit-logs.mjs",
		"update": "pnpm pncat migrate && pnpm up --latest && pnpm pncat revert",
		"dev:core": "pnpm --filter core dev",
		"dev:hmr": "pnpm --filter @pluxel/plugins-host hmr"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.12",
		"@pluxel/cli": "workspace:*",
		"@repobuddy/biome": "^2.3.1",
		"@types/bun": "^1.3.6",
		"pncat": "^0.8.0",
		"tsdown": "0.20.1",
		"turbo": "^2.7.6",
		"typescript": "^5.9.3",
		"unplugin-preprocessor-directives": "^1.2.0"
	},
	"pre-commit": "lint-staged",
	"lint-staged": {
		"*.{js,ts,cjs,mjs,md,json,jsonc}": "biome ci --no-errors-on-unmatched"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"packageManager": "pnpm@10.28.1+sha512.7d7dbbca9e99447b7c3bf7a73286afaaf6be99251eb9498baefa7d406892f67b879adb3a1d7e687fc4ccc1a388c7175fbaae567a26ab44d1067b54fcb0d6a316",
	"dependencies": {
		"@mantine/core": "^8.3.13",
		"@mantine/hooks": "^8.3.13",
		"@mantine/notifications": "^8.3.13",
		"@pluxel/market": "^0.1.0",
		"react": "^19.2.3",
		"react-dom": "^19.2.3"
	},
	"pnpm": {
		"peerDependencyRules": {
			"allowedVersions": {
				"@mantine/core": "^8.3.1",
				"@mantine/dates": "^8.3.1",
				"@mantine/hooks": "^8.3.1",
				"@mantine/modals": "^8.3.1",
				"@mantine/notifications": "^8.3.1",
				"@tanstack/react-form": "^1.23.0",
				"@tabler/icons-react": "^3.35.0",
				"react": "^19.1.1",
				"react-dom": "^19.1.1"
			}
		},
		"overrides": {
			"vite": "beta"
		}
	}
}
