		"@mantine/modals": "^8.3.1",
		"@mantine/notifications": "^8.3.1",
		"@tabler/icons-react": "^3.34.1",
		"react": "^19.1.1",
		"react-dom": "^19.1.1"
	},
	"pnpm": {
		"peerDependencyRules": {
			"allowedVersions": {
				"react": "^19.1.1",
				"react-dom": "^19.1.1",
				"@mantine/core": "^8.2.7",
				"@mantine/dates": "^8.2.7",
				"@mantine/hooks": "^8.2.7",
				"@mantine/modals": "^8.2.7",
				"@mantine/notifications": "^8.2.7"
			}
		}
	}
}
