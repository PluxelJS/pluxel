{
	"private": true,
	"type": "module",
	"name": "monorepo",
	"repository": "https://github.com/jkomyno/pnpm-monorepo-example.git",
	"engines": {
		"pnpm": ">=9"
	},
	"scripts": {
		"test": "turbo run test",
		"build": "turbo run build",
		"update": "pnpm pncat migrate && pnpm up --latest && pnpm pncat revert",
		"dev:core": "pnpm --filter core dev",
		"dev:hmr": "pnpm --filter hmr hmr"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.8",
		"@repobuddy/biome": "^2.1.0",
		"@types/bun": "^1.3.3",
		"pncat": "^0.7.7",
		"tsdown": "0.17.0",
		"turbo": "^2.6.3",
		"typescript": "^5.9.3",
		"unplugin-preprocessor-directives": "^1.2.0"
	},
	"pre-commit": "lint-staged",
	"lint-staged": {
		"*.{js,ts,cjs,mjs,md,json,jsonc}": "biome ci --no-errors-on-unmatched"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"packageManager": "pnpm@10.24.0+sha512.01ff8ae71b4419903b65c60fb2dc9d34cf8bb6e06d03bde112ef38f7a34d6904c424ba66bea5cdcf12890230bf39f9580473140ed9c946fef328b6e5238a345a",
	"dependencies": {
		"@mantine/core": "^8.3.9",
		"@mantine/hooks": "^8.3.9",
		"@mantine/notifications": "^8.3.9",
		"@pluxel/market": "^0.1.0",
		"react": "^19.2.1",
		"react-dom": "^19.2.1"
	},
	"pnpm": {
		"peerDependencyRules": {
			"allowedVersions": {
				"@mantine/core": "^8.3.1",
				"@mantine/dates": "^8.3.1",
				"@mantine/hooks": "^8.3.1",
				"@mantine/modals": "^8.3.1",
				"@mantine/notifications": "^8.3.1",
				"@tanstack/react-form": "^1.23.0",
				"@tabler/icons-react": "^3.35.0",
				"react": "^19.1.1",
				"react-dom": "^19.1.1",
				"tsdown": "0.16.4"
			}
		},
		"overrides": {
			"vite": "npm:rolldown-vite@7.2.2"
		}
	}
}
