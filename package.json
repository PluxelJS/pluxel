{
	"private": true,
	"type": "module",
	"name": "monorepo",
	"repository": "https://github.com/jkomyno/pnpm-monorepo-example.git",
	"engines": {
		"pnpm": ">=9"
	},
	"scripts": {
		"test": "turbo run test",
		"build": "turbo run build",
		"dev:core": "pnpm --filter core dev",
		"dev:hmr": "pnpm --filter hmr dev"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:lint",
		"@oxc-project/runtime": "catalog:dev",
		"@repobuddy/biome": "catalog:lint",
		"@types/bun": "catalog:types",
		"husky": "catalog:lint",
		"is-ci": "catalog:dev",
		"pncat": "catalog:cli",
		"tsdown": "catalog:build",
		"turbo": "catalog:monorepo",
		"typescript": "catalog:tsc"
	},
	"pre-commit": "lint-staged",
	"lint-staged": {
		"*.{js,ts,cjs,mjs,md,json,jsonc}": "biome ci --no-errors-on-unmatched"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"packageManager": "pnpm@10.20.0+sha512.cf9998222162dd85864d0a8102e7892e7ba4ceadebbf5a31f9c2fce48dfce317a9c53b9f6464d1ef9042cba2e02ae02a9f7c143a2b438cd93c91840f0192b9dd",
	"dependencies": {
		"@mantine/core": "catalog:frontend",
		"@mantine/dates": "catalog:frontend",
		"@mantine/hooks": "catalog:frontend",
		"@mantine/modals": "catalog:frontend",
		"@mantine/notifications": "catalog:frontend",
		"@tabler/icons-react": "catalog:icons",
		"@tanstack/react-form": "catalog:frontend",
		"react": "catalog:frontend",
		"react-dom": "catalog:frontend"
	},
	"pnpm": {
		"peerDependencyRules": {
			"allowedVersions": {
				"@mantine/core": "^8.3.1",
				"@mantine/dates": "^8.3.1",
				"@mantine/hooks": "^8.3.1",
				"@mantine/modals": "^8.3.1",
				"@mantine/notifications": "^8.3.1",
				"@tanstack/react-form": "^1.23.0",
				"@tabler/icons-react": "^3.35.0",
				"react": "^19.1.1",
				"react-dom": "^19.1.1",
				"tsdown": "0.14.2"
			}
		}
	}
}
