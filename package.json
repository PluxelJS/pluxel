{
	"name": "pluxel",
	"private": true,
	"description": "A TypeScript plugin runtime with dependency graphs, lifecycle management, static delivery, and dynamic development workflows.",
	"keywords": [
		"microfrontend",
		"module-federation",
		"plugin-runtime",
		"plugin-system",
		"typescript"
	],
	"homepage": "https://github.com/PluxelJS/pluxel#readme",
	"bugs": {
		"url": "https://github.com/PluxelJS/pluxel/issues"
	},
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/pluxel"
	},
	"type": "module",
	"scripts": {
		"dev": "pitchfork start plugin-host",
		"docs": "pitchfork start docs",
		"build": "vp run workspace:build",
		"test": "vp run workspace:test",
		"typecheck": "vp run workspace:typecheck",
		"check": "vp check",
		"fix": "vp check --fix",
		"verify": "vp run workspace:verify",
		"hooks:install": "hk install --mise",
		"dev:status": "pitchfork status plugin-host",
		"dev:logs": "pitchfork logs plugin-host --follow",
		"dev:stop": "pitchfork stop plugin-host"
	},
	"devDependencies": {
		"@fumapress/tegami": "catalog:dev",
		"tegami": "1.5.0",
		"typescript": "catalog:dev",
		"unplugin-preprocessor-directives": "catalog:build",
		"vite": "catalog:build",
		"vite-plus": "catalog:build",
		"vitest": "catalog:test",
		"yaml": "catalog:dev"
	},
	"engines": {
		"node": ">=24",
		"pnpm": ">=11 <12"
	},
	"packageManager": "pnpm@11.28.2"
}
