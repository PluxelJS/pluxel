{
	"private": true,
	"type": "module",
	"name": "monorepo",
	"repository": "https://github.com/jkomyno/pnpm-monorepo-example.git",
	"engines": {
		"pnpm": ">=9"
	},
	"scripts": {
		"test": "turbo run test",
		"test:vitest": "vitest run -c vitest.config.ts",
		"build": "pnpm --filter @pluxel/cli build && turbo run build --filter=!@pluxel/cli",
		"build:plugin": "pnpm --filter @pluxel/cli build && turbo run build:plugin --filter=!@pluxel/cli",
		"audit:logs": "node scripts/audit-logs.mjs",
		"update": "pnpm pncat migrate && pnpm up --latest && pnpm pncat revert",
		"dev:core": "pnpm --filter core dev",
		"dev:hmr": "pnpm --filter @pluxel/plugins-host hmr",
		"dev:hmr:smoke": "pnpm --filter @pluxel/plugins-host hmr:smoke"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.13",
		"@pluxel/cli": "workspace:*",
		"@pluxel/test": "workspace:*",
		"@repobuddy/biome": "^2.3.1",
		"@types/bun": "^1.3.8",
		"pncat": "^0.8.0",
		"tsdown": "^0.20.1",
		"turbo": "^2.8.1",
		"typescript": "^5.9.3",
		"vitest": "*",
		"unplugin-preprocessor-directives": "^1.2.0"
	},
	"pre-commit": "lint-staged",
	"lint-staged": {
		"*.{js,ts,cjs,mjs,md,json,jsonc}": "biome ci --no-errors-on-unmatched"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264",
	"dependencies": {
		"@mantine/core": "^8.3.13",
		"@mantine/hooks": "^8.3.13",
		"@mantine/notifications": "^8.3.13",
		"@pluxel/market": "^0.1.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4"
	},
	"pnpm": {
		"peerDependencyRules": {
			"allowedVersions": {
				"@mantine/core": "^8.3.1",
				"@mantine/dates": "^8.3.1",
				"@mantine/hooks": "^8.3.1",
				"@mantine/modals": "^8.3.1",
				"@mantine/notifications": "^8.3.1",
				"@tanstack/react-form": "^1.23.0",
				"@tabler/icons-react": "^3.35.0",
				"react": "^19.1.1",
				"react-dom": "^19.1.1"
			}
		},
		"overrides": {
			"vite": "beta"
		}
	}
}
