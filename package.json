{
	"name": "pluxel",
	"private": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/pluxel"
	},
	"workspaces": [
		"packages/*",
		"packages/plugins/*",
		"projects/*",
		"projects/*/packages/*"
	],
	"type": "module",
	"scripts": {
		"test": "turbo run test",
		"test:full": "turbo run test --force",
		"test:watch": "vitest",
		"build": "turbo run build",
		"build:full": "turbo run build --force",
		"bench:core:compare": "scripts/core-bench-compare.sh",
		"lint": "oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error packages scripts oxlint.config.ts vitest.config.ts pncat.config.ts",
		"lint:fix": "oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error packages scripts oxlint.config.ts vitest.config.ts pncat.config.ts --fix",
		"format": "oxfmt -c .oxfmtrc.json --ignore-path .gitignore --ignore-path .oxfmtignore --write .",
		"format:check": "oxfmt -c .oxfmtrc.json --ignore-path .gitignore --ignore-path .oxfmtignore --check .",
		"verify": "pnpm run release:check && pnpm exec turbo run build test",
		"changeset": "changeset",
		"release:check": "node scripts/check-release-invariants.mjs",
		"release:smoke": "pnpm --filter @pluxel/cli test:templates",
		"release:version": "changeset version",
		"release:publish": "pnpm run verify && pnpm run release:smoke && changeset publish",
		"build:gqlens": "pnpm --filter @gqlens/core build && pnpm --filter @gqlens/react build && pnpm --filter @gqlens/codegen build && pnpm --filter @gqlens/vite build",
		"generate:gqlens": "pnpm run build:gqlens && node scripts/generate-gqlens.ts",
		"plugin-host:dynamic": "pnpm --filter @pluxel/plugins-host dynamic",
		"plugin-host:static": "pnpm --filter @pluxel/plugins-host static",
		"plugin-demo:authelia-oidc": "pnpm --filter @pluxel/plugins-authelia-oidc-demo static",
		"project:external-api-gateway": "pnpm --filter @repo/project-external-api-gateway dev",
		"project:chatbots": "pnpm --filter @repo/project-chatbots dev"
	},
	"dependencies": {
		"@mantine/core": "^9.4.1",
		"@mantine/hooks": "^9.4.1",
		"@mantine/notifications": "^9.4.1",
		"@pluxel/market": "^0.1.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7"
	},
	"devDependencies": {
		"@changesets/cli": "^2.31.0",
		"@gqlens/vite": "workspace:*",
		"@pluxel/cli": "workspace:*",
		"@pluxel/rolldown": "workspace:*",
		"@pluxel/test": "workspace:*",
		"@tsdown/css": "0.22.5",
		"oxfmt": "^0.58.0",
		"oxlint": "^1.73.0",
		"pncat": "^0.12.0",
		"tsdown": "^0.22.5",
		"turbo": "^2.10.4",
		"typescript": "^6.0.3",
		"unplugin-preprocessor-directives": "^1.2.0",
		"vitest": "^4.1.10"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,cjs,mjs,md,json,jsonc}": [
			"oxfmt -c .oxfmtrc.json --ignore-path .gitignore --ignore-path .oxfmtignore --write --no-error-on-unmatched-pattern",
			"oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error --quiet"
		]
	},
	"pre-commit": "lint-staged",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": ">=11 <12",
			"onFail": "ignore"
		}
	},
	"engines": {
		"node": ">=24",
		"pnpm": ">=9"
	}
}
