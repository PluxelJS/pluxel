{
	"private": true,
	"type": "module",
	"name": "monorepo",
	"repository": "https://github.com/jkomyno/pnpm-monorepo-example.git",
	"engines": {
		"pnpm": ">=9"
	},
	"scripts": {
		"test": "turbo run test",
		"test:affected": "turbo run test --filter=...[origin/main]",
		"test:watch": "vitest",
		"build": "turbo run build",
		"build:plugin": "turbo run build:plugin",
		"audit:logs": "node scripts/audit-logs.mjs",
		"update": "pnpm pncat migrate && pnpm up --latest && pnpm pncat revert",
		"dev:core": "pnpm --filter core dev",
		"dev:hmr": "pnpm --filter @pluxel/plugins-host hmr",
		"dev:hmr:smoke": "pnpm --filter @pluxel/plugins-host hmr:smoke"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.4",
		"@pluxel/cli": "workspace:*",
		"@pluxel/test": "workspace:*",
		"@repobuddy/biome": "^2.3.1",
		"@types/bun": "^1.3.9",
		"pncat": "^0.10.2",
		"tsdown": "^0.20.3",
		"turbo": "^2.8.10",
		"typescript": "^5.9.3",
		"unplugin-preprocessor-directives": "^1.2.0",
		"vitest": "^4.0.18"
	},
	"pre-commit": "lint-staged",
	"lint-staged": {
		"*.{js,ts,cjs,mjs,md,json,jsonc}": "biome ci --no-errors-on-unmatched"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"packageManager": "pnpm@10.30.2+sha512.36cdc707e7b7940a988c9c1ecf88d084f8514b5c3f085f53a2e244c2921d3b2545bc20dd4ebe1fc245feec463bb298aecea7a63ed1f7680b877dc6379d8d0cb4",
	"dependencies": {
		"@mantine/core": "^8.3.15",
		"@mantine/hooks": "^8.3.15",
		"@mantine/notifications": "^8.3.15",
		"@pluxel/market": "^0.1.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4"
	},
	"pnpm": {
		"peerDependencyRules": {
			"allowedVersions": {
				"@mantine/core": "^8.3.1",
				"@mantine/dates": "^8.3.1",
				"@mantine/hooks": "^8.3.1",
				"@mantine/modals": "^8.3.1",
				"@mantine/notifications": "^8.3.1",
				"@tanstack/react-form": "^1.23.0",
				"@tabler/icons-react": "^3.35.0",
				"react": "^19.1.1",
				"react-dom": "^19.1.1"
			}
		},
		"overrides": {
			"vite": "beta"
		}
	}
}
