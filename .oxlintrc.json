{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"env": {
		"builtin": true
	},
	"plugins": ["typescript", "unicorn", "oxc", "import", "react", "vitest"],
	"categories": {
		"correctness": "error",
		"suspicious": "error",
		"perf": "error"
	},
	"ignorePatterns": [
		"**/dist/**",
		"packages/**/__fixtures__/**",
		"packages/**/tests/fixtures/**",
		"packages/**/__tests__/fixtures/**",
		"packages/components/src/app/router/routeTree.gen.ts",
		"packages/plugins/host/pluxel.hmr.discovered.jsonc"
	],
	"rules": {
		"eslint/no-await-in-loop": "off",
		"eslint/no-control-regex": "error",
		"eslint/no-unmodified-loop-condition": "off",
		"eslint/no-unused-expressions": "off",
		"eslint/no-unused-vars": "warn",
		"import/no-default-export": "off",
		"import/no-unassigned-import": "off",
		"jest/expect-expect": "off",
		"jest/no-conditional-expect": "off",
		"jest/no-standalone-expect": "off",
		"jest/require-to-throw-message": "off",
		"jest/valid-expect": "off",
		"jest/valid-title": "off",
		"react/exhaustive-deps": "off",
		"react/no-array-index-key": "off",
		"react/no-danger": "error",
		"react/no-danger-with-children": "error",
		"react/react-in-jsx-scope": "off",
		"react/rules-of-hooks": "off",
		"typescript/no-empty-interface": "off",
		"typescript/no-explicit-any": "off",
		"typescript/no-extraneous-class": "off",
		"typescript/no-non-null-assertion": "off",
		"unicorn/consistent-function-scoping": "off",
		"unicorn/no-array-sort": "off",
		"unicorn/no-immediate-mutation": "error",
		"unicorn/no-thenable": "error",
		"unicorn/prefer-add-event-listener": "off",
		"unicorn/prefer-string-replace-all": "error",
		"unicorn/prefer-type-error": "error",
		"unicorn/require-module-specifiers": "off",
		"vitest/require-mock-type-parameters": "off"
	},
	"overrides": [
		{
			"files": [
				"packages/build/src/**/*.{ts,tsx,mjs}",
				"packages/cli/src/**/*.{ts,tsx,mjs}",
				"packages/context/src/**/*.{ts,tsx,mjs}",
				"packages/core/src/**/*.{ts,tsx,mjs}",
				"packages/diod/src/**/*.{ts,tsx,mjs}",
				"packages/hmr/src/**/*.{ts,tsx,mjs}",
				"packages/runtime/src/**/*.{ts,tsx,mjs}",
				"packages/workspace/src/**/*.{ts,tsx,mjs}"
			],
			"rules": {
				"eslint/eqeqeq": "error"
			}
		},
		{
			"files": [
				"packages/build/src/**/*.{ts,tsx,mjs}",
				"packages/cli/src/commands/**/*.{ts,tsx,mjs}",
				"packages/cli/src/utils/**/*.{ts,tsx,mjs}",
				"packages/cli/src/workspace/**/*.{ts,tsx,mjs}",
				"packages/context/src/**/*.{ts,tsx,mjs}",
				"packages/core/src/**/*.{ts,tsx,mjs}",
				"packages/diod/src/**/*.{ts,tsx,mjs}",
				"packages/hmr/src/**/*.{ts,tsx,mjs}",
				"packages/runtime/src/api/**/*.{ts,tsx,mjs}",
				"packages/runtime/src/builtins/**/*.{ts,tsx,mjs}",
				"packages/runtime/src/logger/**/*.{ts,tsx,mjs}",
				"packages/runtime/src/server/**/*.{ts,tsx,mjs}",
				"packages/runtime/src/services/**/*.{ts,tsx,mjs}",
				"packages/workspace/src/**/*.{ts,tsx,mjs}"
			],
			"rules": {
				"eslint/require-await": "error"
			}
		},
		{
			"files": ["packages/**/src/**/*.test.{ts,tsx,mjs}"],
			"rules": {
				"eslint/require-await": "off"
			}
		},
		{
			"files": [
				"packages/hmr/src/dev/attach-runtime.ts",
				"packages/hmr/src/dev/hmr/HMRService.ts",
				"packages/hmr/src/plugin-build.ts",
				"packages/runtime/src/api/features/market/service.ts",
				"packages/runtime/src/api/http/rpc/PluginHandle.ts",
				"packages/runtime/src/api/http/rpc/RuntimeRpcApi.ts",
				"packages/runtime/src/server/static.ts",
				"packages/runtime/src/server/ui-public.ts",
				"packages/runtime/src/services/PluginDataService.ts",
				"packages/runtime/src/services/fs/FsService.ts",
				"packages/runtime/src/services/http/HttpService.ts",
				"packages/runtime/src/services/http/InternalGraphQLService.ts",
				"packages/runtime/src/services/http/sse.ts",
				"packages/runtime/src/services/plugin-interaction/ExtensionService.ts",
				"packages/runtime/src/services/runtime/package/installer.ts",
				"packages/runtime/src/services/runtime/package/PackageService.ts",
				"packages/runtime/src/services/runtime/package/removal-flow.ts",
				"packages/runtime/src/services/runtime/scan/ScanService.ts",
				"packages/runtime/src/services/vault/VaultService.ts"
			],
			"rules": {
				"eslint/require-await": "off"
			}
		},
		{
			"files": [
				"packages/components/src/**/*.{ts,tsx}",
				"packages/valibot-form/src/web/**/*.{ts,tsx}"
			],
			"rules": {
				"react/rules-of-hooks": "error"
			}
		}
	]
}
