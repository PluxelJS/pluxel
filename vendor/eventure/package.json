{
	"name": "eventure",
	"version": "0.5.0",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"sideEffects": false,
	"exports": {
		".": {
			"source": "./src/index.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"keywords": [
		"event",
		"hook",
		"emit"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/PluxelJS/Eventure.git"
	},
	"license": "Apache-2.0",
	"scripts": {
		"dev": "bun run --hot ./src/index.ts",
		"test": "vp run check-tests",
		"build": "vp run compile",
		"bench:onlyEmit": "bun ./tinybench/onlyEmit.ts",
		"bench:compare": "bun ./tinybench/onlyEmit.ts",
		"bench:api": "bun ./tinybench/apiRegression.ts",
		"prepublishOnly": "vp run compile",
		"lint": "vp lint",
		"format:check": "vp fmt --check .",
		"format": "vp fmt .",
		"typecheck": "vp run check-types"
	},
	"devDependencies": {
		"@types/node": "catalog:types",
		"typescript": "catalog:dev",
		"vitest": "catalog:test",
		"vite-plus": "catalog:build"
	},
	"publishConfig": {
		"exports": {
			".": {
				"import": "./dist/index.mjs",
				"require": "./dist/index.cjs"
			},
			"./package.json": "./package.json"
		}
	}
}
