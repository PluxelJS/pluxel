{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/PluxelJS/pluxel/.cla/signatures.schema.json",
	"type": "object",
	"additionalProperties": false,
	"required": ["version", "signatures"],
	"properties": {
		"version": {
			"const": 1
		},
		"signatures": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["host", "username", "acceptedAt", "claSha256"],
				"properties": {
					"host": {
						"type": "string",
						"minLength": 1,
						"examples": ["github.com", "codeberg.org"]
					},
					"username": {
						"type": "string",
						"minLength": 1
					},
					"acceptedAt": {
						"type": "string",
						"pattern": "^\\d{4}-\\d{2}-\\d{2}$"
					},
					"claSha256": {
						"type": "string",
						"pattern": "^[a-fA-F0-9]{64}$"
					}
				}
			}
		}
	}
}
